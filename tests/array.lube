// Arrays (the plugin array): making them, their operators, indexing, reductions, linear algebra, random
// numbers (numpy's for the same seed), files. Results through libm (exp, log...) print rounded: the same everywhere.
import array as np
import fs.*

fn tries(f) { try { print(f()) } catch e { print("error:", e) } }
fn r6(x) => np.round(x, 6)

// ---------- making them ----------
let a = np.array([[1, 2, 3], [4, 5, 6]])
print(a, a.shape, a.ndim, a.size, a.dtype, a.itemsize, a.nbytes, type(a), a is np.Array)
print(np.array(5), np.array(true), np.array([true, false]), np.array([]), np.array([[]]).shape)
print(np.array([1, 2], "int64").dtype, np.array([1.5, -2.5], "int32"), np.array([300, -1], "uint8"), np.array([0, 2], "bool"))
print(np.array(0..4), np.array([0..3, 3..6]), np.array(range(0, 10, 4)), np.array(1..=3), np.array(Bytes(3)).dtype, np.array(Bytes(2), "float32"))
print(np.array(a) == a, np.array([a, a]).shape, np.array([np.array([1, 2]), [3, 4]]), np.Array([1, 2], "float32").dtype)
let b = np.asarray(a)
print(b == a, np.asarray([1]), np.asarray(a, "float32").dtype, np.array(a, "int64").dtype)
print(np.zeros(3), np.zeros(2, 2), np.zeros([2, 1], "int32"), np.ones(2), np.ones([2], "bool"), np.empty(0), np.zeros())
print(np.full(2, 7), np.full([2, 2], 0), np.full(2, true), np.full(3, 1, "int64").dtype, np.full([1], 2.5, "float32"))
print(np.zeros_like(a), np.ones_like(a, "bool"), np.empty_like([1, 2]), np.full_like(a, 9), np.full_like([1], false, "float64"))
print(np.arange(4), np.arange(1, 3), np.arange(0, 1, 0.25), np.arange(5, 0, -2), np.arange(3, "int32").dtype, np.arange(2, 1))
print(np.linspace(0, 1, 5), np.linspace(0, 1, 4, {endpoint: false}), np.linspace(2, 3, 1), np.linspace(0, 1).shape, np.logspace(0, 2, 3), np.logspace(0, 3, 4, {base: 2}))
print(np.eye(2), np.eye(2, 3), np.eye(3, 3, 1), np.eye(2, "int64").dtype, np.identity(2), np.identity(2, "float32").dtype)
print(np.diag([1, 2]), np.diag([1, 2], 1), np.diag([1, 2], -1), np.diag(a), np.diag(a, 1), np.diag(a, -1), np.diag(a, 5))
let raw = np.array([1, 2], "int32").to_bytes()
print(raw, np.from_bytes(raw, "int32"), np.from_bytes(Bytes(4)), np.from_bytes(np.array([1, 2, 3, 4], "float32").to_bytes(), "float32", [2, 2]), np.from_bytes(Bytes(2), "bool"))

// ---------- printing ----------
print(np.arange(8).reshape(2, 2, 2))
print(np.arange(2000))
print(np.zeros(1001, 2).shape, np.ones(3, 400)[0].size)
print(np.arange(12).reshape(1, 12))
print(np.array([0.1, 1e-7, 1e21], "float32"), np.array([np.inf, -np.nan], "float32"), np.array([1, -1], "int64"))
print(np.zeros(2, 2, 302)[0, 0].shape, np.ones(1, 1, 1001))
print(np.arange(3003).reshape(1001, 3))
print(np.arange(8, "float32")[range(0, 8, 2)].copy(), np.array([true, false, true, false])[range(0, 4, 2)].copy(), np.array([2, 0], "int64").astype("bool"), np.array([3], "int32").astype("uint8"))

// ---------- operators ----------
print(a + 1, 1 + a, a - a, 10 - a, a * 2, a / 2, 1 / np.array([0, 2]), a % 4, -7 % np.array([3, -3]), np.array([-7.5, 7.5]) % 2)
print(a ** 2, 2 ** np.array([0, 3]), -a, a == 2, a != 2, a < 3, a <= 3, a > 3, a >= 3, 2 < a)
let i64 = np.array([1, 5], "int64")
print(i64 - 2, i64 < 3, i64 <= 1, i64 > 3, i64 >= 5, i64 == 5, i64 != 5, np.abs(np.array([-3], "int32")), np.abs(np.array([-3], "int32")).dtype, np.negative(np.array([2], "uint8")))
print(np.array([1, 2], "int64") + np.array([3, 4], "int64"), np.array([5, -5], "int64") % 3, np.array([2, 3], "int64") ** 3, -np.array([1], "int64"))
print(np.array([1, 2], "int32") * 2, (np.array([1, 2], "int32") * 2).dtype, np.array([200], "uint8") + 100, np.array([true]) + np.array([true]))
print((np.array([1], "float32") + 0.5).dtype, (np.array([1], "int64") + 0.5).dtype, (np.array([1], "int64") + 2).dtype, (np.array([true]) + 1).dtype)
print((np.array([1], "float32") + np.array([1], "int32")).dtype, (np.array([1], "uint8") + np.array([1], "int32")).dtype, (np.array([1], "uint8") + np.array([1], "float32")).dtype, (np.array([1], "int64") / 2).dtype)
print(np.array([1], "float32") / 3, np.array([7], "int64") / 2, np.array([true]) == true, np.array([1, 2]) + [10, 20], (0..3) + np.array(1))
print(a + np.array([10, 20, 30]), a + np.array([[100], [200]]), np.zeros(2, 1) + np.zeros(3))
let ma = np.array([[1, 2], [3, 4]])
print(ma @ ma, ma @ [1, 1], [1, 1] @ ma, np.array([1, 2]) @ np.array([3, 4]), np.ones(2, 2, 3) @ np.ones(3, 2), np.ones(3) @ np.ones(2, 3, 4))
print(np.array([[1, 2]], "int64") @ np.array([[3], [4]], "int64"), (np.array([[1]], "int64") @ np.array([[2]], "int64")).dtype, np.array([[true]]) @ np.array([[true]]))
print(np.array([1, 2], "float32") @ np.array([1, 2], "float32"), (ma.T @ ma), np.ones(2, 3).T @ np.ones(2, 1), np.ones(4, 1) @ np.ones(1, 3))
print(np.zeros(0, 3) @ np.zeros(3, 2), np.zeros(2, 0) @ np.zeros(0, 2))

// ---------- elementwise functions (taking Numbers too) ----------
print(np.negative([1, -2]), np.abs([-1.5, 2]), np.absolute(-3), np.abs(np.array([-2, 3], "int64")), np.abs(np.array([true])), np.sqrt([4, 9]), np.sqrt(16))
print(r6(np.exp([0, 1])), r6(np.log([1, np.e])), r6(np.log(8, 2)), r6(np.log([100, 1000], 10)), np.log2([8]), np.log10([1000]), r6(np.log1p([1])), r6(np.expm1([1])))
print(r6(np.sin([0, 1])), r6(np.cos([0, 1])), r6(np.tan([1])), r6(np.arcsin([1])), r6(np.arccos([0])), r6(np.arctan([1])), r6(np.sinh([1])), r6(np.cosh([1])))
print(r6(np.tanh([1])), r6(np.arcsinh([1])), r6(np.arccosh([2])), r6(np.arctanh([0.5])), np.floor([-1.5, 1.5]), np.ceil([-1.5, 1.5]), np.trunc([-1.5, 1.5]), np.rint([0.5, 1.5, 2.5]))
print(np.sign([-2, 0, 3]), np.sign(np.array([-5, 5], "int64")), np.square([3]), np.square(np.array([4], "int64")), np.reciprocal([4]), r6(np.cbrt([27])), np.exp2([3]), r6(np.erf([0.5])))
print(np.isnan([1, np.nan]), np.isinf([np.inf, 1]), np.isfinite([np.inf, 1]), np.isnan(np.array([1], "int64")), np.isfinite(np.array([1], "int64")), np.logical_not([true, false]))
print(np.floor(np.array([1, 2], "int64")), np.floor(np.array([1], "int64")).dtype, np.floor(2.5), np.sqrt(np.array([4], "int32")).dtype)
let f32 = np.array([4, 0.25, -1], "float32")
print(np.negative(f32), np.abs(f32), np.sqrt(f32), r6(np.exp(f32)), r6(np.log(np.abs(f32))), r6(np.log2(np.abs(f32))), r6(np.log10(np.abs(f32))), r6(np.log1p(np.abs(f32))))
print(r6(np.expm1(f32)), r6(np.sin(f32)), r6(np.cos(f32)), r6(np.tan(f32)), r6(np.arcsin(f32 / 4)), r6(np.arccos(f32 / 4)), r6(np.arctan(f32)), r6(np.sinh(f32)))
print(r6(np.cosh(f32)), r6(np.tanh(f32)), r6(np.arcsinh(f32)), r6(np.arccosh(np.abs(f32) + 1)), r6(np.arctanh(f32 / 8)), np.floor(f32), np.ceil(f32), np.trunc(f32))
print(np.rint(f32), np.sign(f32), np.square(f32), np.reciprocal(f32), r6(np.cbrt(f32)), r6(np.exp2(f32)), r6(np.erf(f32)), np.isnan(f32), np.isinf(f32), np.isfinite(f32))
print(np.round([0.5, 1.5, 2.675], 0), np.round([1.234, 5.678], 1), np.round(2.5), np.round(np.array([1.25]), 1), a.round(), np.round(np.array([12345], "int64"), -2))
print(np.clip(a, 2, 5), a.clip(0, 1), np.clip([1, 5], np.array([2, 2]), 4), np.clip(9, 0, 3))
print(np.add(1, 2), np.subtract([5], 2), np.multiply(2, [3]), np.divide(1, 4), np.mod(-1, 3), np.remainder([5], [3]), np.power(2, 10), np.pow([3], 2))
print(np.maximum([1, 5], [4, 2]), np.minimum([1, 5], [4, 2]), np.maximum([np.nan], [1]), np.minimum([1], [np.nan]), np.maximum(np.array([3], "int64"), np.array([5], "int64")), np.minimum(np.array([3], "int64"), 1))
print(r6(np.arctan2([1], [1])), np.atan2(0, -1) > 3, np.hypot([3], [4]), np.fmod([-7], [3]), np.floor_divide([-7, 7], [2, 2]), np.floor_divide(np.array([-7, 7, 5, 9], "int64"), np.array([2, 2, 0, -1], "int64")), np.copysign([1], [-0.0]))
print(np.mod(np.array([5], "int64"), 0), np.mod(np.array([7], "int64"), -1), np.mod(np.array([5.0]), 0) , np.array([4, -4]) % 2 == 0)
print(np.less([1], [2]), np.less_equal([2], [2]), np.greater([1], [2]), np.greater_equal([2], [2]), np.equal(1, 1), np.not_equal([1], [2]))
print(np.logical_and([true, true], [true, false]), np.logical_or([false, false], [true, false]), np.logical_xor([true, true], [true, false]), np.logical_and(1, 0))
let f2 = np.array([1, -2], "float32")
print(f2 + f2, f2 - f2, f2 * f2, f2 / f2, f2 % np.array([3, 3], "float32"), f2 ** 2, np.maximum(f2, 0), np.minimum(f2, 0), r6(np.arctan2(f2, f2)), np.hypot(f2, f2))
print(np.fmod(f2, np.array([3, 3], "float32")), np.floor_divide(f2, np.array([3, 3], "float32")), np.copysign(f2, np.array([-1, 1], "float32")), f2 < 0, f2 <= 1, f2 > 0, f2 >= 1, f2 == 1, f2 != 1)
print(np.where([true, false], [1, 2], [3, 4]), np.where(a > 2, a, 0), np.where([1, 0, 2]), np.where(np.array([true]), 1.5, np.array([1], "int64")), np.nonzero([[1, 0], [0, 1]]), np.array([0, 3]).nonzero(), np.nonzero(np.array(5)))
print(np.isclose([1, 2], [1.000001, 3]), np.isclose(1, 1.1, {atol: 0.2}), np.isclose([np.nan], [np.nan]), np.isclose([np.nan], [np.nan], {equal_nan: true}), np.allclose([1, 2], [1, 2.0000001]), np.allclose([1], [2]), np.allclose(1, 1))
print(np.array_equal(a, a), np.array_equal(a, a.T), np.array_equal([1, 2], [1, 3]), np.array_equal([1], [1]))

// ---------- shapes ----------
let r = np.arange(6)
print(r.reshape(2, 3), r.reshape([3, -1]), np.reshape(r, 3, 2), np.reshape(r, [-1]), a.T.reshape(6), np.ravel(a.T), r.reshape(1, 2, 3).shape, a.flatten(), a.T.ravel())
print(np.transpose(a), np.transpose(np.zeros(1, 2, 3), [2, 0, 1]).shape, np.zeros(1, 2, 3).transpose(1, 2, 0).shape, np.swapaxes(np.zeros(1, 2, 3), 0, 2).shape, a.swapaxes(0, -1).shape)
print(np.expand_dims(r, 0).shape, np.expand_dims(r, -1).shape, np.squeeze(np.zeros(1, 3, 1)).shape, np.zeros(1, 3, 1).squeeze(0).shape, np.squeeze(np.zeros(1, 1)).shape)
print(np.broadcast_to([1, 2], [2, 2]), np.broadcast_to(5, 3), np.flip(r), np.flip(a, 0), np.flip(a, 1), np.flip(np.zeros(0)))
print(np.concatenate([a, a]), np.concatenate([a, a], 1), np.concatenate([[1], np.array([2], "int64")]).dtype, np.stack([r, r]), np.stack([r, r], 1).shape, np.stack([r, r], -1).shape)
print(np.vstack([r, r]).shape, np.vstack([a, a]).shape, np.hstack([r, r]).shape, np.hstack([a, a]).shape, np.concatenate([np.zeros(0), [1]]))
print(np.tile([1, 2], 2), np.tile([1, 2], [2, 1]), np.tile(a, [1, 2]).shape, np.tile(np.zeros(0), 3), np.repeat([1, 2], 2), np.repeat(a, 2, 0), np.repeat(a, 2, 1).shape, np.repeat([1], 0))
print(np.roll(r, 2), np.roll(r, -1), np.roll(a, 1, 1), np.roll(a, 1, 0), np.roll(np.zeros(0), 1))

// ---------- indexing: views, copies, changes ----------
let m = np.arange(12).reshape(3, 4)
print(m[0], m[-1], m[1, 2], m[1][2], m[.., 0], m[0, 1..3], m[..2, ..2], m[1.., -1], m[range(0, 3, 2)], m[0, range(3, -1, -2)], m[0, range(10, -10, -1)])
print(m[..=1, 0], m[-2.., ..], m[0, 5..], m[0, -100..2], m[0, ..-1], m[0, 0..0], m[..][1, ..2])
print(m[[0, 2]], m[[0, 2], [1, 3]], m[[0, 2], 1], m[1, [0, 3]], m[.., [0, -1]], m[[[0, 1], [1, 2]]].shape, m[np.array([2, 0])], m[np.array([[0], [2]]), [1, 3]])
print(m[m > 8], m[[true, false, true]], m[.., [true, false, false, true]], m[np.array([true, false, true]), 0], m[m > 100].shape, np.array([1, 2])[np.array([true, true])])
print(m[0, ..][[1, 2]], m[[0, 1]][.., 1..3], np.zeros(2, 3, 4)[[0, 1], .., [1, 2]].shape, np.zeros(2, 3, 4)[.., [0, 1], [1, 2]].shape, np.zeros(2, 3, 4)[0, .., [1, 2]].shape)
var v = np.zeros(3, 3)
v[0, 0] = 1
v[1] = 2
v[.., 2] = [7, 8, 9]
v[2, ..2] = np.array([5, 6])
print(v)
v[v > 6] = 0
v[[0, 2], [1, 1]] = -1
v[[1]] = 3
v[.., [0]] = np.array([[4], [4], [4]])
print(v)
v[[0, 1], ..2] = np.array([[1, 2], [3, 4]])
v[np.array([true, false, true])] = 9
v[[0, 2], 1] += 100
v[0, 0] *= 2
print(v)
let kept = v
v[1, 1] = -50
print(kept[1, 1], v[1, 1])  // (copy-on-write: kept keeps what it had)
var w = np.arange(4)
let part = w[1..3]
w[1] = 99
print(part, w)  // (a view of w's old memory)
var bc = np.broadcast_to(np.array([1, 2]), [2, 2])
bc[0, 0] = 5
print(bc)  // (a broadcast view: written as a copy of its own)
var inp = np.arange(3)
inp += 1
inp -= np.array([1, 1, 1])
inp *= 2
inp /= 2
inp %= 2
print(inp)
var shared = np.arange(3)
let other = shared
shared += 10
print(shared, other)
var widen = np.array([1, 2], "int64")
widen += 0.5  // (the result is float64: a new Array)
print(widen, widen.dtype)
var grow = np.zeros(2)
grow += np.zeros(3, 2)
print(grow.shape)
var self_add = np.arange(3)
self_add += self_add
print(self_add)
class Model {
    var w = np.zeros(2)
}
var model = Model()
model.w[1] = 4
model.w -= 1
print(model.w)
var total = 0
for row in m { total += row.sum() }
var items = []
for i, x in np.array([5, 6]) { push(&items, "{i}:{x}") }
print(total, items, len(m), len(np.zeros(0)))

// ---------- reductions ----------
print(a.sum(), a.sum(0), a.sum(1), a.sum(-1), np.sum(a, 0, {keepdims: true}), a.sum({keepdims: true}), np.sum([1, 2]), np.sum(np.zeros(0)))
print(a.prod(), a.prod(1), a.mean(), a.mean(0), np.mean(np.zeros(0, 2), 0), a.min(), a.max(1), np.amin(a, 0), np.amax(a), a.argmin(), a.argmax(0), np.argmax([[1, 9], [8, 2]], 1))
print(a.any(), np.any([0, 0]), a.all(), np.all([1, 0]), np.all(np.zeros(0)), a.var(), a.std(), np.var(a, 0), np.std(a, {ddof: 1}), np.var([1], {ddof: 1}), np.isnan(np.var([1], {ddof: 1})))
print(np.array([1, 2], "int64").sum(), np.array([true, true, false]).sum(), np.array([2, 3], "int64").prod(), np.array([1, 2], "float32").sum(), np.array([1.5], "float32").mean())
print(np.max([1, np.nan, 3]), np.argmax([1, np.nan, 3]), np.min(np.array([3, 1], "int64")), np.argmin(np.array([3, 1, 0], "int32")), np.max(np.array([true, false])))
print(np.min(3, 1, 2), np.max(1, 5), np.min([3, 1]), np.max(a, 0), np.ptp(a), np.ptp(a, 1))
print(np.cumsum(a), np.cumsum(a, 0), a.cumsum(1), np.cumprod([1, 2, 3]), a.cumprod(0), np.cumsum(np.array([1, 2], "int64")), np.cumprod(np.array([2, 3], "int64")), np.cumsum([true, true]))
print(np.count_nonzero([1, 0, 2]), np.count_nonzero(a > 2, 0), np.average([1, 2, 3]), np.average([1, 2], {weights: [3, 1]}), np.average(a, 1, {weights: [1, 0, 1]}), np.average(a, 0, {weights: [1, 3]}), np.average(a, {weights: a}))
print(np.median([3, 1, 2]), np.median([4, 1, 2, 3]), np.median(a, 0), np.median(a, 1), np.percentile([1, 2, 3, 4], 25), np.percentile(a, [0, 50, 100], 1), np.quantile([1, 2, 3], 0.5), np.median([1, np.nan]))
let big = np.arange(300000)
print(big.sum(), (big * 2).sum(), np.ones(300000, "float32").sum(), big.reshape(3000, 100).sum(0)[0], big.reshape(100, 3000).sum(1)[99], big.max())

// ---------- sorting and searching ----------
print(np.sort([3, 1, 2]), np.sort(a, 0), np.sort(np.array([[3, 1], [2, 0]]), 1), a.sort(), np.sort([np.nan, 1, -np.inf]), np.sort(np.array([3, -1], "int64")), np.sort(np.array([2, 1], "float32")), np.sort(np.array([true, false])))
print(np.argsort([3, 1, 2]), np.argsort([1, 1, 0, 1]), a.argsort(0), np.argsort(np.array([[2, 1], [0, 3]]), 1))
print(np.unique([3, 1, 3, 2, 1]), np.unique([2, 1, 2], {return_counts: true}), np.unique([2, 1, 2], {return_index: true, return_inverse: true}), np.unique(np.array([5, 5], "int64")), np.unique([np.nan, np.nan, 1]), np.unique(np.zeros(0)))
print(np.searchsorted([1, 2, 3], 2), np.searchsorted([1, 2, 3], 2, {side: "right"}), np.searchsorted([1, 2, 3], [0, 4]), np.bincount([0, 1, 1, 3]), np.bincount([1], {minlength: 4}), np.bincount([0, 1, 1], {weights: [0.5, 1, 2]}))
let shuffled = np.permutation(1000)
print(np.array_equal(np.sort(shuffled), np.arange(1000)), np.array_equal(np.argsort(np.argsort(shuffled)), shuffled), np.sort(np.rand(200, 2000), 1).shape)

// ---------- linear algebra ----------
let s = np.array([[4, 1], [2, 3]])
print(np.matmul(s, s), np.dot(s, s), s.dot([1, 0]), np.dot(2, s), np.dot(np.array(2), 3), np.inner([1, 2], [3, 4]), np.inner(s, s), np.outer([1, 2], [1, 2, 3]), np.trace(s))
print(np.det(s), np.det(np.zeros(2, 2)), np.slogdet(s), np.slogdet(np.array([[0, 1], [1, 0]])), np.slogdet(np.zeros(1, 1)), np.solve(s, [1, 2]), np.solve(s, np.eye(2)) == np.inv(s), np.inv(np.array([[2]], "float32")).dtype)
print(r6(np.inv(s)), np.cholesky(np.array([[4, 2], [2, 3]])), np.cholesky(np.array([[4]], "float32")).dtype)
let q = np.qr(np.array([[1, 2], [3, 4], [5, 6]]))
print(r6(q[0]), r6(q[1]), np.allclose(q[0] @ q[1], [[1, 2], [3, 4], [5, 6]]), np.qr(s, {mode: "complete"})[0].shape, np.qr(np.ones(2, 3))[1].shape, np.qr(np.zeros(2, 2))[1])
let tall = np.array([[3, 1], [1, 3], [1, 1]])
let sv = np.svd(tall)
print(r6(sv[1]), sv[0].shape, sv[2].shape, np.allclose(sv[0][.., ..2] * sv[1] @ sv[2], tall), np.allclose(sv[0].T @ sv[0], np.eye(3)))
let sv2 = np.svd(tall.T, {full_matrices: false})
print(sv2[0].shape, r6(sv2[1]), sv2[2].shape, np.allclose(sv2[0] * sv2[1] @ sv2[2], tall.T), np.svd(tall.T)[2].shape, r6(np.svd(tall, {compute_uv: false})), r6(np.svd(np.zeros(2, 2))[1]))
print(np.allclose(np.svd(tall.T)[2] @ np.svd(tall.T)[2].T, np.eye(3)), r6(np.svd(np.array([[1, 1], [1, 1]], "float32"))[1]), np.svd(np.array([[1]], "float32"))[0].dtype)
