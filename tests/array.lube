make_dir("build/arr")
for x in [np.arange(6).reshape(2, 3), np.array([1.5], "float32"), np.array([1, -2], "int64"), np.array([7], "int32"), np.array([255], "uint8"), np.array([true, false]), np.array(3), np.zeros(0, 2)] {
    np.save("build/arr/x.npy", x)
