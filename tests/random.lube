// random: Python's random module, number for number (every value here is Python's for the same seed)
import random

fn tries(f) { try { f() } catch e { print("error:", e) } }
fn r(x) => round(x, 10)  // (what goes through the C library's log, exp, sin...: the same to 10 places everywhere)
fn rs(xs) => xs.map(fn(x) => round(x, 10))

// seeds: a whole Number as Python's int, another as its float, text and Bytes through SHA-512
random.seed(42)
print(random.random(), random.random(), random.Random(42).random())
for s in [0, -1, 4294967296, 2 ** 70, 1e300, 0.5, -1.5, INF, -INF, -1 / 2305843009213693952, "hello", "", "héllo €😀", Bytes([0, 0, 1])] {
  random.seed(s)
  print(s, random.random(), random.getrandbits(32))
}
for s in ["hello", "", "héllo €😀", Bytes([200, 1])] {
  random.seed(s, 1)  // version 1: Python 2's way
  print("v1", s, random.random())
}
print(random.Random("hello").random(), random.Random(Bytes("abc")).random(), random.Random(2 ** 70).random())
random.seed()  // from the system
let a = random.random()
random.seed()
print(a != random.random(), random.Random().random() != random.Random().random())

// whole numbers and bytes
random.seed(2024)
var bits = []
for k in 0..54 { push(&bits, random.getrandbits(k)) }
print(bits)
print([0, 1, 3, 4, 5, 8, 13].map(fn(n) => random.randbytes(n).hex()))
print(random.randrange(10), random.randrange(3, 10), random.randrange(0, 100, 7), random.randrange(100, 0, -3), random.randrange(-5, 5))
print(random.randrange(-9007199254740992, 9007199254740992), random.randint(1, 6), random.randint(-100, 100), random.randint(0, 0))
print(random.randint(-9007199254740992, 9007199254740992), random.randint(0, 4294967296))

// picking from lists and ranges
var xs = []
for i in 0..30 { push(&xs, i * 10) }
var big = []
for i in 0..100 { push(&big, i) }
print(random.choice(xs), random.choice(["only"]), random.choice(0..100), random.choice(3..=9), random.choice(Range(0, 50, 5)))
print(random.shuffle(xs), random.shuffle([]), random.shuffle(["a", "b", "c"]))
print(random.shuffle(big).slice(0, 12))
print(random.sample(xs, 5), random.sample(xs, 0), random.sample(0..10, 10))
print(random.sample(0..1000000, 8), random.sample(big, 70).slice(0, 8), random.sample(0..100, 25).slice(0, 8))
print(random.sample(["red", "blue"], 5, {counts: [4, 2]}), random.sample(["a", "b", "c"], 4, {counts: [1000, 0, 5]}))
print(random.sample(big, 3, {counts: big}))
print(random.choices(xs), random.choices(xs, {k: 5}), random.choices(xs, {k: 0}), random.choices(xs, {k: -2}))
print(random.choices(["a", "b", "c"], [5, 1, 0.5], {k: 8}), random.choices(["a", "b", "c"], {cum_weights: [1, 2, 10], k: 6}))
print(random.choices(0..5, {weights: [1, 2, 3, 4, 5], k: 8}), random.choices(big, big, {k: 4}), random.choices([], {k: 0}))

// distributions
print(random.uniform(1, 10), random.uniform(5, -5), random.triangular(), random.triangular(1, 10), random.triangular(1, 10, 9))
print(random.triangular(5, 5, 5), random.triangular(0, 1, 0.1), random.triangular(10, 0))
print(rs([random.normalvariate(), random.normalvariate(10), random.normalvariate(10, 2)]))
print(rs([random.gauss(), random.gauss(), random.gauss(5, 2), random.gauss(5, 2), random.gauss(1)]))
print(rs([random.lognormvariate(0, 1), random.expovariate(), random.expovariate(2), random.expovariate(-0.5)]))
print(rs([random.vonmisesvariate(0, 0), random.vonmisesvariate(1, 1), random.vonmisesvariate(3, 10), random.vonmisesvariate(-2, 0.1)]))
print(rs([random.gammavariate(0.5, 1), random.gammavariate(1, 2), random.gammavariate(2.5, 1), random.gammavariate(100, 0.5)]))
print(rs([random.betavariate(2, 5), random.betavariate(0.5, 0.5), random.paretovariate(3.5), random.weibullvariate(2, 0.5)]))
print(random.binomialvariate(), random.binomialvariate(1, 0.9), random.binomialvariate(10, 0.3), random.binomialvariate(100, 0.05))
print(random.binomialvariate(1000, 0.3), random.binomialvariate(50, 0.9), random.binomialvariate(0, 0.5), random.binomialvariate(20, 0))
print(random.binomialvariate(20, 1), random.binomialvariate(1000000, 0.4), random.binomialvariate(5, 1e-300))
var many = []
for i in 0..60 { push(&many, random.binomialvariate(60, 0.4)) }
print(many)
print(random.BPF, random.RECIP_BPF, random.LOG4, random.NV_MAGICCONST, random.SG_MAGICCONST, random.TWOPI)

// state
let st = random.getstate()
print(len(st), st[0], len(st[1]), st[1][624], st[2], st[1][0])
let drawn = [random.random(), random.gauss(), random.gauss()]
random.setstate(st)
print(drawn == [random.random(), random.gauss(), random.gauss()])
random.gauss()
print(random.getstate()[2] == false, r(random.gauss()))
let st2 = random.getstate()
print(r(st2[2]))
var words = st2[1].map(fn(w) => w - 4294967296)  // version 2: words may be negative (taken modulo 2^32)
words[624] = 624
random.setstate([2, words, false])
print(random.random(), random.getstate()[2])

// a generator of one's own
let g = random.Random("seed text")
print(g, type(g), g is random.Random, g.random(), g.randint(1, 1000000), g.choice(xs), g.sample(xs, 3), g.choices(xs, {k: 2}))
print(r(g.gauss()), g.binomialvariate(30, 0.5), g.randbytes(5).hex(), g.shuffle([1, 2, 3, 4]))
let saved = g.getstate()
g.seed(99)
print(g.random())
g.setstate(saved)
print(g.random())

// the system's random bytes
let sr = random.SystemRandom()
let x = sr.random()
print(sr, type(sr), x >= 0 and x < 1, sr.randint(1, 6) <= 6, len(sr.randbytes(8)), sr.getrandbits(53) < 2 ** 53, sr.getrandbits(0))
sr.seed(5)  // (does nothing, as in Python)
print(random.SystemRandom(1).randrange(10) < 10, sr.choice(xs) % 10, type(sr.gauss()), sr.shuffle([1, 2]).sort())

// mistakes
tries(fn() { random.seed([1]) })
tries(fn() { random.seed(sqrt(-1)) })
tries(fn() { random.seed("x", 3) })
tries(fn() { random.Random(true) })
tries(fn() { random.getrandbits(54) })
tries(fn() { random.getrandbits(-1) })
tries(fn() { random.getrandbits(1.5) })
tries(fn() { random.randbytes(-1) })
tries(fn() { random.randrange(0) })
tries(fn() { random.randrange(5, 3) })
tries(fn() { random.randrange(1, 10, -1) })
tries(fn() { random.randrange(1, 10, 0) })
tries(fn() { random.randrange(2.5) })
tries(fn() { random.randrange(2 ** 60) })
tries(fn() { random.randrange("10") })
tries(fn() { random.randint(3, 2) })
tries(fn() { random.choice([]) })
tries(fn() { random.choice(5..5) })
tries(fn() { random.choice(0..INF) })
tries(fn() { random.choice("abc") })
tries(fn() { random.shuffle(0..3) })
tries(fn() { random.sample(xs, 31) })
tries(fn() { random.sample(xs, -1) })
tries(fn() { random.sample(xs, 2, 3) })
tries(fn() { random.sample(["a"], 1, {counts: 3}) })
tries(fn() { random.sample(["a"], 1, {counts: [1, 2]}) })
tries(fn() { random.sample(["a", "b"], 1, {counts: [1, 0.5]}) })
tries(fn() { random.sample(big, 1, {counts: big.map(fn(v) => v + 0.5)}) })
tries(fn() { random.sample(["a", "b"], 1, {counts: [1, -2]}) })
tries(fn() { random.sample(["a", "b"], 3, {counts: [1, 1]}) })
tries(fn() { random.choices([]) })
tries(fn() { random.choices(xs, 5) })
tries(fn() { random.choices(xs, [1], 5) })
tries(fn() { random.choices(xs, {k: 1}, {k: 2}) })
tries(fn() { random.choices(xs, xs, {weights: xs}) })
tries(fn() { random.choices(xs, {weights: xs, cum_weights: xs}) })
tries(fn() { random.choices(xs, {k: 1.5}) })
tries(fn() { random.choices(xs, {weights: 5}) })
tries(fn() { random.choices(xs, [1, 2]) })
tries(fn() { random.choices([], [], {k: 1}) })
tries(fn() { random.choices(["a", "b"], [1, "2"]) })
tries(fn() { random.choices(["a", "b"], [0, 0]) })
tries(fn() { random.choices(["a", "b"], [1, INF]) })
tries(fn() { random.choices(big, big.map(fn(v) => -v)) })
tries(fn() { random.uniform(1, "2") })
tries(fn() { random.triangular(0, 1, "a") })
tries(fn() { random.normalvariate("0") })
tries(fn() { random.gauss(0, "1") })
tries(fn() { random.lognormvariate(0, false) })
tries(fn() { random.expovariate(0) })
tries(fn() { random.expovariate("1") })
tries(fn() { random.vonmisesvariate(0, sqrt(-1)) })
tries(fn() { random.vonmisesvariate(0, "1") })
tries(fn() { random.gammavariate(0, 1) })
tries(fn() { random.gammavariate(INF, 1) })
tries(fn() { random.gammavariate(1, "1") })
tries(fn() { random.betavariate(1, -1) })
tries(fn() { random.betavariate(sqrt(-1), 1) })
tries(fn() { random.betavariate("1", 1) })
tries(fn() { random.paretovariate(0) })
tries(fn() { random.paretovariate("1") })
tries(fn() { random.weibullvariate(1, 0) })
tries(fn() { random.weibullvariate(1, "1") })
tries(fn() { random.binomialvariate(-1, 0.5) })
tries(fn() { random.binomialvariate(10, 1.5) })
tries(fn() { random.binomialvariate(10, sqrt(-1)) })
tries(fn() { random.binomialvariate(10, "a") })
tries(fn() { random.binomialvariate(2.5) })
tries(fn() { random.setstate(5) })
tries(fn() { random.setstate([3, [1, 2], false]) })
tries(fn() { random.setstate([4, st[1], false]) })
tries(fn() { random.setstate(["3", st[1], false]) })
tries(fn() { random.setstate([3, st[1], "x"]) })
var bad = st[1].map(fn(w) => w)
bad[5] = 0.5
tries(fn() { random.setstate([3, bad, false]) })
bad[5] = 4294967296
tries(fn() { random.setstate([3, bad, false]) })
bad[5] = 0
bad[624] = 625
tries(fn() { random.setstate([3, bad, false]) })
tries(fn() { sr.getstate() })
tries(fn() { sr.setstate(st) })
tries(fn() { random.randint(1) })
tries(fn() { g.randint(1.5, 2) })  // (a method's object is its argument 1)
tries(fn() { g.choice(5) })
