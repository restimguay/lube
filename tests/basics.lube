# numbers and arithmetic
print(1 + 2 * 3, (1 + 2) * 3, 10 / 4, 7 % 3, -7 % 3, 7 % -3, 2 ** 10, -2 ** 2)
print(0.1 + 0.2, 1 / 3, 1e21, 1_000_000, 0xff, 3.0, -0)
print(10 / 3 * 3 == 10, 5 > 3, 5 >= 5, 2 < 1, "a" < "b", "abc" < "abd")

# variables and assignment
var x = 10
x += 5
x -= 3
x *= 2
x /= 4
x %= 4
print("x =", x)
var later = 0             # there is no nil: every variable starts with a value
later = 99
print(later)

# booleans and logic
print(true and false, true or false, not true, !false)
print(false or "default", 0 and "zero is truthy", "" and "so is empty string")
print(not 1 == 2)
print(false or false)

# types
print(type(1), type("s"), type([]), type({}), type(true), type(print), type(fn() => 1), type(1..2))

# conversions
print(str(42) + "!", num("3.5") + 1, num("nope", -1), int(-3.7), int("12"), bool(0), bool(false))
print(repr("quote\"d\n"), repr([1, "two", true]))

# string concatenation converts the other side
print("n=" + 5, 5 + "=n", "list: " + [1, 2])

# equality is structural for lists and maps
print([1, [2, 3]] == [1, [2, 3]], {a: 1, b: 2} == {b: 2, a: 1}, [1] == [2], 1 == "1")

# repetition
print("ab" * 3, [0] * 4, 2 * "xy")
