// Tensors with gradients (the plugin nn): operations and their gradients (each checked against finite
// differences), layers, losses, optimizers, files. Results through libm print rounded: the same everywhere.
import nn
import array as np
import fs.*

fn tries(f) { try { print(f()) } catch e { print("error:", e) } }
fn fails(f) { try { f() } catch e { print("error:", e) } }  // (for what gives nothing)
fn r(x) => np.round(np.array(x, "float64"), 6)
fn data(n, k) => np.sin(np.arange(n) * k + 0.3)
fn leaf(a) => nn.tensor(a, {requires_grad: true})

// The gradient of sum(f(x) * weights) by central differences, x a float64 Array: close to backward's?
fn gradcheck(name, f, x0) {
    let x = leaf(x0)
    let out = f(x)
    let w = data(out.data.size, 0.37).reshape(out.shape)
    (out * w).sum().backward()
    var numeric = np.zeros_like(x0)
    let flat = x0.reshape(-1)
    for i in 0..flat.size {
        var up = flat.copy()
        var down = flat.copy()
        up[i] += 1e-6
        down[i] -= 1e-6
        let fu = nn.no_grad(fn() => (f(nn.tensor(up.reshape(x0.shape))) * w).sum().item())
        let fd = nn.no_grad(fn() => (f(nn.tensor(down.reshape(x0.shape))) * w).sum().item())
        var nf = numeric.reshape(-1)
        nf[i] = (fu - fd) / 2e-6
        numeric = nf.reshape(x0.shape)
    }
    print(name, np.allclose(x.grad, numeric, {rtol: 1e-4, atol: 1e-6}))
}

// ---------- making Tensors ----------
let t = nn.tensor([[1, 2], [3, 4]])
print(t, t.shape, t.ndim, t.dtype, t.requires_grad, t.is_leaf, t.has_grad, type(t), t is nn.Tensor, len(t))
print(nn.tensor(5), nn.tensor(true), nn.tensor([1, 2], {dtype: "float64"}), nn.tensor(np.array([1, 2], "int64")), nn.Tensor([1]), nn.tensor(t).shape)
print(nn.zeros(2), nn.zeros([2, 1]), nn.ones(2, {dtype: "int32"}), nn.full([2], 7), nn.full(2, 1.5, {dtype: "float64"}), nn.arange(3), nn.arange(1, 2, 0.5), nn.arange(4, {dtype: "int64"}))
nn.manual_seed(0)
print(r(nn.rand(3).data), r(nn.randn(2, {requires_grad: true}).data), nn.rand(2, 3).shape, nn.zeros(2, {requires_grad: true}).requires_grad)
let a = np.array([1, 2, 3])
let ta = nn.tensor(a)
print(ta.data, ta.numpy() == a, ta.to_list(), ta.tolist(), ta.to_array().dtype, nn.tensor(1.5).item(), nn.tensor(true).item())

// ---------- operators and their gradients ----------
let x = leaf(data(6, 0.7).reshape(2, 3))
let y = leaf(data(6, 0.4).reshape(2, 3))
let z = (x + y) * (x - y) / (y + 3) + 2 * x - x / 2 + 1 - y ** 2 + 2 ** x - x @ y.T @ x + (-x)
z.sum().backward()
print(r(z.data), r(x.grad), r(y.grad), x.has_grad)
print(x == x, x != y, x < y, x <= y, x > y, x >= y, r(x[0].data), r(x[1, 2].item()), x[.., 1].shape, x[0].requires_grad)
print(nn.sum([1, 2]).item(), nn.mean(np.array([1, 3])).item(), r(x.pow(2).data), r(x.matmul(y.T).data), nn.randn(40, 3).data.shape)
print(nn.arange(70))
print(nn.add(1, 2).item(), nn.sub([3], 1).data, nn.mul(x, 0).sum().item(), nn.div(2, 4).item(), nn.pow(2, 3).item(), nn.matmul([1, 2], [3, 4]).item())
gradcheck("add", fn(v) => v + data(6, 0.2).reshape(2, 3) + 1, data(6, 0.7).reshape(2, 3))
gradcheck("broadcast", fn(v) => v * nn.tensor(data(3, 0.5)) - nn.tensor(data(2, 0.1).reshape(2, 1)) / (v + 3), data(6, 0.7).reshape(2, 3))
gradcheck("pow", fn(v) => (v + 2) ** 3 + 2 ** v + (v + 2) ** (v + 2), data(4, 0.7))
gradcheck("matmul", fn(v) => v @ nn.tensor(data(12, 0.3).reshape(3, 4)), data(6, 0.7).reshape(2, 3))
gradcheck("matmul right", fn(v) => nn.tensor(data(6, 0.3).reshape(2, 3)) @ v, data(12, 0.7).reshape(3, 4))
gradcheck("vector @ matrix", fn(v) => v @ nn.tensor(data(6, 0.3).reshape(3, 2)), data(3, 0.7))
gradcheck("matrix @ vector", fn(v) => nn.tensor(data(6, 0.3).reshape(2, 3)) @ v, data(3, 0.7))
gradcheck("vector @ vector", fn(v) => (v @ nn.tensor(data(3, 0.3))).reshape(1), data(3, 0.7))
gradcheck("batched", fn(v) => v @ nn.tensor(data(12, 0.3).reshape(2, 3, 2)), data(6, 0.7).reshape(2, 3))
gradcheck("exp log sqrt", fn(v) => nn.exp(v) + nn.log(v + 2) + nn.sqrt(v + 2) + v.exp() + (v + 2).log() + (v + 2).sqrt(), data(6, 0.7))
gradcheck("tanh sigmoid", fn(v) => nn.tanh(v) + nn.sigmoid(v) + v.tanh() * v.sigmoid(), data(6, 0.7))
gradcheck("relu family", fn(v) => nn.relu(v) + nn.leaky_relu(v) + nn.leaky_relu(v, 0.2) + nn.gelu(v) + nn.silu(v) + v.relu(), data(6, 0.7))
gradcheck("abs clamp", fn(v) => nn.abs(v) + v.abs() + nn.clamp(v, -0.5, 0.5) + v.clamp(-0.2, 0.9), data(6, 0.7))
gradcheck("softmax", fn(v) => nn.softmax(v, 1) + nn.softmax(v) * 2 + v.softmax(0), data(6, 0.7).reshape(2, 3))
gradcheck("log_softmax", fn(v) => nn.log_softmax(v, 0) + v.log_softmax(1), data(6, 0.7).reshape(2, 3))
gradcheck("sum mean", fn(v) => v.sum(0) + v.mean(1, {keepdim: true}).sum() + nn.sum(v) + nn.mean(v, -1).sum() + v.sum(), data(6, 0.7).reshape(2, 3))
gradcheck("max", fn(v) => v.max(1) + v.max() + nn.max(v, 0, {keepdim: true}).sum(), data(6, 0.7).reshape(2, 3))
gradcheck("shapes", fn(v) => v.reshape(3, 2).T.flatten() + v.view([6]) + v.transpose(0, 1).reshape(-1) + v.permute(1, 0).reshape(6) + v.permute([1, 0]).reshape(6) + v.unsqueeze(0).squeeze(0).reshape(6) + v.T.reshape(6) + v.unsqueeze(-1).squeeze().reshape(6) + v.reshape([1, 6]).squeeze(0), data(6, 0.7).reshape(2, 3))
gradcheck("index", fn(v) => v[0] + v[.., 1].sum() * v[1, 2] + v[[0, 1, 1], [2, 0, 0]].sum() + v[v.data > 0].sum() + v[1..].sum(), data(6, 0.7).reshape(2, 3))
gradcheck("index by Tensor", fn(v) => v[nn.tensor(np.array([2, 2, 0], "int64"))], data(3, 0.7))
gradcheck("cat stack", fn(v) => nn.cat([v, v * 2], 1).sum(1) + nn.stack([v, v + 1]).sum(0).sum(1) + nn.cat([v, v]).sum(0).sum() + nn.stack([v, v], -1).sum(2).sum(1), data(6, 0.7).reshape(2, 3))
gradcheck("cross_entropy", fn(v) => nn.cross_entropy(v, [2, 0]) + nn.cross_entropy(v, np.array([1, 1]), {reduction: "sum"}) + nn.cross_entropy(v, [0, 2], {reduction: "none"}).sum() + nn.cross_entropy(v[0], 1), data(6, 0.7).reshape(2, 3))
gradcheck("nll_loss", fn(v) => nn.nll_loss(nn.log_softmax(v, 1), [2, 0]) + nn.nll_loss(v, [1, 1], {reduction: "sum"}), data(6, 0.7).reshape(2, 3))
gradcheck("mse l1", fn(v) => nn.mse_loss(v, data(6, 0.3)) + nn.l1_loss(v, data(6, 0.1), {reduction: "sum"}) + nn.mse_loss(v, 0.5, {reduction: "none"}).sum(), data(6, 0.7))
gradcheck("bce", fn(v) => nn.binary_cross_entropy(nn.sigmoid(v), np.array([0, 1, 1, 0, 1, 0]) * 1.0) + nn.binary_cross_entropy_with_logits(v, [1, 0, 1, 0, 0, 1]), data(6, 0.7))
gradcheck("mse target", fn(v) => nn.mse_loss(nn.tensor(data(6, 0.3)), v) + nn.l1_loss(nn.tensor(data(6, 0.1)), v), data(6, 0.7))
gradcheck("bce target", fn(v) => nn.binary_cross_entropy(nn.tensor(np.array([0.2, 0.7, 0.5])), (v + 1) / 3) + nn.binary_cross_entropy_with_logits(nn.tensor(data(3, 0.2)), v), data(3, 0.7))
gradcheck("embedding", fn(v) => nn.embedding(np.array([[0, 2], [2, 3]]), v) * 2, data(12, 0.7).reshape(4, 3))
gradcheck("layer_norm x", fn(v) => nn.layer_norm(v, nn.tensor(data(3, 0.9)), nn.tensor(data(3, 0.2))) + nn.layer_norm(v), data(6, 0.7).reshape(2, 3))
gradcheck("layer_norm weight", fn(v) => nn.layer_norm(nn.tensor(data(6, 0.7).reshape(2, 3)), v, nn.tensor(data(3, 0.2)), {eps: 1e-3}), data(3, 0.9))
gradcheck("layer_norm bias", fn(v) => nn.layer_norm(nn.tensor(data(6, 0.7).reshape(2, 3)), nn.tensor(data(3, 0.9)), v), data(3, 0.2))
gradcheck("conv2d x", fn(v) => nn.conv2d(v, nn.tensor(data(2 * 2 * 3 * 3, 0.5).reshape(2, 2, 3, 3)), nn.tensor(data(2, 0.2)), {stride: 2, padding: 1}), data(2 * 2 * 5 * 5, 0.3).reshape(2, 2, 5, 5))
gradcheck("conv2d weight", fn(v) => nn.conv2d(nn.tensor(data(1 * 2 * 4 * 4, 0.3).reshape(1, 2, 4, 4)), v), data(3 * 2 * 2 * 2, 0.5).reshape(3, 2, 2, 2))
gradcheck("conv2d bias", fn(v) => nn.conv2d(nn.tensor(data(1 * 1 * 3 * 3, 0.3).reshape(1, 1, 3, 3)), nn.tensor(data(4, 0.5).reshape(1, 1, 2, 2)), v), data(1, 0.2))
gradcheck("pools", fn(v) => nn.max_pool2d(v, 2) + nn.avg_pool2d(v, 2) + nn.max_pool2d(v, 3, {stride: 1}).sum() + nn.avg_pool2d(v, 2, {stride: 1}).sum(), data(1 * 2 * 4 * 4, 0.8).reshape(1, 2, 4, 4))
gradcheck("linear", fn(v) => nn.linear(v, nn.tensor(data(12, 0.3).reshape(4, 3)), nn.tensor(data(4, 0.1))) + nn.linear(v, nn.tensor(data(6, 0.2).reshape(2, 3))).sum(), data(6, 0.7).reshape(2, 3))
gradcheck("linear weight", fn(v) => nn.linear(nn.tensor(data(6, 0.7).reshape(2, 3)), v), data(12, 0.3).reshape(4, 3))
gradcheck("linear bias 3d", fn(v) => nn.linear(nn.tensor(data(12, 0.7).reshape(2, 2, 3)), nn.tensor(data(6, 0.3).reshape(2, 3)), v), data(2, 0.1))
gradcheck("dropout off", fn(v) => nn.dropout(v, 0.5, false) + nn.dropout(v, 0), data(6, 0.7))

// ---------- the graph ----------
nn.manual_seed(1)
let d = leaf(data(1000, 0.3))
let kept = nn.dropout(d, 0.5)
kept.sum().backward()
print(r(kept.data.sum()), np.count_nonzero(kept.data), np.array_equal(d.grad == 0, kept.data == 0), np.unique(d.grad).to_list())
let g1 = leaf(np.array([1.0, 2.0]))
let shared = g1 * 3
let l1 = shared.sum()
let l2 = (shared * shared).sum()
l1.backward({retain_graph: true})
l2.backward()
print(g1.grad, l1.requires_grad, shared.is_leaf)
fails(fn() { l2.backward() })
fails(fn() { shared.sum().backward() })
let fresh = g1 * 4
fails(fn() { (fresh.sum() + shared.sum()).backward() })  // (found partway through)
print(fresh.sum().requires_grad)
let g2 = leaf(np.array([3.0]))
let h = g2 * g2
h.backward(nn.tensor([2.0]))
print(g2.grad)
let g3 = leaf(np.array([1.0, 2.0]))
(g3 * 2).backward(np.array([1, 1]))
(g3 * 2).sum().backward()
print(g3.grad)
g3.zero_grad()
print(g3.has_grad, g3.grad)
print(nn.is_grad_enabled(), nn.no_grad(fn() => (g3 * 2).requires_grad), nn.no_grad(fn() => nn.is_grad_enabled()), nn.is_grad_enabled())
nn.set_grad_enabled(false)
print((g3 * 2).requires_grad, nn.is_grad_enabled())
nn.set_grad_enabled(true)
print((g3 * 2).requires_grad, (g3 * 2).detach().requires_grad, (g3 * 2).is_leaf, nn.tensor([1]).requires_grad_().requires_grad, nn.tensor([1.0], {requires_grad: true}).requires_grad_(false).requires_grad)
var w = leaf(np.array([1.0, 2.0]))
w.add_([1, 1])
w.sub_(np.array([0.5, 0.5]), 2)
w.mul_(2)
print(w, w.add_(1, 0.5).data, w.fill_(3).data, w.zero_().data, w.copy_([7, 8]).data, w.copy_(nn.tensor([5.0, 6.0])).data)
print(w.astype("int64"), w.astype("float64").dtype, nn.tensor([1, 2]).astype("bool"))
let deep = leaf(np.array([1.0]))
var chain = deep
for i in 0..3000 { chain = chain * 1.0001 }
chain.backward()
print(r(deep.grad))  // (a long graph: walked without recursion)

// ---------- modules ----------
nn.manual_seed(2)
let lin = nn.Linear(3, 2)
print(lin, lin.weight.shape, lin.bias.shape, lin.training, len(lin.parameters()), nn.Linear(3, 2, {bias: false}), keys(lin.state_dict()))
print(lin.forward(nn.tensor(data(6, 0.7).reshape(2, 3))).shape, lin.forward(data(3, 0.1)).shape, lin.forward([[1, 2, 3]]).shape)
let conv = nn.Conv2d(2, 3, 3, {stride: 1, padding: 1})
print(conv, conv.forward(nn.randn(1, 2, 5, 5)).shape, nn.Conv2d(1, 1, 2, {bias: false}).parameters().len(), nn.Conv2d(1, 2, 3).forward(nn.zeros(1, 1, 4, 4)).shape)
let emb = nn.Embedding(10, 4)
print(emb, emb.forward([1, 2, 9]).shape, emb.forward(np.array([[0, 1]])).shape)
let ln = nn.LayerNorm(4, {eps: 1e-6})
print(ln, ln.weight.data, ln.bias.data, r(ln.forward(nn.tensor(data(8, 0.5).reshape(2, 4))).data))
let drop = nn.Dropout(0.25)
print(drop, drop.training, drop.eval().training, drop.forward(nn.ones(3)).data, drop.train().training, nn.Dropout().forward(nn.ones(4)).shape, drop.train(false).training)
let acts = [nn.ReLU(), nn.Sigmoid(), nn.Tanh(), nn.GELU(), nn.SiLU(), nn.LeakyReLU(), nn.LeakyReLU(0.3), nn.Softmax(), nn.Softmax(0), nn.LogSoftmax(), nn.Flatten()]
for m in acts { write(m, " ", r(m.forward(nn.tensor(data(4, 0.9).reshape(2, 2))).data).to_list(), " | ") }
print()
// float32's activations (vectorized, without the C library) against float64's, forward and backward, out to
// the extremes: within a few units in float32's last place
let wide = np.concatenate([np.linspace(-30, 30, 1201), np.array([0, -0.0, 1e-30, -1e-30, 88, -88, 100, -100, 1e30, -1e30])])
for name in ["sigmoid", "tanh", "gelu", "silu", "relu", "leaky_relu"] {
  let f64 = leaf(wide.astype("float32").astype("float64"))  // (the very inputs float32 has)
  let f32 = leaf(wide.astype("float32"))
  let pick = {sigmoid: nn.sigmoid, tanh: nn.tanh, gelu: nn.gelu, silu: nn.silu, relu: nn.relu, leaky_relu: nn.leaky_relu}
  let y64 = pick[name](f64)
  let y32 = pick[name](f32)
  y64.sum().backward()
  y32.sum().backward()
  let close = np.allclose(y32.data.astype("float64"), y64.data, {rtol: 2e-6, atol: 1e-37})
  let gclose = np.allclose(f32.grad.astype("float64"), f64.grad, {rtol: 2e-5, atol: 1e-7})  // (o (1 - o) and 1 - o^2 cancel in float32)
  print(name, y32.dtype, close, gclose, np.isnan(pick[name](nn.tensor(np.array([np.nan], "float32"))).data).all(), pick[name](nn.tensor(np.array([np.inf, -np.inf], "float32"))).data)
}
let rows32 = nn.tensor((np.arange(24) * 0.37 - 3).reshape(2, 12).astype("float32"))
let rows64 = nn.tensor((np.arange(24) * 0.37 - 3).reshape(2, 12))
let ln12 = nn.LayerNorm(12)
print(np.allclose(nn.softmax(rows32, 1).data, nn.softmax(rows64, 1).data, {rtol: 1e-5}), np.allclose(nn.log_softmax(rows32, 1).data, nn.log_softmax(rows64, 1).data, {rtol: 1e-5}), np.allclose(ln12.forward(rows32).data, ln12.forward(rows64.data.astype("float32")).data), r(ln12.forward(rows32).data[0, ..3]).to_list(), nn.softmax(rows32, 0).dtype)
let cl = leaf(np.array([-2, 0.5, 3], "float32"))
nn.clamp(cl, -1, 1).sum().backward()
print(nn.tanh(nn.tensor([1, 2], {dtype: "int64"})).dtype, nn.clamp(cl, -1, 1).data, cl.grad)
print(nn.MaxPool2d(2), nn.MaxPool2d(2).forward(nn.ones(1, 1, 4, 4)).shape, nn.AvgPool2d(2, {stride: 1}).forward(nn.ones(1, 1, 3, 3)).data)
let losses = [nn.MSELoss(), nn.L1Loss({reduction: "sum"}), nn.CrossEntropyLoss(), nn.BCELoss(), nn.BCEWithLogitsLoss({reduction: "none"})]
let preds = [nn.tensor([0.5, 0.2]), nn.tensor([0.5, 0.2]), nn.tensor([[1.0, 2.0]]), nn.tensor([0.25, 0.5]), nn.tensor([1.0, -1.0])]
let targets = [nn.tensor([1.0, 0.0]), [1, 0], [1], [1, 0], [1, 1]]
for i in 0..len(losses) { write(losses[i], " ", r(losses[i].forward(preds[i], targets[i]).data).to_list(), " | ") }
print()

class Scale {  // a module of one's own, in a Sequential
    var factor = nn.tensor([2.0], {requires_grad: true})
    fn forward(x) => x * this.factor
    fn parameters() => [this.factor]
}
nn.manual_seed(3)
let seq = nn.Sequential([nn.Linear(2, 4), nn.ReLU(), Scale(), nn.Linear(4, 1)])
print(seq, len(seq.parameters()), keys(seq.state_dict()), seq.forward(nn.ones(3, 2)).shape, seq.eval().training, seq.train().training)
let inner = nn.Sequential([nn.Sequential([nn.Linear(1, 1)])])
print(keys(inner.state_dict()), inner.parameters().len())
let seq2 = nn.Sequential([nn.Linear(2, 4), nn.ReLU(), Scale(), nn.Linear(4, 1)])
seq2.load_state_dict(seq.state_dict())
print(np.array_equal(seq2.forward(nn.ones(1, 2)).data, seq.forward(nn.ones(1, 2)).data))
class Odd {
    fn forward(x) => x
    fn parameters() => 5
}
tries(fn() => nn.Sequential([Odd()]).parameters())
seq.forward(nn.ones(1, 2)).sum().backward()
print(seq.parameters()[0].has_grad, seq.parameters()[4].has_grad)
seq.zero_grad()
print(seq.parameters()[0].has_grad, seq.parameters()[4].has_grad)

// training: a small network learns XOR, with each optimizer
fn train(opt_maker, steps) {
    nn.manual_seed(4)
    let net = nn.Sequential([nn.Linear(2, 8), nn.Tanh(), nn.Linear(8, 1)])
    let opt = opt_maker(net.parameters())
    let X = nn.tensor([[0, 0], [0, 1], [1, 0], [1, 1]])
    let Y = nn.tensor([[0], [1], [1], [0]])
    var first = 0
    var last = 0
    for step in 0..steps {
        opt.zero_grad()
        let loss = nn.binary_cross_entropy_with_logits(net.forward(X), Y)
        loss.backward()
        opt.step()
        if step == 0 { first = loss.item() }
        last = loss.item()
    }
    let right = nn.no_grad(fn() => np.array_equal(net.forward(X).data > 0, Y.data > 0.5))
    print(opt, first > last * 10, right)
}
train(fn(p) => nn.SGD(p, {lr: 0.5}), 800)
train(fn(p) => nn.SGD(p, {lr: 0.2, momentum: 0.9}), 400)
train(fn(p) => nn.SGD(p, {lr: 0.2, momentum: 0.9, nesterov: true, weight_decay: 1e-4, dampening: 0}), 400)
train(fn(p) => nn.Adam(p, {lr: 0.05}), 300)
train(fn(p) => nn.Adam(p, {lr: 0.05, betas: [0.8, 0.99], eps: 1e-6, weight_decay: 1e-4}), 300)
train(fn(p) => nn.AdamW(p, {lr: 0.05}), 300)
let o = nn.SGD(lin, {lr: 0.1})
o.set_lr(0.05)
print(o.lr, nn.Adam([lin.weight]).lr, o)
o.step()  // (no gradients yet: nothing moves)
let w64 = nn.tensor([1.0, 2.0], {dtype: "float64", requires_grad: true})
let o64 = nn.Adam([w64], {lr: 0.1})
(w64 * w64).sum().backward()
o64.step()
o64.zero_grad()
print(r(w64.data), w64.dtype, w64.has_grad)
let tp = nn.tensor(np.array([[1.0, 2.0], [3.0, 4.0]]).T, {requires_grad: true})  // (its data a transposed view)
(tp * 1).sum().backward()
nn.SGD([tp], {lr: 1}).step()
print(tp.data)
let big = nn.zeros(300000, {requires_grad: true})
(big * 2).sum().backward()
nn.SGD([big], {lr: 1}).step()
print(big.data.sum())

// state: save, load, load_state_dict
make_dir("build/nn")
nn.save("build/nn/lin.safetensors", lin)
nn.save("build/nn/mix.safetensors", {a: nn.tensor([1, 2]), b: np.array([3, 4], "int64")})
let back = nn.load("build/nn/lin.safetensors")
print(keys(back), back.weight.shape, np.array_equal(back.weight.data, lin.weight.data), nn.load("build/nn/mix.safetensors"))
var lin2 = nn.Linear(3, 2)
lin2.load_state_dict(back)
print(np.array_equal(lin2.weight.data, lin.weight.data), np.array_equal(lin2.forward(nn.ones(1, 3)).data, lin.forward(nn.ones(1, 3)).data))
for f in list_dir("build/nn") { remove_file("build/nn/{f}") }

// a CNN on random images, a few steps: the loss goes down
nn.manual_seed(5)
let cnn = nn.Sequential([nn.Conv2d(1, 4, 3, {padding: 1}), nn.ReLU(), nn.MaxPool2d(2), nn.Flatten(), nn.Linear(4 * 4 * 4, 3)])
let copt = nn.Adam(cnn, {lr: 0.01})
let imgs = nn.randn(6, 1, 8, 8)
let labels = [0, 1, 2, 0, 1, 2]
var losses_seen = []
for step in 0..20 {
    copt.zero_grad()
    let loss = nn.cross_entropy(cnn.forward(imgs), labels)
    loss.backward()
    copt.step()
    push(&losses_seen, loss.item())
}
print(losses_seen[19] < losses_seen[0] / 2, cnn.forward(imgs).argmax(1), nn.tensor([[1, 3], [2, 0]]).argmax(), nn.tensor([[1, 3], [2, 0]]).argmax(0))

