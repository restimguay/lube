# if / else if / else
fn classify(n) {
  if n < 0 {
    return "negative"
  } else if n == 0 {
    return "zero"
  }
  else {
    return "positive"
  }
}
print(classify(-5), classify(0), classify(5))

# while with break and continue
var i = 0
var odds = []
while true {
  i += 1
  if i > 10 { break }
  if i % 2 == 0 { continue }
  odds.push(i)
}
print(odds)

# for over ranges
var total = 0
for n in 1..=100 { total += n }
print(total)
for n in 0..3 { write(n, "") }
print()
for n in range(10, 0, -3) { write(n, "") }
print()
for i, v in 10..13 { write("{i}:{v} ") }
print()
print(list(0..5), len(0..10), 3 in 0..5, 5 in 0..5, (0..10)[2])
print(0..5, 1..=3, range(0, 10, 2))

# for over lists, maps and strings
for i, name in ["ann", "bob"] { print(i, name) }
let ages = {ann: 31, bob: 42}
for name in ages { write("{name} ") }
print()
for name, age in ages { print(name, "is", age) }
for ch in "héllo" { write("[{ch}]") }
print()

# nested loops with break only leaving the inner loop
for a in 1..4 {
  for b in 1..4 {
    if b > a { break }
    write("{a * b} ")
  }
}
print()

# return from inside a loop
fn first_even(xs) {
  for x in xs {
    if x % 2 == 0 { return x }
  }
  return "none"
}
print(first_even([1, 3, 6, 8]), first_even([1, 3]))

# block scoping
let s = "outer"
{
  let s = "inner"
  print(s)
}
print(s)
