// statistics: Python's statistics module (every value here is Python's)
import statistics.*
import random

fn tries(f) { try { f() } catch e { print("error:", e) } }
fn r(x) => round(x, 10)  // (what goes through the C library's exp, log, erfc...: the same to 10 places everywhere)
fn rs(xs) => xs.map(fn(x) => round(x, 10))

// averages: mean is exact, rounded once, as Python's fractions make it
let data = [2.75, 1.75, 1.25, 0.25, 0.5, 1.25, 3.5]
print(mean([1, 2, 3, 4, 4]), mean(data), mean([1, 2 ** 53]), mean([0.1, 0.2, 0.3]), mean([5]))
print(mean([1e308, 1e308, -1e308]), mean([1e300, 1e-300, -1e300]), mean([INF, 1]), mean([INF, -INF]))
print(mean([0.05509867951780667, 0.37895869223954104, 3.679838154381965e-06, 0.6571665884309464, 8.6]))
print(mean([2.9038382117615538e-09, 0.5615215894353001, 0.444, 3902385823723291, 73.85940901628109]))
var spread_out = []  // 60 numbers 34 binary places apart: the exact sum needs 60 parts
var tiny = 1
for i in 0..1020 { tiny = tiny / 2 }
for i in 0..60 {
  push(&spread_out, tiny)
  tiny = tiny * 17179869184
}
print(mean(spread_out), fmean(spread_out), median(spread_out))
print(fmean([3.5, 4.0, 5.25]), fmean([3.5, 4.0, 5.25], [1, 2, 3]), fmean([85, 92, 83, 91], [0.2, 0.2, 0.3, 0.3]), fmean([INF, 1]))
print(fmean([1e300, 1e300], [1e300, 1]), fmean([sqrt(-1), 1]))
print(r(geometric_mean([54, 24, 36])), geometric_mean([0, 5]), geometric_mean([INF, 0]), geometric_mean([sqrt(-1), 1]), geometric_mean([INF, 2]))
print(harmonic_mean([40, 60]), harmonic_mean([40, 60], [5, 30]), harmonic_mean([2.5]), harmonic_mean([0, 5]), harmonic_mean([1, 2, 4], [0, 1, 1]))
print(harmonic_mean([8431177211172778, 1, 8.853]), harmonic_mean([0.8461254183769125, 706224.278474486, 1.1761804494650935e-05]))
print(harmonic_mean([1, 2], [INF, 1]), harmonic_mean([sqrt(-1), 2]), harmonic_mean([0, 3], [0, 1]))
print(median([1, 3, 5]), median([1, 3, 5, 7]), median([5, 1, 4, 2, 3, 6]), median_low([1, 3, 5, 7]), median_high([1, 3, 5, 7]), median_low([4]))
var shuffled = []
for i in 0..200 { push(&shuffled, (i * 7919) % 200) }
print(median(shuffled), median_low(shuffled), median_high(shuffled), median([sqrt(-1), 1, 2]) == 2, median([3, 1, 3, 3, 2, 3, 3]))
print(median_grouped([52, 52, 53, 54]), median_grouped([1, 3, 3, 5, 7]), median_grouped([1, 3, 3, 5, 7], 2), median_grouped([5]))
print(mode([1, 1, 2, 3, 3, 3, 3, 4]), mode(["red", "blue", "blue", "red", "green", "red", "red"]), mode([true, false, false]))
print(mode(["ab", "a", "abc", "a", "ab"]), mode([3, "3", 3, "3", "3"]), mode([0, -0.0, 1]), mode([2.5]))
print(multimode("aabbbbccddddeeffffgg".split("")), multimode([1, 2, 3]), multimode([]), multimode([true, 1, true, 1]))

// quantiles: n - 1 cut points
let scores = [105, 129, 87, 86, 111, 111, 89, 81, 108, 92, 110, 100, 75, 105, 103, 109, 76, 119, 99, 91, 103, 129, 106, 101, 84, 111, 74, 87, 86, 103, 103, 106, 86, 111, 75, 87, 102, 121, 111, 88, 89, 101, 106, 95, 103, 107, 101, 81, 109, 104]
print(quantiles(scores), quantiles(scores, {n: 10}))
print(quantiles(scores, {n: 10, method: "inclusive"}), quantiles([1, 2], {n: 5}), quantiles([7], {n: 4}), quantiles([3, 1], {n: 1}))
print(quantiles([1.5, 2.5, 4], {n: 6, method: "inclusive"}), quantiles([7], {method: "unknown"}))

// spread: the variances and standard deviations are exact, rounded once
print(variance(data), variance(data, mean(data)), pvariance([0, 0, 0.25, 0.25, 0.5, 1.25, 1.5, 1.75, 2.75, 3.25]), pvariance([1.5], 1))
print(stdev([1.5, 2.5, 2.5, 2.75, 3.25, 4.75]), pstdev([1.5, 2.5, 2.5, 2.75, 3.25, 4.75]), stdev([1, 2], 0), pstdev([4]))
print(variance([0.05509867951780667, 0.37895869223954104, 3.679838154381965e-06, 0.6571665884309464, 8.6]))
print(variance([0.22960017476494854, 0.5597009652764126, 2467131542730726, 6126548201401598, 2002046343791388]))
print(stdev([4.68, 13072.342979316054, 0.8223254188009489, -8, 0.2037644115278977]), stdev([0.02862924926135109, 0.45377091126665026, 0.6342418948538627, 9]))
print(variance([1e9 + 1, 1e9 + 2, 1e9 + 3]), variance([1e150, 3e150]), stdev([1e-300, 3e-300, 2e-300]), pvariance([1e200, 1e200]))
print(variance([1e154, -1e154, 1e154], 0), pstdev([1e154, -1e154], 0), variance([1, INF]), pvariance([INF, -INF]), variance([1, 2], INF))
print(pvariance(spread_out.slice(25, 45)), stdev(spread_out.slice(30, 40)), stdev([1, 1, 1]), variance([2 ** 53, 2 ** 53 + 2]))

// two inputs
let xs = [1, 2, 3, 4, 5, 6, 7, 8, 9]
let ys = [1, 2, 3, 1, 2, 3, 1, 2, 3]
print(covariance(xs, ys), covariance(xs, xs.map(fn(v) => 10 - v)), correlation(xs, xs), correlation(xs, xs.map(fn(v) => 10 - v)))
print(correlation(xs, ys), correlation(xs, xs.map(fn(v) => v ** 3), {method: "ranked"}), correlation([1, 2, 2, 3, 3, 3], [4, 4, 1, 2, 2, 9], {method: "ranked"}))
print(correlation([1e100, -1e100], [1e100, -1e100]), correlation([1e-100, -1e-100, 0], [1e-100, -1e-100, 0]), correlation([INF, 1], [1, 2]))
print(linear_regression([1, 2, 3, 4, 5], [3, 5, 7, 9, 11.5]), linear_regression([1, 2, 3, 4, 5], [2, 4, 7, 7, 10], {proportional: true}))
print(linear_regression([1, 2], [5, 5], {proportional: false}))

// the normal distribution
let nd = NormalDist(10, 2.5)
print(nd, NormalDist(), NormalDist(3), nd.mean, nd.median, nd.mode, nd.stdev, nd.variance)
print(rs([nd.pdf(7.5), nd.pdf(10), nd.cdf(7.5), nd.cdf(12.3), nd.inv_cdf(0.1), nd.inv_cdf(0.5), nd.inv_cdf(0.999), nd.inv_cdf(1e-20)]))
print(nd.zscore(15), rs(nd.quantiles()), rs(nd.quantiles(10)).slice(0, 3), NormalDist(3, 0).quantiles(3), nd.quantiles(1))
print(r(nd.overlap(NormalDist(12, 3))), r(NormalDist(12, 3).overlap(nd)), r(nd.overlap(NormalDist(1, 2.5))), r(NormalDist(0, 1).overlap(NormalDist(0, 5))))
print(nd + 5, 5 + nd, nd - 5, 5 - nd, nd * 3, 3 * nd, nd * -2, nd / 4, nd / -4, -nd)
print(nd + NormalDist(1, 1), nd - NormalDist(1, 1), NormalDist(0, 3) + NormalDist(0, 4), NormalDist(1, 0) + NormalDist(2, 0))
print(NormalDist(0, INF) - nd, NormalDist(0, sqrt(-1)) + nd, NormalDist(0, 5e-324) + NormalDist(0, 5e-324))
print(nd == NormalDist(10, 2.5), nd == NormalDist(10, 2), nd != nd, nd != 5, nd == 5, 5 == nd)
print(rs(nd.samples(4, {seed: 42})), rs(NormalDist().samples(3, {seed: "hello"})), nd.samples(0, {seed: 1}), nd.samples(-2))
random.seed(31)  // without a seed: the plugin random's own generator, as Python's random.random
print(rs(NormalDist(100, 15).samples(3)), random.random())
let fs = from_samples([2.5, 3.1, 2.1, 2.4, 2.7, 3.5])
print(fs, fs.mean, fs.stdev, from_samples([1, INF]), type(fs), fs is NormalDist)

// kernel density estimation
let sample = [-2.1, -1.3, -0.4, 1.9, 5.1, 6.2]
for k in ["normal", "logistic", "sigmoid", "rectangular", "triangular", "parabolic", "quartic", "triweight", "cosine", "gauss", "uniform", "epanechnikov", "biweight"] {
  let f = kde(sample, 1.5, k)
  print(f, rs([f.pdf(-3), f.pdf(0.5), f.pdf(6), f.cdf(-3), f.cdf(0.5), f.cdf(9)]))
}
print(kde([5], 2), kde([5], 2).pdf(5) == kde([5], 2, "normal").pdf(5), kde([1, 2, 3], 0.5, "uniform").pdf(10), kde([1, 2, 3], 0.5, "uniform").cdf(10))
for k in ["normal", "logistic", "sigmoid", "rectangular", "triangular", "parabolic", "quartic", "triweight", "cosine"] {
  let s = kde_random(sample, 1.5, k, {seed: 8675309})
  print(s, rs(s.samples(5)))
}
print(rs(kde_random(sample, 0.5, "quartic", {seed: 79}).samples(8)), rs(kde_random(sample, 0.5, "triweight", {seed: 1}).samples(30)).slice(25))
let kr = kde_random(sample, 0.25, {seed: "text"})
print(r(kr.sample()), r(kr.sample()), kde_random(sample, 1).sample() is Number)

// mistakes
tries(fn() { mean([]) })
tries(fn() { mean(5) })
tries(fn() { mean([1, "2"]) })
tries(fn() { fmean([]) })
tries(fn() { fmean([1e308, 1e308]) })
tries(fn() { fmean([INF, -INF]) })
tries(fn() { fmean([1, 2], [1]) })
tries(fn() { fmean([1, 2], [1, -1]) })
tries(fn() { fmean([1, 2], [1, "x"]) })
tries(fn() { fmean([1, 2], [INF, -INF]) })
tries(fn() { geometric_mean([]) })
tries(fn() { geometric_mean([1, -2]) })
tries(fn() { harmonic_mean([]) })
tries(fn() { harmonic_mean([-1]) })
tries(fn() { harmonic_mean([1, -1]) })
tries(fn() { harmonic_mean([1, 2], [1]) })
tries(fn() { harmonic_mean([1, 2], [1, -1]) })
tries(fn() { harmonic_mean([1, 2], [0, 0]) })
tries(fn() { harmonic_mean([1, 2], "w") })
tries(fn() { median([]) })
tries(fn() { median_low([]) })
tries(fn() { median_high("abc") })
tries(fn() { median_grouped([]) })
tries(fn() { median_grouped([1], "2") })
tries(fn() { mode([]) })
tries(fn() { mode([[1], [1]]) })
tries(fn() { multimode(5) })
tries(fn() { quantiles([1, 2], {n: 0}) })
tries(fn() { quantiles([1, 2], {n: 2.5}) })
tries(fn() { quantiles([1, 2], {n: 1e12}) })
tries(fn() { quantiles([1, 2], {method: 5}) })
tries(fn() { quantiles([1, 2], {method: "middle"}) })
tries(fn() { quantiles([]) })
tries(fn() { quantiles([1, 2], 4) })
tries(fn() { variance([1]) })
tries(fn() { pvariance([]) })
tries(fn() { stdev([1, INF]) })
tries(fn() { pstdev([1, 2], "1") })
tries(fn() { variance([0, 1e200]) })
tries(fn() { covariance([1, 2], [1]) })
tries(fn() { covariance([1], [1]) })
tries(fn() { covariance([1e308, 1e308], [1, 2]) })
tries(fn() { covariance([1, 2], [INF, -INF]) })
tries(fn() { covariance([1, 2], "y") })
tries(fn() { correlation([1, 2, 3], [5, 5, 5]) })
tries(fn() { correlation([1, 2], [3, 4], {method: "spearman"}) })
tries(fn() { correlation([1, 2], [3, 4], {method: 1}) })
tries(fn() { correlation([1, 2], [3, 4], 5) })
tries(fn() { correlation([1, 2], [INF, -INF]) })
tries(fn() { correlation([1, 2, 3], [1, 2]) })
tries(fn() { linear_regression([1, 1], [2, 3]) })
tries(fn() { linear_regression([1], [2]) })
tries(fn() { linear_regression([1, 2], [2, 3], "p") })
tries(fn() { linear_regression([1e308, 1e308], [1, 2]) })
tries(fn() { NormalDist(0, -1) })
tries(fn() { NormalDist("0") })
tries(fn() { NormalDist(1, 0).pdf(1) })
tries(fn() { NormalDist(1, 0).cdf(1) })
tries(fn() { NormalDist(1, 0).zscore(1) })
tries(fn() { nd.pdf("x") })
tries(fn() { nd.cdf("x") })
tries(fn() { nd.zscore("x") })
tries(fn() { nd.inv_cdf(0) })
tries(fn() { nd.inv_cdf(1) })
tries(fn() { nd.inv_cdf("x") })
tries(fn() { nd.quantiles(2.5) })
tries(fn() { nd.overlap(5) })
tries(fn() { nd.overlap(NormalDist(1, 0)) })
tries(fn() { nd.samples(2.5) })
tries(fn() { nd.samples(2, 5) })
tries(fn() { nd.samples(2, {seed: [1]}) })
tries(fn() { nd * nd })
tries(fn() { 2 / nd })
tries(fn() { nd + "a" })
tries(fn() { nd / 0 })
tries(fn() { from_samples([1]) })
tries(fn() { kde([], 1) })
tries(fn() { kde([1], 0) })
tries(fn() { kde([1], "h") })
tries(fn() { kde([1], 1, 5) })
tries(fn() { kde([1], 1, "box") })
tries(fn() { kde([1, "a"], 1) })
tries(fn() { kde([1], 1).pdf("x") })
tries(fn() { kde([1], 1).cdf("x") })
tries(fn() { kde_random([], 1) })
tries(fn() { kde_random([1], 1, "normal", 5) })
tries(fn() { kde_random([1], 1, "normal", {seed: [1]}) })
tries(fn() { kde_random([1], 1).samples(1.5) })
