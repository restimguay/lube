// Maps: keys of any type, compared by contents. Map[K, V] checks both types.
var maps = Map[Object,String]          // String values are String objects
print(maps, type(maps))

// objects as keys: the same contents (in any field order) is the same key
let ada = {name: "ada", id: 1}
maps[ada] = String("admin")
maps[{name: "bob", id: 2}] = String("guest")
maps[{id: 1, name: "ada"}] = String("owner")
print(maps, len(maps), maps[ada])
print(maps.has({name: "bob", id: 2}), maps.has({name: "cy"}), get(maps, {name: "zed"}, String("none")))
for user, role in maps { print(user.name, "->", role, role.length) }

// keys are copies: changing the original afterwards does not touch the map
var key = {name: "dee"}
maps[key] = String("new")
key.name = "changed"
print(maps.has({name: "dee"}), maps.has(key))

// an untyped Map takes keys of any type; 5 and int32(5) are the same key
var anything = Map
anything[[1, 2]] = "a list"
anything[5] = "five"
anything[int32(5)] = "still five"
anything[true] = "yes"
anything[1..3] = "a range"
anything[print] = "a function"
anything[int64("9007199254740993")] = "a big integer"
print(len(anything), anything[[1, 2]], anything[5], anything[1..3], anything[print], type(anything))
print(anything[int64("9007199254740993")], anything.has(int64("9007199254740992")))

// typed maps: keys(), values() and copies keep the types
var scores = Map[str, Number]
scores["ada"] = 10
scores.bob = 7
scores["ada"] += 5
print(scores, scores.ada, keys(scores), type(keys(scores)), values(scores), type(values(scores)))
let copy = scores
scores.clear()
print(type(scores), len(scores), type(copy), len(copy))
var counts = Map[str, int32]
for word in "a b a c a b".split() { counts[word] = get(counts, word, 0) + 1 }
print(counts, type(counts["a"]))

// conversions
print(Map({a: 1}), type(Map({a: 1})), Map([[[1], "x"], [{k: 2}, "y"]]), type(Map()), Object(Map([["k", 1]])))
let merged = Map[str, Number] + {extra: 1}
print(merged, type(merged))
print(Map[] , type(Map[]), type(Object[]), Map == Map, {a: 1} == Map({a: 1}))

// what a typed map refuses
fn put(&x, v) { x = v }
let attempts = [
  fn() { var m = Map[Object, str]; m["k"] = "v" },
  fn() { var m = Map[Object, String]; m[{a: 1}] = "a str, not a String" },
  fn() { var m = Map[str, int32]; m.a = 1.5 },
  fn() { var m = Map[str, Number]; m.x = 1; m.x += "s" },
  fn() { var m = Map[Object, str]; return m.name },
  fn() { var m = Map[str, str]; m.k = "v"; put(&m.k, 99) },
  fn() => Map[str, Number] + {a: "x"},
  fn() => Map[Number, Number] + {a: 1},
  fn() { var o = {}; o[[1]] = 2 },
  fn() => Object(Map([[[1], 2]])),
  fn() => Map(5),
  fn() => Map([[1]]),
  fn() => Map[Object, str][{}],
]
for attempt in attempts {
  try { print("no error:", attempt()) } catch e { print(e) }
}
var safe = Map[str, str]
safe.k = "kept"
try { put(&safe.k, 1) } catch e { print("after failed change:", safe) }

// a refused value leaves no key behind
var refused = Map[str, String]
try { refused["a"] = "plain" } catch e { print(e) }
print(refused, len(refused))
var keyed = Map[Object, String]
try { keyed[keyed] = "plain" } catch e { print(e) }
keyed[keyed] = String("y")
print(keyed)

// nan is not a key: it is not equal to itself
let not_a_number = INF - INF
var by_number = Map()
try { by_number[not_a_number] = 1 } catch e { print(e) }
var plain_object = {}
try { plain_object[not_a_number] = 1 } catch e { print(e) }
try { plain_object[not_a_number] += 1 } catch e { print(e) }
by_number[1] = "one"
by_number[-0.0] = "zero"
by_number[0] = "the same zero"
by_number[int32(1)] = "the same one"
by_number[1e300] = "big"
by_number[-7.25] = "a fraction"
print(by_number, plain_object, len(by_number), by_number[1.0], by_number[uint8(0)], get(by_number, 2, "none"))
