// Sound: samples from WAV files or made here (playing them: tests/cli/audio_play.lube)
import audio.*  // the plugin audio
import fs.*

fn tries(f) { try { f() } catch e { print("error:", e) } }

// made from samples: a short beep
var tone = Number[]
for i in 0..4410 { push(&tone, sin(2 * PI * 440 * i / 44100) * 0.5) }
let beep = Sound(tone)
print(beep, beep.duration(), beep.rate(), beep.channels(), len(beep.samples()), beep.samples()[0])
let stereo = Sound(Number[0.5, -0.5, 0.25, -0.25, 1, -1], 22050, 2)
print(stereo, stereo.channels(), stereo.samples())
print(Sound(), Sound().duration(), Sound().samples())
let quiet = Sound()  // silence
print(quiet.duration(), type(quiet), quiet is Sound)

// to a WAV file and back (16-bit: close, not exact)
let wav = beep.to_wav()
print(len(wav), wav.slice(0, 4).decode(), wav.slice(8, 16).decode(), wav.unpack("u16", 22), wav.unpack("u32", 24))
let back = Sound(wav)
print(back, abs(back.samples()[1000] - tone[1000]) < 0.0001)
print(Sound(stereo.to_wav()).samples(), Sound(Sound(Number[2, -2]).to_wav()).samples())  // (clipped to -1..1)
write_bytes("build/beep.wav", wav)
var long = Number[]  // a longer one: 2 seconds (176 KB)
for i in 0..88200 { push(&long, (i % 100) / 100) }
write_bytes("build/long.wav", Sound(long).to_wav())
print(Sound("build/long.wav"), file_size("build/long.wav"))
remove_file("build/long.wav")
print(Sound("build/beep.wav"), Sound("build/beep.wav").samples() == back.samples())
remove_file("build/beep.wav")

// WAV files of every kind it plays, made byte by byte
fn wav_of(format: Number, channels: Number, rate: Number, bits: Number, data: Bytes, before_data = Bytes()) {
    var out = Bytes("RIFF")
    out.pack("u32", 0)  // (the size: readers don't need it)
    push(&out, "WAVEfmt ")
    out.pack("u32", 16)
    out.pack("u16", format)
    out.pack("u16", channels)
    out.pack("u32", rate)
    out.pack("u32", rate * channels * bits / 8)
    out.pack("u16", channels * bits / 8)
    out.pack("u16", bits)
    push(&out, before_data, "data")
    out.pack("u32", len(data))
    push(&out, data)
    return out
}
fn samples_of(b: Bytes) => Sound(b).samples()
print(samples_of(wav_of(1, 1, 8000, 8, Bytes([0, 128, 255]))))  // 8-bit: unsigned
var s16 = Bytes()
s16.pack("i16", -32768)
s16.pack("i16", 16384)
print(samples_of(wav_of(1, 1, 8000, 16, s16)))
var s24 = Bytes([0, 0, 128, 0, 0, 64])  // -1, 0.5
print(samples_of(wav_of(1, 1, 8000, 24, s24)))
var s32 = Bytes()
s32.pack("i32", -1073741824)
print(samples_of(wav_of(1, 1, 8000, 32, s32)))
var f32 = Bytes()
f32.pack("f32", 0.25)
f32.pack("f32", -0.75)
print(samples_of(wav_of(3, 2, 48000, 32, f32)), Sound(wav_of(3, 2, 48000, 32, f32)))
var f64 = Bytes()
f64.pack("f64", 0.125)
print(samples_of(wav_of(3, 1, 8000, 64, f64)))
var odd = Bytes("LIST")  // a chunk it skips, of an odd size (padded to even)
odd.pack("u32", 3)
push(&odd, "abc", 0)
print(samples_of(wav_of(1, 1, 8000, 16, s16, odd)))
var ext = Bytes("RIFF")  // WAVE_FORMAT_EXTENSIBLE: its kind (PCM) comes later in a longer fmt chunk
ext.pack("u32", 0)
push(&ext, "WAVEfmt ")
ext.pack("u32", 40)
for x in [65534, 1] { ext.pack("u16", x) }
for x in [8000, 16000] { ext.pack("u32", x) }
for x in [2, 16, 22, 16] { ext.pack("u16", x) }
ext.pack("u32", 4)  // (which speakers)
ext.pack("u16", 1)  // the kind: PCM
push(&ext, Bytes(14), "data")
ext.pack("u32", len(s16))
push(&ext, s16)
print(samples_of(ext))
var cut = wav_of(1, 1, 8000, 16, s16)
print(samples_of(cut.slice(0, len(cut) - 2)))  // cut short: what there is

// mistakes
tries(fn() { Sound("build/no-such.wav") })
write_bytes("build/not.wav", Bytes("text"))
tries(fn() { Sound("build/not.wav") })
remove_file("build/not.wav")
tries(fn() { Sound(Bytes("not a wav file at all")) })
tries(fn() { Sound(wav_of(2, 1, 8000, 16, Bytes(10))) })  // (ADPCM)
tries(fn() { Sound(wav_of(1, 3, 8000, 16, Bytes(12))) })
tries(fn() { Sound(wav_of(1, 1, 100, 16, Bytes(2))) })
tries(fn() { Sound(wav_of(1, 2, 8000, 12, Bytes(6))) })
tries(fn() { Sound(Bytes("RIFF....WAVE")) })
tries(fn() { Sound(Number[1, 2, 3], 44100, 2) })
tries(fn() { Sound(Number[1], 10) })
tries(fn() { Sound(Number[1], 44100, 3) })
tries(fn() { Sound([1, "a"]) })
tries(fn() { Sound(5) })
tries(fn() { Sound("x.wav", 44100) })
tries(fn() { beep.play(-1) })
tries(fn() { beep.play(1, 2) })
tries(fn() { beep.loop("loud") })
tries(fn() { channel().send(beep) })
