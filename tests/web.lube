fn Deep(n) component {
  return Deep(n + 1)
}
tries(fn() => html(Deep(0)))
fn Bad() component {
  return p(1 / 0 + undefined_thing())
}
tries(fn() => html(Bad()))
fn Nested() component {
  var n = 1
  return div(Shown(), p("{n}"))
}
print(html(Nested()))

// ---- pages: a component's view, live over a WebSocket ----
print("-- pages")
fn between(s, x, y) {
  let at = index_of(s, x)
  if at < 0 { return "" }
  let rest = slice(s, at + len(x), len(s))
  return slice(rest, 0, index_of(rest, y))
}
fn ids(s) {  // the handler ids in a view, in order
  var out = str[]
  for part in slice(split(s, "data-on-"), 1) { out.push(between(part, "=\"", "\"")) }
  return out
}
fn masked(s, ids) {  // the ids hidden (they are random), and a view as HTML again (from JSON)
  var out = s
  for id in ids { out = replace(out, id, "ID") }
  for pair in [["\\u003c", "<"], ["\\u003e", ">"], ["\\u0026", "&"], ["\\\"", "\""]] { out = replace(out, pair[0], pair[1]) }
  return out
}
fn open_page(path, more = "") {  // GET the page: {html, token, cookie, ids}
  let r = ask("GET {path} HTTP/1.1\r\nHost: 127.0.0.1:{port}\r\n{more}Connection: close\r\n\r\n")
  return {status: status(r), html: body(r), token: between(r, "data-page=\"", "\""), cookie: between(r, "lube_session=", ";"),
          ids: ids(body(r)), set_cookie: header(r, "Set-Cookie")}
}
fn upgrade(token, more) => "GET /_lube/ws?page={token} HTTP/1.1\r\nHost: 127.0.0.1:{port}\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n{more}\r\n"
fn connect(pg, more = "") {  // the page's WebSocket: {conn, answer}
  let c = net.tcp_connect("127.0.0.1", port)
  c.send(upgrade(pg.token, "Origin: http://127.0.0.1:{port}\r\nCookie: lube_session={pg.cookie}\r\n" + more))
  return {conn: c, answer: drain(c).decode(), ids: pg.ids}
}
fn frame(op, data: Bytes, fin = true) {  // a frame from a browser: masked (with a key of zeros, so the data stays as it is)
  var first = op
  if fin { first = op + 128 }
  if len(data) < 126 { return Bytes([first, 128 + len(data), 0, 0, 0, 0]) + data }
  let n = len(data)
  if n < 65536 { return Bytes([first, 254, floor(n / 256), n % 256, 0, 0, 0, 0]) + data }
  return Bytes([first, 255, 0, 0, 0, 0, 0, floor(n / 65536), floor(n / 256) % 256, n % 256, 0, 0, 0, 0]) + data
}
fn text(s) => frame(1, Bytes(s))
fn frames(b: Bytes) {  // the frames from the server: "op: text"
  var out = str[]
  var i = 0
  while i + 2 <= len(b) {
    let op = b[i] % 16
    var n = b[i + 1]
    var k = i + 2
    if n == 126 {
      n = b[i + 2] * 256 + b[i + 3]
      k = i + 4
    }
    if op == 8 and n >= 2 { out.push("close {b[k] * 256 + b[k + 1]}") }
    else if op == 8 { out.push("close") }
    else if op == 9 { out.push("ping") }
    else if op == 10 { out.push("pong {b.slice(k, k + n).decode()}") }
    else { out.push(b.slice(k, k + n).decode()) }
    i = k + n
  }
  return out
}
fn talk(ws, data: Bytes) {  // sends, and gives what comes back
  ws.conn.send(data)
  var out = str[]
  for f in frames(drain(ws.conn, false)) { out.push(masked(f, ws.ids)) }
  return out
}
fn event(pg, v, k, arg = "") {
  if arg == "" { return text("\{\"v\":{v},\"h\":\"{pg.ids[k]}\"\}") }
  return text("\{\"v\":{v},\"h\":\"{pg.ids[k]}\",\"a\":{arg}\}")
}

fn Counter(start) component {
  var n = start
  var said = ""
  fn add() { n += 1 }
  fn named(x) { said = x }
  fn fails() { throw "a handler failed" }
  fn submit(fields) { said = "{fields}" }
  on leave { print("a counter leaves at", n) }
  return div(p("count: {n} {said}"), button({onclick: add}, "+1"), field({oninput: named}),
             button({onclick: fails}, "fail"), form({onsubmit: submit}))
}
fn start_of(req) {
  if has(req.query, "start") { return num(req.query.start) }
  return 1
}
let pages = App({dev: true})
pages.page("/", fn(req) => Counter(start_of(req)), {title: "A <counter>", styles: ["/assets/app.css"],
           scripts: ["/assets/more.js"]})
pages.page("/static", fn(req) => div(p("no handlers: no script")))
pages.page("/closure", fn(req) => button({onclick: fn() => print("a closure ran")}, "x"))
pages.page("/fails", fn(req) { throw "the page failed" })
pages.page("/badview", fn(req) => {a: 1})
use(pages)
let pg = open_page("/")
print(pg.status, len(pg.token), len(pg.cookie), len(pg.ids), pages.pages())
print(pg.set_cookie == "lube_session={pg.cookie}; Path=/; HttpOnly; SameSite=Strict")
print(masked(replace(pg.html, pg.token, "TOKEN"), pg.ids))
for k in 0..len(pg.ids) {
  print(len(pg.ids[k]), pg.ids[k] != pg.ids[(k + 1) % len(pg.ids)])
}
let hp = ask("HEAD / HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n")  // HEAD: no one sees the page, so it leaves
print(status(hp), len(body(hp)), pages.pages())
let st = open_page("/static")
print(st.status, st.token == "", st.set_cookie, contains(st.html, "web.js"), pages.pages())
let js = get("/_lube/web.js")
print(status(js), header(js, "Content-Type"), contains(body(js), "WebSocket"))
print(status(get("/_lube/nothing")), status(ask("POST /_lube/web.js HTTP/1.1\r\nHost: localhost\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")))
let again = open_page("/", "Cookie: lube_session={pg.cookie}\r\n")  // the same session: no new cookie
print(again.cookie == "", again.set_cookie, again.token != pg.token, pages.pages())

// its WebSocket, and events
let ws = connect(pg)
print(status(ws.answer), header(ws.answer, "Sec-WebSocket-Accept"), header(ws.answer, "Upgrade"))
print(talk(ws, event(pg, 1, 0)))                           // click: +1, a new view (2)
print(talk(ws, event(pg, 1, 0)))                           // an old version: the view there is, again
print(talk(ws, event(pg, 2, 1, "\"typed <b>\"")))            // input: its value
print(talk(ws, event(pg, 3, 3, "\{\"name\":\"ada\"\}")))       // submit: the form's fields
print(talk(ws, event(pg, 4, 2)))                           // a handler's error: said (dev), and the page goes on
print(talk(ws, frame(9, Bytes("hi"))))                     // ping: pong
print(talk(ws, frame(1, Bytes("\{\"v\":4,"), false) + frame(0, Bytes("\"h\":\"{pg.ids[0]}\"\}"))))  // in two parts
print(talk(ws, frame(10, Bytes(""))))                       // a pong: nothing
print(talk(ws, frame(8, Bytes([3, 232]))), ws.conn.is_open()) // close: closed back
print(pages.pages())
ws.conn.close()

// what a page's WebSocket must have: the page's site, its secret and its session
fn refusal(name, pg, more) {
  let c = net.tcp_connect("127.0.0.1", port)
  c.send(upgrade(pg.token, more))
  print(name + ":", status(drain(c).decode()))
  c.close()
}
let p2 = open_page("/")
let good = "Origin: http://127.0.0.1:{port}\r\nCookie: lube_session={p2.cookie}\r\n"
refusal("no origin", p2, "Cookie: lube_session={p2.cookie}\r\n")
refusal("another site", p2, "Origin: http://evil.example\r\nCookie: lube_session={p2.cookie}\r\n")
refusal("https origin", p2, "Origin: https://127.0.0.1:{port}\r\nCookie: lube_session={p2.cookie}\r\n")
refusal("a site that ends the same", p2, "Origin: http://x127.0.0.1:{port}\r\nCookie: lube_session={p2.cookie}\r\n")
refusal("no cookie", p2, "Origin: http://127.0.0.1:{port}\r\n")
refusal("another session", p2, "Origin: http://127.0.0.1:{port}\r\nCookie: lube_session={pg.cookie}\r\n")
refusal("a cookie not well made", p2, "Origin: http://127.0.0.1:{port}\r\nCookie: lube_session=ZZ{slice(p2.cookie, 2)}\r\n")
refusal("no such page", {token: "0" * 32}, good)
refusal("no page", {token: ""}, good)
refusal("two versions", p2, good + "Sec-WebSocket-Version: 8\r\n")
refusal("two origins", p2, good + "Origin: http://evil.example\r\n")
let c4 = net.tcp_connect("127.0.0.1", port)
c4.send("GET /_lube/ws?page={p2.token} HTTP/1.1\r\nHost: 127.0.0.1:{port}\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Version: 7\r\n{good}\r\n")
let a4 = drain(c4).decode()
print("an old version:", status(a4), header(a4, "Sec-WebSocket-Version"))
c4.close()
for bad in [["no key", "Upgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Version: 13\r\n"],
            ["a bad key", "Upgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Key: short==\r\n"],
            ["a key not base64", "Upgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZ!==\r\n"],
            ["no upgrade", "Connection: Upgrade\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n"],
            ["not to websocket", "Upgrade: h2c\r\nConnection: Upgrade\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n"],
            ["no Connection: upgrade", "Upgrade: websocket\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n"]] {
  let c = net.tcp_connect("127.0.0.1", port)
  c.send("GET /_lube/ws?page={p2.token} HTTP/1.1\r\nHost: 127.0.0.1:{port}\r\n{bad[1]}{good}\r\n")
  print(bad[0] + ":", status(drain(c).decode()))
  c.close()
}
let c5 = net.tcp_connect("127.0.0.1", port)
c5.send("POST /_lube/ws?page={p2.token} HTTP/1.1\r\nHost: 127.0.0.1:{port}\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nContent-Length: 0\r\n{good}\r\n")
print("POST:", status(drain(c5).decode()))
c5.close()
let w2 = connect(p2)
print("its own:", status(w2.answer))
refusal("a second one", p2, good)
w2.conn.close()

// a page's WebSocket breaking the protocol, or the policy: closed, with the reason
fn breaks(name, data: Bytes) {
  let p = open_page("/")
  let w = connect(p)
  print(name + ":", talk(w, data), w.conn.is_open())
  w.conn.close()
}
breaks("not masked", Bytes([129, 2]) + Bytes("hi"))
breaks("an extension", Bytes([129 + 64, 128, 0, 0, 0, 0]))
breaks("binary", frame(2, Bytes("x")))
breaks("an unknown opcode", frame(3, Bytes("x")))
breaks("a long ping", frame(9, Bytes("x" * 126)))
breaks("a ping in parts", frame(9, Bytes("x"), false))
breaks("a part of nothing", frame(0, Bytes("x")))
breaks("a new message inside one", frame(1, Bytes("\{"), false) + frame(1, Bytes("\}")))
breaks("not UTF-8", frame(1, Bytes([255])))
breaks("not JSON", text("hello"))
breaks("JSON, but not an event", text("[1, 2]"))
breaks("an event with more", text("\{\"v\":1,\"h\":\"x\",\"z\":1\}"))
breaks("an event with no version", text("\{\"h\":\"x\"\}"))
breaks("an event with no handler", text("\{\"v\":1\}"))
breaks("an event with a number for its handler", text("\{\"v\":1,\"h\":5\}"))
breaks("a handler that is not there", text("\{\"v\":1,\"h\":\"0123456789abcdef\"\}"))
breaks("trailing junk", text("\{\"v\":1,\"h\":\"x\"\} x"))
breaks("too deep", text("\{\"v\":1,\"h\":\"x\",\"a\":[[[[[1]]]]]\}"))
breaks("too big", frame(1, Bytes("x" * 70000)))
breaks("too big, in parts", frame(1, Bytes("x" * 40000), false) + frame(0, Bytes("x" * 40000)))
breaks("a close with no code", frame(8, Bytes("")))
for bad in ["\"\\x\"", "\"\\u12\"", "\"\\ud800\"", "\"\\udc00\"", "\"\\ud800\\u0041\"", "\"a\u{1}\"", "\"open", "tru", "-",
            "1e999x", "\{\"a\" 1\}", "\{1:1\}", "\{\"a\":1,\}", "[1,]", "[1 2]", "\"\\", "\{\"a\\u0000\":1\}"] {
  breaks("bad JSON " + bad, text("\{\"v\":1,\"h\":\"x\",\"a\":{bad}\}"))
}
let pj = open_page("/")  // JSON that is well made: its handler gets it
let wj = connect(pj)
print(talk(wj, event(pj, 1, 1, "\"\\\"\\\\\\/\\b\\f\\n\\r\\t\\u0041\\u00e9\\u20ac\\ud83d\\ude00\"")))
print(talk(wj, event(pj, 2, 1, "  [ 1 , -2.5e1 , true , false , \{ \} , [ ] , \{\"k\":\"v\"\} ]  ")))
wj.conn.close()

// too many events: the page is cut off
let fast = App({policy: {events_per_second: 1, event_burst: 2}})
fast.page("/", fn(req) => Counter(1))
use(fast)
let pf = open_page("/")
let wf = connect(pf)
print("too fast:", talk(wf, event(pf, 1, 0) + event(pf, 2, 0) + event(pf, 3, 0)))
wf.conn.close()
wait(0.01)

// a page whose WebSocket never comes, and a quiet one: they leave
let brief = App({policy: {page_wait: 0.5, ws_idle: 0.2, max_pages: 2}})
brief.page("/", fn(req) => Counter(7))
use(brief)
open_page("/")
print("pages:", brief.pages())
wait(0.6)
print("pages:", brief.pages())
let pb = open_page("/")
let pc = open_page("/")
print("past max_pages:", open_page("/").status)
let wb = connect(pb)
wait(0.1)
print("a quiet WebSocket is pinged:", "ping" in frames(wb.conn.receive(0.05)))
wait(0.25)
wb.conn.receive(0.05)
print("then dropped:", wb.conn.is_open(), brief.pages())
wb.conn.close()
wait(0.6)

