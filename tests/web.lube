iws.conn.close()
let restart = inner.start(0)  // it can start again
port = restart
show(get("/serve"))
inner.stop()
inner.stop()
print(inner)

// app.serve(): until a handler stops it
fn feed(p) {  // (in an isolate: a client of the app that serve() runs)
  let c = net.tcp_connect("127.0.0.1", p, 5)
  c.send("GET /stop HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n")
  var got = Bytes()
  while c.is_open() { got += c.receive(5) }
  return status(got.decode())
}
let served = App({host: "127.0.0.1"})
served.get("/stop", fn(req) {
  served.stop()
  return "bye"
})
let sp = served.start(0)
let feeder = spawn(feed, sp)
served.serve()
print(feeder.join(), served.port())


// ---- the rest ----
print("-- more")
let more = App()
more.get("/s/:n", fn(req) => {status: num(req.params.n), body: "status {req.params.n}"})
more.get("/style", fn(req) => div({style: "color: red"}))
more.get("/big", fn(req) => "x" * 8000000)
fn Grumpy() component {
  var n = 0
  fn add() { n += 1 }
  on leave { throw "it will not leave quietly" }
  return div(p(10 / (1 - n)), "y" * 70000 * (1 - n), button({onclick: add}, "+"))  // a big view, then none
}
more.page("/grumpy", fn(req) => Grumpy())
use(more)
print(replace(str(more), str(port), "PORT"))
for n in [301, 302, 304, 307, 308, 401, 409, 415, 422, 429, 599] {
  let r = get("/s/{n}")
  print(status(r), header(r, "Content-Length"), trim(body(r)))
}
print(status(get("/style")))
let gp = open_page("/grumpy")
let gw = connect(gp)
gw.conn.send(event(gp, 1, 0))  // the view fails now: said, and the page keeps the view it had
var gf = frames(drain(gw.conn, false))
print(gf)
gw.conn.close()
wait(0.02)
print(more.pages())
let big_page = open_page("/grumpy")  // a view of more than 64 KB, in a frame of its own size
let bw = connect(big_page)
bw.conn.send(text("\{\"v\":0,\"h\":\"x\"\}"))
let bf = drain(bw.conn, false)
print(len(bf) > 70000, bf[1])
bw.conn.close()
wait(0.02)

// a client that does not read what it asked for: dropped, once its answer stops going (and one that has gone)
let reader = App({policy: {header_timeout: 0.1}})
let big = "x" * 64000000  // (more than a system keeps in its buffers: Windows takes 8 MB; made here, not in the
reader.get("/big", fn(req) => big)  // handler, where a slow build would take longer than the test waits)
use(reader)
let lazy = net.tcp_connect("127.0.0.1", port)
lazy.send("GET /big HTTP/1.1\r\nHost: localhost\r\n\r\n")
wait(0.3)
var lazy_got = 0  // (what its buffers kept comes, then the end: Windows keeps several MB)
let lazy_until = now() + 10
while lazy.is_open() and now() < lazy_until { lazy_got += len(lazy.receive(0.01)) }
print("a lazy reader is dropped:", lazy_got < 64000000, lazy.is_open())
lazy.close()
let gone_reader = net.tcp_connect("127.0.0.1", port)
gone_reader.send("GET /big HTTP/1.1\r\nHost: localhost\r\n\r\n")
wait(0.02)
gone_reader.close()
wait(0.05)
print("and one that has gone:", reader.port() > 0)
