// The plugin web: pages over HTTP, and the policy that keeps them safe. Each rule of the policy has a request
// here that breaks it (an attack), and what the server does about it.
import web.*
import net

// A file's own names hide those import web.* brings: this file's get(), header() and b are its own.
var b = "this file's b"
print(b, html(p("web's p")))

// ---- a client, by hand: the server runs in this thread, in app.step() ----
var app = App()
var port = 0
fn use(a) {
  app = a
  port = a.port()
  if port == 0 { port = a.start(0) }
}
fn done(b: Bytes) {  // a whole answer: its head, and as much body as Content-Length says
  let s = b.decode()
  let at = index_of(s, "\r\n\r\n")
  if at < 0 { return false }
  let cl = index_of(s, "Content-Length: ")
  if cl < 0 { return true }
  let rest = slice(s, cl + 16, len(s))
  let n = num(slice(rest, 0, index_of(rest, "\r\n")))
  return len(b) >= at + 4 + n
}
fn drain(c, whole = true) {  // what comes on c: until a whole answer has (or, for frames, until it goes quiet), c closes, or time is up
  var got = Bytes()
  var tries = 0
  var quiet = 0
  while tries < 300 {
    var wait_here = 0.002
    if app.port() > 0 {  // (a handler may have stopped it)
      app.step(0.002)
      wait_here = 0
    }
    let more = c.receive(wait_here)
    got += more
    if not c.is_open() or (whole and done(got)) { break }
    quiet += 1
    if len(more) > 0 or len(got) == 0 { quiet = 0 }
    if not whole and quiet >= 15 { break }
    tries += 1
  }
  return got
}
fn wait(seconds) {
  let until = now() + seconds
  while now() < until { app.step(0.005) }
}
fn ask(raw) {
  let c = net.tcp_connect("127.0.0.1", port)
  c.send(raw)
  let got = drain(c).decode()
  c.close()
  return got
}
fn get(path, more = "") => ask("GET {path} HTTP/1.1\r\nHost: localhost\r\n{more}Connection: close\r\n\r\n")
fn status(r) {
  if len(r) == 0 { return "(closed)" }
  return split(r, "\r\n")[0]
}
fn body(r) => slice(r, index_of(r, "\r\n\r\n") + 4, len(r))
fn header(r, name) {
  for line in split(slice(r, 0, index_of(r, "\r\n\r\n")), "\r\n") {
    if starts_with(lower(line), lower(name) + ": ") { return slice(line, len(name) + 2, len(line)) }
  }
  return "(none)"
}
fn show(r) { print(status(r), "|", trim(body(r))) }

// ---- routes ----
print("-- routes")
let a1 = App()
a1.get("/", fn(req) => "home")
a1.get("/hello/:name", fn(req) => "hello {req.params.name}")
a1.get("/files/*rest", fn(req) => "rest: {req.params.rest}")
a1.get("/slash/", fn(req) => "with a slash")
a1.get("/query", fn(req) => "{req.query} {req.path} {req.method}")
a1.get("/headers", fn(req) => "{req.headers["x-one"]} {req.headers["cookie"]} {req.ip}")
a1.post("/form", fn(req) => "{req.form} {req.text} {len(req.body)}")
a1.post("/bytes", fn(req) => req.body)
a1.put("/thing/:id", fn(req) => {status: 201, body: "made {req.params.id}", headers: {"X-Made": "yes"}})
a1.patch("/thing/:id", fn(req) => {body: div(p("patched"))})
a1.delete("/thing/:id", fn(req) => print("deleted", req.params.id))  // nothing: 204
a1.get("/json", fn(req) => {type: "application/json", body: "[1,2]"})
a1.get("/view", fn(req) => div({class: "x"}, h1("A <view>")))
a1.get("/status", fn(req) => {status: 418})
use(a1)
show(get("/"))
show(get("/hello/ada%20lovelace"))
show(get("/hello/a%2Fb"))       // %2F stays inside its part
show(get("/hello"))             // no :name: no route
show(get("/hello/"))
show(get("/files/a/b/c.txt"))
show(get("/files/"))
show(get("/slash/"))
show(get("/slash"))
show(get("/query?a=1&b=two+words&c=%26&flag"))
show(get("/headers", "X-One: first\r\nX-One: second\r\nCookie: a=1\r\nCookie: b=2\r\n"))
show(ask("POST /form HTTP/1.1\r\nHost: localhost\r\nContent-Type: application/x-www-form-urlencoded\r\nContent-Length: 17\r\nConnection: close\r\n\r\nname=ada&n=1+2%21"))
let bytes = ask("POST /bytes HTTP/1.1\r\nHost: localhost\r\nContent-Length: 3\r\nConnection: close\r\n\r\nabc")
print(status(bytes), header(bytes, "Content-Type"), body(bytes))
let made = ask("PUT /thing/7 HTTP/1.1\r\nHost: localhost\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
print(status(made), header(made, "X-Made"), body(made))
show(ask("PATCH /thing/7 HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n"))
let gone = ask("DELETE /thing/7 HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n")
print(status(gone), header(gone, "Content-Length"), header(gone, "Content-Type"))
let js = get("/json")
print(status(js), header(js, "Content-Type"), body(js))
let view = get("/view")
print(status(view), header(view, "Content-Type"), body(view))
show(get("/status"))
let nope = ask("POST /hello/x HTTP/1.1\r\nHost: localhost\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
print(status(nope), header(nope, "Allow"))
let opts = ask("OPTIONS /thing/1 HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n")
print(status(opts), header(opts, "Allow"))
show(get("/nowhere"))
let head = ask("HEAD /hello/x HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n")
print(status(head), header(head, "Content-Length"), len(body(head)))
show(ask("GET /hello/old HTTP/1.0\r\n\r\n"))  // HTTP/1.0 needs no Host

// one connection, several requests (keep-alive), and requests sent together (pipelined)
let kc = net.tcp_connect("127.0.0.1", port)
kc.send("GET /hello/one HTTP/1.1\r\nHost: localhost\r\n\r\n")
let k1 = drain(kc).decode()
kc.send("GET /hello/two HTTP/1.1\r\nHost: localhost\r\n\r\nGET /hello/three HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n")
let k2 = drain(kc, false).decode()
print(status(k1), header(k1, "Connection"), len(split(k2, "HTTP/1.1 200")) - 1, contains(k2, "hello two"), contains(k2, "hello three"), kc.is_open())
kc.close()
let k10 = net.tcp_connect("127.0.0.1", port)
k10.send("GET /hello/a HTTP/1.0\r\nConnection: keep-alive\r\n\r\n")
let k10r = drain(k10).decode()
print(status(k10r), header(k10r, "Connection"), k10.is_open())
k10.close()

// ---- the names it answers to: addresses, localhost, and policy hosts (not a name made to lead here: DNS rebinding) ----
print("-- hosts")
for host in ["localhost", "LocalHost:8080", "127.0.0.1", "127.0.0.1:80", "10.1.2.3:8080", "[::1]:8080", "[::1]",
             "evil.example", "evil.example:8080", "localhost.evil.example", "1.2.3", "[::1", "[::1]x"] {
  print(host + ":", status(ask("GET /hello/x HTTP/1.1\r\nHost: {host}\r\nConnection: close\r\n\r\n")))
}
let named = App({policy: {hosts: ["Example.com"]}})
named.get("/", fn(req) => "ok")
use(named)
print("a name of policy hosts:", status(ask("GET / HTTP/1.1\r\nHost: example.COM\r\nConnection: close\r\n\r\n")),
      status(ask("GET / HTTP/1.1\r\nHost: www.example.com\r\nConnection: close\r\n\r\n")))
let anyhost = App({policy: {hosts: ["*"]}})
anyhost.get("/", fn(req) => "ok")
use(anyhost)
print("any:", status(ask("GET / HTTP/1.1\r\nHost: whatever.example\r\nConnection: close\r\n\r\n")))
use(a1)

// ---- what changes things comes from this site's pages, not another site's (cross-site request forgery) ----
print("-- forgery")
fn post_from(more) => status(ask("POST /form HTTP/1.1\r\nHost: localhost:{port}\r\n{more}Content-Length: 0\r\nConnection: close\r\n\r\n"))
print("no Origin (not a browser):", post_from(""))
print("this site:", post_from("Origin: http://localhost:{port}\r\n"))
print("another site:", post_from("Origin: http://evil.example\r\n"))
print("an opaque origin:", post_from("Origin: null\r\n"))
print("cross-site, no Origin:", post_from("Sec-Fetch-Site: cross-site\r\n"))
print("same-site:", post_from("Sec-Fetch-Site: same-origin\r\n"))
print("GET from another site:", status(ask("GET /hello/x HTTP/1.1\r\nHost: localhost\r\nOrigin: http://evil.example\r\nConnection: close\r\n\r\n")))
let trusting = App({policy: {origins: ["https://app.example"]}})
trusting.post("/", fn(req) => "ok")
use(trusting)
print("a site the policy names:", status(ask("POST / HTTP/1.1\r\nHost: localhost\r\nOrigin: https://app.example\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")))
use(a1)

// ---- every answer carries the policy's headers ----
print("-- headers")
let h = get("/")
for name in ["Content-Security-Policy", "X-Content-Type-Options", "Referrer-Policy", "Cross-Origin-Opener-Policy",
             "Cross-Origin-Resource-Policy", "X-Frame-Options", "Cache-Control", "Server"] {
  print(name + ":", header(h, name))
}
print(header(get("/nowhere"), "X-Frame-Options"))

// ---- reading requests strictly: what a lenient server (or a proxy in front of it) might read differently ----
print("-- strict")
fn refused(name, request) { print(name + ":", status(ask(request))) }
refused("bare LF", "GET / HTTP/1.1\nHost: x\n\n")
refused("CR alone", "GET / HTTP/1.1\r\nHost: x\rX: y\r\n\r\n")
refused("folded header", "GET / HTTP/1.1\r\nHost: localhost\r\nX-A: one\r\n two\r\n\r\n")
refused("space before colon", "GET / HTTP/1.1\r\nHost: localhost\r\nContent-Length : 5\r\n\r\nhello")
refused("no colon", "GET / HTTP/1.1\r\nHost: localhost\r\nJunk\r\n\r\n")
refused("empty name", "GET / HTTP/1.1\r\nHost: localhost\r\n: y\r\n\r\n")
refused("two lengths", "POST /form HTTP/1.1\r\nHost: localhost\r\nContent-Length: 3\r\nContent-Length: 3\r\n\r\nabc")
refused("length and chunked", "POST /form HTTP/1.1\r\nHost: localhost\r\nContent-Length: 3\r\nTransfer-Encoding: chunked\r\n\r\nabc")
refused("chunked", "POST /form HTTP/1.1\r\nHost: localhost\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nabc\r\n0\r\n\r\n")
refused("signed length", "POST /form HTTP/1.1\r\nHost: localhost\r\nContent-Length: +3\r\n\r\nabc")
refused("length with a space", "POST /form HTTP/1.1\r\nHost: localhost\r\nContent-Length: 1 2\r\n\r\nabc")
refused("empty length", "POST /form HTTP/1.1\r\nHost: localhost\r\nContent-Length: \r\n\r\n")
refused("huge length", "POST /form HTTP/1.1\r\nHost: localhost\r\nContent-Length: 99999999999999999999999\r\n\r\n")
refused("body too big", "POST /form HTTP/1.1\r\nHost: localhost\r\nContent-Length: 1048577\r\n\r\n")
refused("no host", "GET / HTTP/1.1\r\n\r\n")
refused("two hosts", "GET / HTTP/1.1\r\nHost: localhost\r\nHost: y\r\n\r\n")
refused("odd host", "GET / HTTP/1.1\r\nHost: localhost/y\r\n\r\n")
refused("NUL", "GET / HTTP/1.1\r\nHost: localhost\r\nX: a\u{0}b\r\n\r\n")
refused("control character", "GET / HTTP/1.1\r\nHost: localhost\r\nX: a\u{1}b\r\n\r\n")
refused("absolute URL", "GET http://x/ HTTP/1.1\r\nHost: localhost\r\n\r\n")
refused("asterisk", "OPTIONS * HTTP/1.1\r\nHost: localhost\r\n\r\n")
refused("HTTP/2.0", "GET / HTTP/2.0\r\nHost: localhost\r\n\r\n")
refused("HTTP/1.1x", "GET / HTTP/1.1x\r\nHost: localhost\r\n\r\n")
refused("not HTTP", "GET / FTP/1.1\r\nHost: localhost\r\n\r\n")
refused("no version", "GET /\r\nHost: localhost\r\n\r\n")
refused("no target", "GET\r\nHost: localhost\r\n\r\n")
refused("odd method", "G(T / HTTP/1.1\r\nHost: localhost\r\n\r\n")
refused("empty method", " / HTTP/1.1\r\nHost: localhost\r\n\r\n")
refused("unknown method", "BREW / HTTP/1.1\r\nHost: localhost\r\n\r\n")
refused("dot dot", "GET /hello/../secret HTTP/1.1\r\nHost: localhost\r\n\r\n")
refused("dot", "GET /./hello/x HTTP/1.1\r\nHost: localhost\r\n\r\n")
refused("escaped dot dot", "GET /hello/%2e%2E/secret HTTP/1.1\r\nHost: localhost\r\n\r\n")
refused("backslash", "GET /hello\\x HTTP/1.1\r\nHost: localhost\r\n\r\n")
refused("escaped NUL", "GET /hello/a%00b HTTP/1.1\r\nHost: localhost\r\n\r\n")
refused("bad escape", "GET /hello/a%zz HTTP/1.1\r\nHost: localhost\r\n\r\n")
refused("short escape", "GET /hello/a%2 HTTP/1.1\r\nHost: localhost\r\n\r\n")
refused("not UTF-8", "GET /hello/a%ff HTTP/1.1\r\nHost: localhost\r\n\r\n")
refused("overlong UTF-8", "GET /hello/%c0%af HTTP/1.1\r\nHost: localhost\r\n\r\n")
refused("bad query", "GET /query?a=%zz HTTP/1.1\r\nHost: localhost\r\n\r\n")
refused("fragment", "GET /hello/x#y HTTP/1.1\r\nHost: localhost\r\n\r\n")
refused("odd expect", "POST /form HTTP/1.1\r\nHost: localhost\r\nExpect: tea\r\nContent-Length: 1\r\n\r\nx")
refused("URL too long", "GET /" + "a" * 8200 + " HTTP/1.1\r\nHost: localhost\r\n\r\n")
refused("head too big", "GET / HTTP/1.1\r\nHost: localhost\r\nX: " + "a" * 17000 + "\r\n\r\n")
refused("head too big, unfinished", "GET / HTTP/1.1\r\nHost: localhost\r\nX: " + "a" * 17000)
var many = ""
for i in 0..101 { many += "X-{i}: y\r\n" }
refused("too many headers", "GET / HTTP/1.1\r\nHost: localhost\r\n{many}\r\n")
print("UTF-8 path:", trim(body(get("/hello/%E2%9D%A4"))))
let cont = net.tcp_connect("127.0.0.1", port)  // Expect: 100-continue: the server says go on, then answers
cont.send("POST /form HTTP/1.1\r\nHost: localhost\r\nExpect: 100-continue\r\nContent-Length: 3\r\nConnection: close\r\n\r\n")
let go_on = drain(cont, false).decode()
cont.send("a=b")
print(trim(go_on), "|", status(drain(cont).decode()))
cont.close()

// ---- time limits: a client too slow to send its request cannot hold a connection (slowloris) ----
print("-- time")
let quick = App({policy: {header_timeout: 0.05, body_timeout: 0.05, keep_alive: 0.5}})
quick.get("/", fn(req) => "ok")
use(quick)
let slow = net.tcp_connect("127.0.0.1", port)
slow.send("GET / HTTP/1.1\r\nHost: localhost\r\n")  // ... and nothing more
wait(0.1)
print("slow head:", status(drain(slow).decode()), slow.is_open())
slow.close()
let silent = net.tcp_connect("127.0.0.1", port)  // says nothing at all
wait(0.1)
print("silent:", status(drain(silent).decode()))
silent.close()
let slow_body = net.tcp_connect("127.0.0.1", port)
slow_body.send("POST / HTTP/1.1\r\nHost: localhost\r\nContent-Length: 10\r\n\r\nabc")
wait(0.1)
print("slow body:", status(drain(slow_body).decode()))
slow_body.close()
let idle = net.tcp_connect("127.0.0.1", port)
idle.send("GET / HTTP/1.1\r\nHost: localhost\r\n\r\n")
print("idle:", status(drain(idle).decode()), idle.is_open())
wait(0.6)
print("after a quiet while:", len(drain(idle)), idle.is_open())  // closed, with no answer
idle.close()
let trickle = net.tcp_connect("127.0.0.1", port)  // more bytes do not buy more time
for i in 0..6 {
  trickle.send("X")
  wait(0.02)
}
print("trickle:", status(drain(trickle).decode()))
trickle.close()
let lingers = net.tcp_connect("127.0.0.1", port)  // after a last answer, what still comes is dropped; closed in a second
lingers.send("GET / HTTP/1.1\r\nHost: localhost\r\nContent-Length: x\r\n\r\n")
print("a last answer:", status(drain(lingers).decode()), lingers.is_open())
lingers.send("GET / HTTP/1.1\r\nHost: localhost\r\n\r\n")
wait(1.2)
print("then:", len(drain(lingers)), lingers.is_open())
lingers.close()

// ---- how many connections ----
print("-- connections")
let few = App({policy: {max_per_ip: 2}})
few.get("/", fn(req) => "ok")
use(few)
let c1 = net.tcp_connect("127.0.0.1", port)
let c2 = net.tcp_connect("127.0.0.1", port)
let c3 = net.tcp_connect("127.0.0.1", port)
wait(0.02)
c3.receive(0.05)
print("a third from one address:", c1.is_open(), c2.is_open(), c3.is_open())
c1.send("GET / HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n")
print(status(drain(c1).decode()))
for c in [c1, c2, c3] { c.close() }
let fewer = App({policy: {max_connections: 1}})
fewer.get("/", fn(req) => "ok")
use(fewer)
let d1 = net.tcp_connect("127.0.0.1", port)
let d2 = net.tcp_connect("127.0.0.1", port)
wait(0.02)
d2.receive(0.05)
print("past max_connections:", d1.is_open(), d2.is_open())
d1.close()
d2.close()

// ---- what a handler may answer: not the policy's headers, nor a header that breaks a line ----
print("-- answers")
let ans = App()
ans.get("/csp", fn(req) => {body: "x", headers: {"Content-Security-Policy": "default-src *"}})
ans.get("/frames", fn(req) => {body: "x", headers: {"x-frame-options": "ALLOWALL"}})
ans.get("/length", fn(req) => {body: "x", headers: {"Content-Length": "100"}})
ans.get("/split", fn(req) => {body: "x", headers: {"X-A": "1\r\nSet-Cookie: evil=1"}})
ans.get("/name", fn(req) => {body: "x", headers: {"X A": "1"}})
ans.get("/value", fn(req) => {body: "x", headers: {"X-A": 1}})
ans.get("/headers", fn(req) => {body: "x", headers: [1]})
ans.get("/type", fn(req) => {body: "x", headers: {"Content-Type": "text/html"}})
ans.get("/badtype", fn(req) => {body: "x", type: "text/html\r\nX: y"})
ans.get("/status", fn(req) => {status: 99})
ans.get("/extra", fn(req) => {body: "x", color: "red"})
ans.get("/component", fn(req) => {body: Shown()})
ans.get("/throws", fn(req) { throw "the database is down: password=hunter2" })
ans.get("/bad", fn(req) => [{a: 1}])
ans.get("/handler", fn(req) => button({onclick: fn() => 1}, "x"))
ans.get("/cookie", fn(req) => {body: "x", headers: {"Set-Cookie": "theme=dark; Path=/"}})
ans.get("/redirect", fn(req) => {status: 303, headers: {Location: "/elsewhere"}})
fn Shown() component {
  return p("shown")
}
use(ans)
for path in ["/csp", "/frames", "/length", "/split", "/name", "/value", "/headers", "/type", "/badtype", "/status",
             "/extra", "/component", "/throws", "/bad", "/handler"] {
  let r = get(path)
  print(path, status(r), trim(body(r)))
}
print(header(get("/cookie"), "Set-Cookie"), header(get("/redirect"), "Location"))
let devved = App({dev: true})  // dev: the error, in the answer too
devved.get("/throws", fn(req) { throw "the database is down" })
use(devved)
show(get("/throws"))

// ---- static files: the folder's files, and nothing else ----
print("-- static")
let files = App()
files.static("/assets/", "tests/web/public")
files.get("/assets/made", fn(req) => "a route after it")
use(files)
let f1 = get("/assets/hello.txt")
print(status(f1), header(f1, "Content-Type"), header(f1, "Content-Length"), header(f1, "Cache-Control"), trim(body(f1)))
print(header(get("/assets/app.css"), "Content-Type"), header(get("/assets/sub/deep.txt"), "Content-Length"))
let empty = get("/assets/empty.bin")
print(status(empty), header(empty, "Content-Type"), header(empty, "Content-Length"))
let fh = ask("HEAD /assets/hello.txt HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n")
print(status(fh), header(fh, "Content-Length"), len(body(fh)))
for path in ["/assets/nope.txt", "/assets/sub", "/assets/sub/", "/assets/.env", "/assets/.hidden/x.txt",
             "/assets/../outside.txt", "/assets/%2e%2e/outside.txt", "/assets/sub%2F..%2F..%2Foutside.txt",
             "/assets/..%5Coutside.txt", "/assets/C:%5Cwindows", "/assets", "/assets/", "/assets/made"] {
  print(path, status(get(path)))
}
show(ask("POST /assets/hello.txt HTTP/1.1\r\nHost: localhost\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"))
let big_files = App()  // a file bigger than one piece goes out in pieces
big_files.static("/", "tests/web")
use(big_files)
write_file("tests/web/big.bin", "x" * 300000)
let bc = net.tcp_connect("127.0.0.1", port)
bc.send("GET /big.bin HTTP/1.1\r\nHost: localhost\r\n\r\nGET /outside.txt HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n")
let both = drain(bc, false).decode()
print(status(both), header(both, "Content-Length"), len(both) > 300000, contains(both, "outside\n"))
bc.close()
let fall = App()
fall.static("/assets/", "tests/web/public")
fall.get("/assets/made", fn(req) => "a route after it")
use(fall)
show(get("/assets/made"))

// ---- views as HTML: escaped, and only what the helpers make ----
print("-- html")
print(html(div({class: "a\"b<", id: 5, hidden: true, title: false}, "x < y & \"z\" 'w'", 3, [p("one"), [span("two")]])))
print(html(raw("<b>as it is</b>")), html("text"), html([1, 2]), div("x"), raw("y"))
print(html(ul(li("a"), li("b"))), html(br()), html(field({type: "checkbox", checked: true})))
print(html(el("svg", {viewBox: "0 0 1 1"}, el("circle", {r: 1}))), html(el("My-Tag", "x")))
