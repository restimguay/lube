// on: blocks that run when a global var changes, right after the change.

var score = 0
var lives = 3
var items = str[]
var player = {name: "ada", hp: 10}

fn redraw() { print("redraw: score", score, "lives", lives) }

on score (old, new) {
  if new > old { print("+", new - old) }
}
on score {
  print("score changed to", score)
}
on score, lives {        // any of these changed
  redraw()
}
on score (old, new) when new < old {
  print("score went down by", old - new)
}
on items (old, new) { print("items:", len(old), "->", len(new)) }
on player (old, new) { print("player hp", old.hp, "->", new.hp) }

score += 10
score = 10              // the same value: nothing runs
lives -= 1
score = 4

// changes inside a value, and changes through &, count too
items.push("sword")
push(&items, "shield")
items[0] = "axe"
player.hp -= 3
player["name"] = "bob"
fn heal(&p) { p.hp += 1 }
heal(&player)
fn add(&s, n) { s += n }
add(&score, 5)
score.add(0)            // no change
fn fails(&s) {
  s += 1
  throw "failed after changing it"
}
try { fails(&score) } catch e { print("caught:", e, "score is", score) }

// a block's own changes do not run it again
var count = 0
on count (old, new) {
  print("count", old, "->", new)
  if new < 3 { count = new + 1 }
}
count = 1
print("count is", count)

// blocks can change other watched vars
var a = 0
var b = 0
on a (old, new) { b = new * 2 }
on b (old, new) { print("b is now", new) }
a = 5

// an error in a block reaches the code that made the change
var guarded = 0
on guarded (old, new) when new < 0 { throw "guarded cannot be negative" }
guarded = 5
try { guarded = -1 } catch e { print("caught:", e) }
print("guarded is", guarded)

// typed parameters, and a block that names its parameters freely
var temperature = 20
on temperature (before: Number, after: Number) when after - before > 5 { print("heating up fast:", before, "->", after) }
temperature = 22
temperature = 30

// locals with the same name are not watched
fn shadow() {
  var score = 1
  score = 2
  return score
}
print(shadow(), score)

// ---- on inside functions, methods and blocks ----
// The block runs on the function's frame: it sees and changes the function's
// variables, and lasts until the code around it ends.
fn game() {
  var points = 0
  var log = []
  on points (old, new) { log.push("{old}->{new}") }
  on points (old, new) when new > old { print("+", new - old) }
  points += 10
  points = 10            // the same value: nothing runs
  points = 4
  print(log)
}
game()

// in a method, watching a field of this
class Fighter {
  var hp = 10
  var name = "ada"
  fn fight() {
    on this.hp (old, new) when new <= 0 { print(this.name, "is down") }
    on this.hp (old, new) { print("hp", old, "->", new) }
    this.hp -= 3
    this.name = "bob"    // another field: hp did not change
    this.hp -= 8
  }
}
var fighter = Fighter()
fighter.fight()
print("fighter hp", fighter.hp)

// in a constructor
class Counter {
  var n = 0
  var history = Number[]
  constructor() {
    on this.n (old, new) { this.history.push(new) }
    this.n = 1
    this.n = 2
  }
}
print("history", Counter().history)

// blocks can change the function's other watched variables
fn chain() {
  var x = 0
  var y = 0
  on x (old, new) { y = new * 2 }
  on y (old, new) { print("y is", new) }
  x = 5
  print(x, y)
}
chain()

// changes through & and methods count
fn lend() {
  var items = []
  on items (old, new) { print("items", len(old), "->", len(new)) }
  items.push(1)
  push(&items, 2)
  fn add(&xs) { xs.push(3) }
  add(&items)
  print("length", items.len())   // no change
}
lend()

// a block in a function can watch a global while the function runs
var tally = 0
fn watch_tally() {
  var seen = 0
  on tally { seen += 1 }
  tally += 1
  bump()                 // changed in another function
  print("seen", seen)
}
fn bump() { tally += 5 }
watch_tally()
tally += 1               // the function returned: its block is gone
print("tally", tally)

// a block lasts until the block of code around it ends
fn scoped() {
  var v = 0
  if true {
    on v { print("v is", v) }
    v = 1
  }
  v = 2                  // out of scope: nothing runs
  for i in 0..3 {
    on v (old, new) { print("loop", i, old, new) }
    v += 1
  }
  v = 100
}
scoped()

// closures in a block, the function's captures, and return
fn labelled() {
  var n = 0
  var label = "count"
  on n (old, new) {
    let show = fn() => "{label}: {new}"
    print(show())
    return
  }
  n = 1
}
labelled()
fn outer() {
  let unit = "pts"
  return fn() {
    var s = 0
    on s (o, w) { print(w, unit) }
    s = 7
  }
}
outer()()

// a block's own changes do not run it again
fn own() {
  var c = 0
  on c (old, new) {
    print("c", old, "->", new)
    if new < 3 { c = new + 1 }
  }
  c = 1
  print("c is", c)
}
own()

// each call has its own blocks
fn depth(k) {
  var w = 0
  on w (old, new) { print("depth", k, "w", new) }
  if k < 2 { depth(k + 1) }
  w = k
}
depth(0)

// typed (old, new)
fn typed() {
  var t = 1
  on t (a: Number, b: Number) { print("typed", a, b) }
  t = 2
}
typed()

// a field of a global, at the top level
var hero = {name: "ada", hp: 10}
on hero.hp (old, new) { print("hero hp", old, "->", new) }
hero.name = "bob"
hero.hp -= 1

// a block inside a block lasts while the outer one runs
fn nested() {
  var p = 0
  var q = 0
  on p {
    on q { print("q changed in p's block") }
    q = 1
  }
  p = 1
  q = 2
}
nested()

// in a block of code at the top level
{
  var z = 0
  on z (o, n) { print("z", o, n) }
  z = 9
}

// an error in the block reaches the change
fn guarded_local() {
  var g = 0
  on g (old, new) when new < 0 { throw "g cannot be negative" }
  try { g = -1 } catch e { print("caught:", e) }
  print("g is", g)
}
guarded_local()
