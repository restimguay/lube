let long_name = "x" * 1100
fn catch_long() {
  try {
    var o = {}
    o[long_name] += 1
  } catch e {
    return e
  }
  return ""
}
show(fn() => len(str(catch_long())))
show(fn() => slice(str(catch_long()), 0, 30))
show(fn() => Bytes([1, 2, 300]))
show(fn() => fixed(1.5, -1))
show(fn() => "%d and 100%")

// ---------- for x in a List, and strs written out as operands ----------
fn loops() {
  let words = ["w1", "w2", "w1", "", "w10"]
  var out = []
  var hits = 0
  for w in words {
    if w == "w1" { hits += 1 }
    if "w1" != w { out.push(w + "!") }
    if w < "w2" { out.push("<" + w) }
  }
  for i, w in words {
    if w == "w2" { out.push(i) }
  }
  var grown = [1, 2]
  for x in grown {
    grown.push(x * 10)
    out.push(x)
  }
  for x in [] { out.push("never") }
  let o = {key: 1, "two words": 2}
  out.push(o["key"] + o["two words"])
  out.push("ab" + "cd" == "abcd")
  out.push(words[0] + "x")
  var nested = []
  for a in [[1, 2], [3]] {
    for b in a { nested.push(b) }
  }
  for w in words {
    if w == "w2" { break }
    if w == "" { continue }
    nested.push(w)
  }
  return [hits, out, grown, nested]
}
print(loops())
show(fn() => "a" < 1)
show(fn() {
  for x in [1, 2] { let y = x + "s" }
  return 0
})
