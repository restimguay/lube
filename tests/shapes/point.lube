package shapes
// A package is a folder: every file in tests/shapes/ starts with `package shapes`.

class Point {
  var x = 0
  var y = 0
  constructor(x: Number = 0, y: Number = 0) {
    this.x = x
    this.y = y
  }
}

var count = 0
let _secret = "only inside shapes"

fn origin(): Point => Point()
fn bump() { count += 1 }
fn tell(): str => _secret
