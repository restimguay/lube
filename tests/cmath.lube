// cmath: Python's cmath module, and Complex (checked against Python 3.15). Where the C library's last
// bit differs from system to system, a result is rounded to 9 places: r(x), rc(z)
import cmath
import cmath.*

fn tries(f) { try { f() } catch e { print("error:", e) } }
fn r(x) => round(x, 9)
fn rc(z) => Complex(round(z.real, 9), round(z.imag, 9))

// constants
print(pi, e, tau, inf, nan, cmath.pi, infj(), nanj(), cmath.e == e)

// making one, and how it prints
print(Complex(3, 4), Complex(2), Complex(), Complex(0, 2), Complex(0, -2), Complex(-0.0, -1), Complex(0, -0.0), Complex(-0.0, 0))
print(Complex(1, -0.0), Complex(1.5, 2.25), Complex(1e20, -1e-20), Complex(inf, -inf), Complex(nan, 1), Complex(1, -nan), Complex(0, inf))
print(Complex(Complex(1, 2)), Complex(-3), Complex(1e16, 1e15), Complex(0.1, 0.2), cmath.Complex(5, 6))
print(Complex("1+2j"), Complex(" ( 1-2.5e3J ) "), Complex("j"), Complex("-j"), Complex("+J"), Complex("1+j"), Complex("2-j"))
print(Complex("inf+nanj"), Complex("-Infinity-INFj"), Complex("NaN"), Complex("1_0+2_0j"), Complex("3"), Complex("1e5j"), Complex(".5-5.j"))
print(Complex("1e+2+3e-1j"), Complex("(4)"), Complex("0j"), Complex("-0-0j"), Complex(" 7 "), Complex("1_000_000.000_1j"))

// parts
let z = Complex(3, 4)
let w = Complex(1, -2)
print(z.real, z.imag, z.conjugate(), w.conjugate(), Complex(5).imag, abs(z), abs(Complex(0, -2)), abs(Complex(-inf, nan)), abs(Complex(nan, inf)))
print(abs(Complex(nan, 1)), r(abs(Complex(1, 1))), abs(Complex(1e308, 1e308)) > 1e308, abs(-5), abs(5), abs(-0.0), abs(-inf), abs(nan), abs(-2.5))

// arithmetic: a Number with a Complex is a real number
print(z + w, z - w, z * w, z / w, -z, -Complex(0, 0), z + 1, 1 + z, z - 1, 1 - z, 2 * z, z * 2, z / 2, 2 / z)
print(z == Complex(3, 4), z == w, z != w, Complex(3) == 3, 3 == Complex(3), Complex(3, 1) == 3, z != 3, z == "z", z != [z])
print(Complex(inf, 1) * 2, 2 * Complex(inf, nan), Complex(inf, 0) + Complex(-inf, 0), 0.5 - Complex(0, inf), Complex(1, 2) / 0.5)
print(Complex(inf, 0) * Complex(0, 1), Complex(0, 1) * Complex(inf, 0), Complex(1e300, nan) * Complex(1e300, 1e300), Complex(nan, 0) * Complex(1, 0))
print(Complex(inf, nan) * Complex(1, nan), Complex(nan, 1) * Complex(0, inf), Complex(1e200, 1e200) * Complex(1e200, -1e200))
print(Complex(1, 1) / Complex(2, 0), Complex(1, 1) / Complex(0, 2), Complex(1, 1) / Complex(nan, 1), Complex(inf, nan) / Complex(1, 0))
print(Complex(1, 1) / Complex(inf, inf), Complex(2, 3) / Complex(4, -5), Complex(1e300, 1e300) / Complex(1e-300, 1e-300), Complex(inf, inf) / Complex(nan, nan))
print(1 / Complex(0, 2), 1 / Complex(4, 3), 1 / Complex(nan, 1), 1 / Complex(inf, inf), 0 / Complex(1, 1), 3 / Complex(-1, 1e-300))
print(z ** 2, z ** 0, z ** 1, z ** -1, z ** -2, w ** 3, Complex(0, 1) ** 2, Complex(0, 1) ** 100, isclose(Complex(2, 0) ** 0.5, sqrt(2)))
print(rc(z ** 0.5), rc(z ** Complex(1, 1)), rc(2 ** Complex(0, 1)), rc(Complex(-8) ** (1 / 3)), Complex(0) ** 0.5, Complex(0) ** 2, Complex(0) ** 0)
print(Complex(nan, 0) ** 2, rc(Complex(1, 1) ** 101), rc(Complex(1, 1) ** -101), 2 ** Complex(2, 0), Complex(1, -0.0) ** 3, Complex(-1, 0) ** 2, Complex(0, 1) ** -3)

// functions: of a Number or a Complex, they give a Complex
print(sqrt(-1), sqrt(4), sqrt(Complex(0, 2)), sqrt(Complex(-4, -0.0)), sqrt(Complex(0, -0.0)), rc(sqrt(z)), rc(sqrt(w)), rc(sqrt(Complex(-3, 4))))
print(sqrt(Complex(inf, 1)), sqrt(Complex(-inf, 1)), sqrt(Complex(1, inf)), sqrt(Complex(nan, inf)), sqrt(Complex(nan, 1)), sqrt(Complex(-inf, nan)))
print(rc(sqrt(Complex(1e308, 1e308)) / 1e154), sqrt(Complex(5e-324, 0)), sqrt(Complex(1e-310, 1e-310)).real > 0, rc(sqrt(Complex(-1e-320, 3e-320)) * 1e160))
print(rc(exp(Complex(0, pi))), rc(exp(1)), rc(exp(z)), exp(Complex(-inf, 1)), exp(Complex(inf, 1)), exp(Complex(inf, -2)), exp(Complex(-inf, 0)))
print(exp(Complex(nan, 0)), exp(Complex(inf, nan)), exp(Complex(-inf, inf)), rc(exp(Complex(709.5, 0.5)) / 1e308), exp(Complex(0, -0.0)))
print(rc(log(-1)), rc(log(z)), rc(log(Complex(0, 1))), log(1), rc(log(Complex(0.8, 0.6))), rc(log(Complex(1e308, 1e308))), rc(log(Complex(5e-324, 5e-324))))
print(log(Complex(inf, 1)), log(Complex(-inf, 1)), log(Complex(1, -inf)), log(Complex(nan, inf)), log(Complex(nan, 1)), log(Complex(-inf, -inf)))
print(rc(log(8, 2)), rc(log(z, w)), rc(log(-1, 10)), log(0, 2), rc(log10(100)), rc(log10(Complex(0, 10))), rc(log10(-1)))
print(rc(sin(z)), rc(cos(z)), rc(tan(z)), rc(sin(1)), rc(cos(Complex(0, 1))), rc(tan(Complex(1, 1000))), tan(Complex(0, inf)))
print(rc(sinh(z)), rc(cosh(z)), rc(tanh(z)), rc(sinh(Complex(709.5, 1)) / 1e307), rc(cosh(Complex(-709.5, 1)) / 1e307), rc(tanh(Complex(800, 1))))
print(sinh(Complex(inf, 1)), sinh(Complex(-inf, 1)), cosh(Complex(inf, 2)), cosh(Complex(-inf, 2)), tanh(Complex(inf, 1)), tanh(Complex(-inf, -1)))
print(sinh(Complex(inf, 0)), cosh(Complex(0, nan)), tanh(Complex(nan, 0)), cosh(Complex(nan, nan)), sinh(Complex(nan, -0.0)), tanh(Complex(-0.0, nan)))
print(rc(asin(z)), rc(acos(z)), rc(atan(z)), rc(asin(2)), rc(acos(2)), rc(atan(Complex(0, 2))), rc(asin(Complex(1e308, 1e308))), rc(acos(Complex(1e308, -1e308))))
print(rc(asinh(z)), rc(acosh(z)), rc(atanh(z)), rc(asinh(Complex(1e308, -1e308))), rc(asinh(Complex(-1e308, 1e308))), rc(acosh(Complex(-1e308, 1e308))), rc(acos(Complex(1, 1e300))))
print(rc(atanh(Complex(1e200, 1))), rc(atanh(Complex(-0.5, 0))), rc(atanh(Complex(1, 1e-200))), rc(atanh(Complex(1, -1e-200))), rc(atanh(2)), rc(acosh(0.5)))
print(acos(Complex(inf, 1)), acosh(Complex(nan, 0)), asinh(Complex(-inf, 2)), atanh(Complex(inf, nan)), asin(Complex(nan, inf)), atan(Complex(inf, 1)))
print(acos(Complex(-inf, -inf)), acosh(Complex(1, inf)), asinh(Complex(nan, 0)), atanh(Complex(1, nan)), acos(Complex(0, nan)), atan(Complex(nan, -inf)))
print(r(phase(z)), phase(-1), phase(Complex(-1, -0.0)), phase(0), polar(1), [r(polar(z)[0]), r(polar(z)[1])], polar(Complex(-inf, nan))[0], polar(-2)[1] == pi)
print(rect(2, 0), rect(-2, -0.0), rc(rect(2, pi / 2)), rc(rect(1, pi)), rect(inf, 0), rect(inf, 1), rect(-inf, 2), rect(0, inf), rect(nan, 0), rect(nan, inf), rect(inf, nan))
print(isfinite(z), isfinite(Complex(inf, 0)), isfinite(3), isinf(Complex(1, -inf)), isinf(z), isinf(inf), isnan(Complex(nan, 0)), isnan(Complex(1, 2)), isnan(nan))
print(isclose(z, Complex(3, 4.0000000001)), isclose(z, w), isclose(1, Complex(1, 1e-10)), isclose(Complex(inf, 1), Complex(inf, 1)), isclose(Complex(inf, 1), 1))
print(isclose(Complex(0, 0), Complex(0, 1e-10), {abs_tol: 1e-9}), isclose(z, Complex(3.3, 4), {rel_tol: 0.1}), isclose(Complex(nan, 0), Complex(nan, 0)), isclose(1, 1, {}))

// with text, as + does with any value
print("z = " + z, z + " (z)", "{z} and {w}", [z, w])
var long = "x"
for i in 0..300 { long += "y" }
print(len(long + z), len(Complex(1, 1) + long))

// mistakes
tries(fn() { sqrt("4") })
tries(fn() { exp([1]) })
tries(fn() { log(0) })
tries(fn() { log(Complex(0, -0.0)) })
tries(fn() { log10(0) })
tries(fn() { log(2, 0) })
tries(fn() { log(2, 1) })
tries(fn() { log(2, "e") })
tries(fn() { log("2") })
tries(fn() { atanh(1) })
tries(fn() { atanh(Complex(-1, 0)) })
tries(fn() { atan(Complex(0, 1)) })
tries(fn() { exp(1000) })
tries(fn() { exp(Complex(1, inf)) })
tries(fn() { exp(Complex(inf, inf)) })
tries(fn() { cos(inf) })
tries(fn() { sin(Complex(inf, 1)) })
tries(fn() { tan(inf) })
tries(fn() { cosh(Complex(1000, 1)) })
tries(fn() { sinh(Complex(1, inf)) })
tries(fn() { sinh(Complex(-1000, 0)) })
tries(fn() { tanh(Complex(1, inf)) })
tries(fn() { phase("x") })
tries(fn() { polar(Complex(1.7e308, 1.7e308)) })
tries(fn() { polar(true) })
tries(fn() { rect(1, inf) })
tries(fn() { rect(-2, -inf) })
tries(fn() { rect("1", 0) })
tries(fn() { rect(1, z) })
tries(fn() { abs(Complex(1.7e308, 1.7e308)) })
tries(fn() { abs("x") })
tries(fn() { isfinite("x") })
tries(fn() { isinf([]) })
tries(fn() { isnan(false) })
tries(fn() { isclose(1, "1") })
tries(fn() { isclose("1", 1) })
tries(fn() { isclose(1, 1, 2) })
tries(fn() { isclose(1, 1, {rel_tol: "1"}) })
tries(fn() { isclose(1, 1, {abs_tol: [1]}) })
tries(fn() { isclose(1, 1, {rel_tol: -1}) })
tries(fn() { isclose(1, 1, {abs_tol: -1}) })
tries(fn() { Complex(1, "2") })
tries(fn() { Complex(z, 1) })
tries(fn() { Complex([1]) })
tries(fn() { Complex(true) })
tries(fn() { Complex("1 + 2j") })
tries(fn() { Complex("") })
tries(fn() { Complex("0x10") })
tries(fn() { Complex("1e") })
tries(fn() { Complex("(1+2j") })
tries(fn() { Complex("1+2") })
tries(fn() { Complex("1+2jj") })
tries(fn() { Complex("_1") })
tries(fn() { Complex("1__0") })
tries(fn() { Complex("1_") })
tries(fn() { Complex("1_e5") })
tries(fn() { Complex("x") })
tries(fn() { Complex("1+xj") })
tries(fn() { Complex("(1+2j)) ") })
tries(fn() { Complex(long) })
tries(fn() { z / 0 })
tries(fn() { z / Complex(0, 0) })
tries(fn() { 1 / Complex(0, -0.0) })
tries(fn() { Complex(0) ** -1 })
tries(fn() { Complex(0) ** Complex(1, 1) })
tries(fn() { Complex(0, 0) ** -0.5 })
