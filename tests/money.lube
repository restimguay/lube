tries(fn() => m(""))
tries(fn() => m("1.2.3"))
tries(fn() => m("1234567890123456789"))
tries(fn() => m("99999999999999999"))
tries(fn() => m(1, "XYZ"))
tries(fn() => m(1, 5))
tries(fn() => m([1]))
tries(fn() => m(m(1), "EUR"))
tries(fn() => m(1e30))
tries(fn() => m(INF - INF))
tries(fn() => m(INF))
tries(fn() => m(uint64("18446744073709551615")))
tries(fn() => m(int64("9223372036854775807")))
tries(fn() => m(1) + m(1, "PHP"))
tries(fn() => m(1) < m(1, "PHP"))
tries(fn() => m(5) * m(2))
tries(fn() => m(5) * "x")
tries(fn() => m(5) - [1])
tries(fn() => m(1) * INF)
tries(fn() => m(0) / 0)
tries(fn() => m(1) / m(0))
tries(fn() => m(1) / (INF - INF))
tries(fn() => m(1) / INF)
tries(fn() => m(1) % 0)
tries(fn() => m(1) % "x")
tries(fn() => 5 % m(1))
tries(fn() => m(1) ** 2)
tries(fn() => 2 / m(1))
tries(fn() => m(1) + 1e30)
tries(fn() => m(90000000000000000) + m(90000000000000000))
tries(fn() => m(-90000000000000000) - m(90000000000000000))
tries(fn() => m(90000000000000000) * 1000)
tries(fn() => m(1).nope)
tries(fn() => sort([m(1), m(1, "EUR")]))
tries(fn() => m(1).allocate(5))
tries(fn() => m(1).allocate([-1]))
tries(fn() => m(1).allocate([0]))
tries(fn() => m(1).split(0))
tries(fn() => m(1).split(1.5))
tries(fn() => m(1).to("EUR", 0))
tries(fn() => m(1).to("XYZ", 1))
tries(fn() => m(90000000000000000).to("JPY", 1000))
tries(fn() => m(1).round(-1))
tries(fn() => m(1).round("x"))
tries(fn() => m(1).format(5))
tries(fn() => m(1).format({symbol: 5}))
tries(fn() => m(1).format({code: 5}))
tries(fn() => m(1).format({thousands: 5}))
tries(fn() => m(1).format({decimal: 5}))
tries(fn() => m(90000000000000000) / 1e-30)
tries(fn() => m(1) - m(1, "EUR"))
tries(fn() => m(1) % 1e30)
tries(fn() => m(1) < 1e30)
fn wants_money(x: Money) => x
tries(fn() => wants_money(5))
fails(fn() { for i in 0..300 { add_currency("C{i}", "", 2) } })
fails(fn() { currency("XYZ") })
fails(fn() { currency(5) })
fails(fn() { add_currency("BTC", "B", 2) })
fails(fn() { add_currency("", "x", 2) })
fails(fn() { add_currency("A-B", "x", 2) })
fails(fn() { add_currency("ABCDEFGH", "x", 2) })
fails(fn() { add_currency("ABC", "x", 1.5) })
fails(fn() { add_currency("ABC", "x", 10) })
fails(fn() { add_currency(1, "x", 2) })
