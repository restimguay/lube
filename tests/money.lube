// Money: amounts of a currency, exact to its smallest unit (m(19.99), m(5, "EUR"), Money)
fn tries(f) { try { print(f()) } catch e { print("error:", e) } }
fn fails(f) { try { f() } catch e { print("error:", e) } }

// ---------- making it ----------
print(m(19.99), m(19.99, "EUR"), m(5, "₱"), m(5, "php"), m("0.10", "PHP"), m(), Money, Money(3), m(int32(7)), m(uint64(2)))
print(m(2.675), m(2.665), m(-2.675), m(0.005), m(0.0049), m(1234567.891), m(1e-30), m(-0.0001), m(123456789012.34))
print(m("1,234.56"), m(" -19.999 "), m("+5"), m("7."), m(".5"), m("0.125", "USD"), m("12", "JPY"), m("1.2345", "BHD"))
print(m(m(3)), m(m(3, "EUR"), "EUR"), m(1234.5, "JPY"), m(1234.567, "BHD"), m(5, "CHF"), m(5, "PLN"), m(5, "CZK"), m(5, "R$"), m(5, "AED"))
print(type(m(1)), m(1) is Money, m(1) is Object, Money is Money)

// ---------- arithmetic: exact, rounding half up (away from zero) ----------
print(m(0.1) + m(0.2), m(0.1) + m(0.2) == m(0.3), 0.1 + 0.2 == 0.3)
let price = m(10.25)
print(price + 1, 1 + price, price - 0.25, 20 - price, price * 0.05, 0.05 * price, price * 1.12, price * 3, price * -1)
print(price / 3, price / -4, price / 0.5, price / 1e-3, price / 1e25, price / m(2.05), price % 3, m(-10) % m(3), m(10) % m(-3), m(7) % -1)
print(-price, -m(0), price > 10, price >= m(10.25), price < 11, price <= 10, m(1) == 1, m(1) != 1.5, m(1) == m(1, "EUR"), m(1) != m(1, "EUR"))
print(price == "10.25", price != [1], [m(1)] == [m(1)], m(1) in [m(2), m(1)], "Total: " + price, price + " due")
print(m(1e12) * 1000, m(0.01) * 0.4, m(0.01) * 0.5, m(-0.01) * 0.5, m(5) * 1e-40, m(92233720368547758.07 / 1000) * 3)
var total = m(0)
total += 5
total -= m(1.5)
total *= 2
total /= 4
print(total)
fn pay(x: Money): Money => x * 2
var wallet = Money[]
wallet.push(m(3))
print(pay(m(1)), wallet, type(wallet), sum([m(1), m(2.5)]), sum([1, m(2)]), max([m(1), m(3)]), min(m(2), m(1)), sort([m(3), m(1), m(2)]))
print(abs(m(-2)), abs(m(2)), Number(m(2.5)), Number(m(-3, "JPY")), str(m(9)), "{m(9)}", repr(m(9)))

// ---------- properties and methods ----------
let p = m(1234.5)
print(p.amount, p.units, p.currency, p.symbol, p.decimals, m(5, "AED").symbol, m(7, "JPY").amount)
print(m(100).split(3), m(-100).split(3), m(0.05).split(2), m(1).split(1), m(100).allocate([1, 2]), m(10).allocate([0.3, 0.7]), m(0.05).allocate([1, 1, 1]))
print(m(-0.05).allocate([1, 1, 1]), m(1).allocate([0, 1]), m(100).allocate([1e-20, 1e20]), m(1).allocate([1, 1, 1, 1, 1, 1, 1]))
print(m(10).to("EUR", 0.92), m(10).to("JPY", 151.234), m(1000, "JPY").to("USD", 0.0066), m(1, "BHD").to("USD", 2.6596))
print(m(12.345).round(), m(12.5).round(0), m(-12.5).round(), m(12.345).round(1), m(12.34).round(2), m(12.34).round(5), m(7, "JPY").round(0))
print(p.format(), p.format({symbol: false}), p.format({symbol: "US$"}), p.format({code: true}), p.format({thousands: ".", decimal: ","}), p.format({thousands: ""}), m(-1234.5, "CHF").format({}))

// ---------- currencies ----------
print(currency())
currency("₱")
print(currency(), m(1500), Money)
currency("EUR")
fn one() => m(1)
fn yen(c) { send(c, m(7, "JPY") + 1) }
print(spawn(one).join())
let ch = channel()
spawn(yen, ch)
print(receive(ch))
add_currency("BTC", "₿", 8)
add_currency("btc", "₿", 8)
add_currency("GOLD", "", 0)
print(m(0.00012345, "BTC"), m(1, "btc").units, m(3, "GOLD"), m(3, "gold").symbol)
currency("USD")

// ---------- mistakes ----------
