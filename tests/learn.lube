// ---------- metrics ----------
let yt = [0, 1, 2, 2, 1, 0, 1, 2, 2]                  // (no value of the reports' ends in a 5 where they round)
let yp = [0, 2, 2, 2, 1, 0, 0, 1, 2]
print(learn.accuracy_score(yt, yp), learn.accuracy_score(yt, yp, {normalize: false}), learn.balanced_accuracy_score(yt, yp))
print(learn.precision_score(yt, yp, {average: "macro"}), learn.recall_score(yt, yp, {average: "micro"}), r6(learn.f1_score(yt, yp, {average: "weighted"})))
print(r6(learn.f1_score(yt, yp, {average: "none"})), learn.precision_score(yt, yp, {average: "none", labels: [2, 0]}), r6(learn.fbeta_score(yt, yp, 2, {average: "macro"})))
let bt = [0, 1, 1, 0, 1, 1]
let bp = [0, 1, 0, 0, 1, 1]
print(learn.precision_score(bt, bp), learn.recall_score(bt, bp), learn.f1_score(bt, bp), learn.f1_score(bt, bp, {pos_label: 0}), r6(learn.fbeta_score(bt, bp, 0.5)))
print(learn.precision_score([0, 0], [0, 0]), learn.precision_score([0, 0], [0, 0], {zero_division: 1}), learn.recall_score([1, 0], [0, 0], {average: "weighted", labels: [5]}))
print(learn.confusion_matrix(yt, yp), learn.confusion_matrix(yt, yp, {labels: [2, 1]}), learn.confusion_matrix(bt, bp).dtype)
print(learn.classification_report(yt, yp))
print(learn.classification_report(bt, bp, {digits: 3, target_names: ["no", "yes"]}))
print(learn.classification_report(yt, yp, {labels: [1, 0], target_names: ["one", 0]}))
print(learn.mean_squared_error([3, -0.5, 2, 7], [2.5, 0, 2, 8]), learn.root_mean_squared_error([3, 5], [1, 5]), learn.mean_absolute_error([3, -0.5, 2, 7], [2.5, 0, 2, 8]))
print(r6(learn.r2_score([3, -0.5, 2, 7], [2.5, 0, 2, 8])), learn.r2_score([1, 1], [1, 1]), learn.r2_score([1, 1], [1, 2]), r6(learn.explained_variance_score([3, -0.5, 2, 7], [2.5, 0, 2, 8])))
