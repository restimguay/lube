print(learn.roc_auc_score([0, 0, 1, 1], [0.1, 0.4, 0.35, 0.8]), learn.roc_auc_score([0, 1, 1], [0.5, 0.5, 0.9]), learn.roc_auc_score([0, 0, 1, 1], [[0.9, 0.1], [0.6, 0.4], [0.65, 0.35], [0.2, 0.8]]))
