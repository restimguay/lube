class Majority {
  var label = 0
  fn fit(X, y) {
    var m = this                                        // (an instance passed to a plugin can't change: fit returns the fitted one)
    m.label = np.bincount(np.array(y, "int64")).argmax()
    return m
  }
  fn predict(X) => np.full(len(X), this.label)
  fn score(X, y) => np.mean(np.array(y) == this.label)
}
let maj = Majority()
print(r4(learn.cross_val_score(maj, X, y, {cv: kfs})), r4(learn.cross_val_score(maj, X, y, {cv: kfs, scoring: "accuracy"})), learn.cross_val_score(maj, X, y, {cv: 3, scoring: fn(m, a, b) => 1}))
class Broken {
  fn fit(X, y) { assert(false, "cannot fit") }
  fn score(X, y) => "high"
}
class Wordy {
  fn fit(X, y) => 0
  fn score(X, y) => "high"
}
tries(fn() => learn.cross_val_score(Broken(), X, y))
