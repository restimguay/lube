bad("vshape", chain_model(CV, CN, {change: [["blk.0.attn_norm.weight", 0, [16], zeros(16)]]}))
bad("vtype", chain_model(CV, CN, {change: [["blk.0.attn_norm.weight", 20, [32], Bytes(18)]]}))
bad("oshape", chain_model(CV, CN, {change: [["output.weight", 0, [32, 9], zeros(9 * 32)]]}))
bad("gshape", chain_model(CV, CN, {change: [["blk.0.ffn_gate.weight", 0, [32, 16], zeros(512)]]}))
bad("noup", chain_model(CV, CN, {drop: "blk.0.ffn_up.weight"}))
bad("noo", chain_model(CV, CN, {drop: "blk.0.attn_output.weight"}))
bad("freqs", chain_model(CV, CN, {add: [["rope_freqs.weight", 0, [9], ones(9)]]}))
bad("qkv", chain_model(CV, CN, {add: [["blk.0.attn_qkv.weight", 0, [32, 10], zeros(320)]]}))
bad("unaligned", chain_model(CV, CN, {extra: [["general.alignment", 4, 1], ["pad", 8, "x"]], align: 1}))

// ---------- metadata of every type; the embeddings as the output; a tensor llm cannot read ----------
let every = [["u8", 0, 200], ["i8", 1, -100], ["u16", 2, 60000], ["i16", 3, -30000], ["u32", 4, 4000000000], ["i32", 5, -2000000000],
             ["f32", 6, 0.5], ["bool", 7, true], ["str", 8, "text"], ["arr", 9, [9, [[4, [1, 2]], [8, ["x"]]]]], ["u64", 10, 1099511627776],
             ["i64", 11, -1099511627776], ["f64", 12, 0.25], ["llama.rope.scaling.type", 8, "yarn"], ["general.file_type", 4, 99]]
write_bytes("build/llm/every.gguf", chain_model(CV, CN, {extra: every, drop: "output.weight", add: [["extra.weight", 20, [32], Bytes(18)]]}))
let e = llm.load("build/llm/every.gguf", {mmap: false})
var md = e.metadata
print(md.u8, md.i8, md.u16, md.i16, md.u32, md.i32, md.f32, md.bool, md.str, md.arr, md.u64, md.i64, md.f64, e.quantization)
print(e.forward([5]).argmax(), e.tensors[-1])
tries(fn() => e.tensor("extra.weight"))
write_bytes("build/llm/bpe.gguf", chain_model([["\u{20ac}!", 1], ["<s>", 3], ["</s>", 3], ["a", 1]], [0, 3, 0, 0], {tokenizer: "gpt2"}))
let bp = llm.load("build/llm/bpe.gguf")
print(bp.detokenize([0, 3]), bp.tokenize("a!a"), bp.generate("a", {temperature: 0, max_tokens: 2}))

// ---------- a bigger model (of zeros): its products and attention shared among threads ----------
let BV = 16384
let BE = 256
var btoks = ["</s>", "<s>"]
for i in 2..BV { btoks.push("t{i}") }
fn q4z(rows, cols) => Bytes(rows * cols / 32 * 18)
var bts = [["token_embd.weight", 2, [BE, BV], q4z(BV, BE)], ["output_norm.weight", 0, [BE], ones(BE)],
           ["blk.0.attn_norm.weight", 0, [BE], ones(BE)], ["blk.0.ffn_norm.weight", 0, [BE], ones(BE)]]
for m in [["attn_q", BE, BE], ["attn_k", BE, BE], ["attn_v", BE, BE], ["attn_output", BE, BE], ["ffn_gate", BE, 32],
          ["ffn_up", BE, 32], ["ffn_down", 32, BE]] {
  bts.push(["blk.0.{m[0]}.weight", 2, [m[1], m[2]], q4z(m[1], m[2])])
}
write_bytes("build/llm/big.gguf", gguf([["general.architecture", 8, "llama"], ["llama.context_length", 4, 256],
  ["llama.embedding_length", 4, BE], ["llama.block_count", 4, 1], ["llama.feed_forward_length", 4, 32],
  ["llama.attention.head_count", 4, 8], ["tokenizer.ggml.model", 8, "llama"], ["tokenizer.ggml.tokens", 9, [8, btoks]],
  ["tokenizer.ggml.bos_token_id", 4, 1], ["tokenizer.ggml.eos_token_id", 4, 0]], bts))
for th in [0, 1, 3] {
  let big = llm.load("build/llm/big.gguf", {threads: th})
  var last = big.forward([1])
  for i in 0..4 { last = big.forward(range(0, 32).map(fn(i) => i + 2)) }
  print(big, th, len(big.tokens), last.shape, last.max(), last.min(), repr(big.generate([1], {temperature: 0})),
        len(big.generate([1], {temperature: 2, top_k: 0, max_tokens: 3, seed: 1})) > 0)
}

// ---------- a model in another isolate ----------
fn story(path, n) {
  let m = llm.load(path)
  return m.generate([1, 30, 36], {temperature: 0, max_tokens: n})
}
print(spawn(story, "tests/models/llama-mixed.gguf", 6).join() == story("tests/models/llama-mixed.gguf", 6))

for f in list_dir("build/llm") { remove_file("build/llm/{f}") }
remove_file("build/llm")
