// Language models (the plugin llm): GGUF files, the tokenizers, the forward pass, generating text, and what
// goes wrong. The tiny models in tests/models/ have random weights (made by tests/models/make_models.py, which
// also prints what its numpy reference gives for them: checked here); others are made here, by gguf() below.
import llm
import array as np
import fs.*

fn tries(f) { try { print(f()) } catch e { print("error:", e) } }
fn close(a, b, tol = 0.002) => abs(a - b) <= tol
make_dir("build/llm")

// ---------- GGUF files, made here ----------
// kvs: [key, type, value] (types: 0 u8, 1 i8, 2 u16, 3 i16, 4 u32, 5 i32, 6 f32, 7 bool, 8 str, 9 array of
// [element type, items], 10 u64, 11 i64, 12 f64); tensors: [name, ggml type, dims (row length first), Bytes]
let FMT = ["u8", "i8", "u16", "i16", "u32", "i32", "f32", "u8", "", "", "u64", "i64", "f64"]
fn gstr(&b, s) {
  b.pack("u64", len(s))
  push(&b, s)
}
fn gval(&b, t, v) {
  if t == 8 { gstr(&b, v) }
  else if t == 9 {
    b.pack("u32", v[0])
    b.pack("u64", len(v[1]))
    for x in v[1] { gval(&b, v[0], x) }
  }
  else if t == 7 {
    if v { b.pack("u8", 1) } else { b.pack("u8", 0) }
  }
  else { b.pack(FMT[t], v) }
}
fn gguf(kvs, tensors, version = 3, align = 32) {
  var b = Bytes("GGUF")
  b.pack("u32", version)
  b.pack("u64", len(tensors))
  b.pack("u64", len(kvs))
  for kv in kvs {
    gstr(&b, kv[0])
    b.pack("u32", kv[1])
    gval(&b, kv[1], kv[2])
  }
  var offset = 0
  for t in tensors {
    gstr(&b, t[0])
    b.pack("u32", len(t[2]))
    for d in t[2] { b.pack("u64", d) }
    b.pack("u32", t[1])
    b.pack("u64", offset)
    offset += len(t[3]) + (align - len(t[3]) % align) % align
  }
  while len(b) % align != 0 { push(&b, 0) }
  for t in tensors {
    push(&b, t[3])
    while len(b) % align != 0 { push(&b, 0) }
  }
  return b
}
fn f32s(xs) => np.array(xs, "float32").to_bytes()
fn zeros(n) => Bytes(4 * n)
fn ones(n) => f32s(np.ones(n))

// A model of the llama family, F32, that maps each token to the next by a table (its layers are all zeros,
// so the logits are output . embedding: one-hot embeddings, and the output's row j is the embedding of the
// token before j). vocab: [text, type]; next[i]: the token after i. Options: extra (metadata to add), drop (a
// tensor to leave out), change (tensors to replace: [name, type, dims, Bytes]), add (tensors to add), arch,
// align (the file's alignment), version (GGUF's: 3).
fn chain_model(vocab, next, o = {}) {
  let V = len(vocab)
  let E = 32
  let arch = get(o, "arch", "llama")
  var emb = np.zeros(V, E)
  var out = np.zeros(V, E)
  for i in 0..V {
    emb[i, i] = 1
    if next[i] >= 0 { out[next[i], i] = 4 }
  }
  var kvs = [["general.architecture", 8, arch], ["general.name", 8, "chain"],
             ["{arch}.context_length", 4, 16], ["{arch}.embedding_length", 4, E], ["{arch}.block_count", 4, 1],
             ["{arch}.feed_forward_length", 4, 40], ["{arch}.attention.head_count", 4, 2],
             ["{arch}.attention.layer_norm_rms_epsilon", 6, 0.00001], ["tokenizer.ggml.model", 8, get(o, "tokenizer", "llama")],
             ["tokenizer.ggml.merges", 9, [8, []]], ["tokenizer.ggml.tokens", 9, [8, map(vocab, fn(v) => v[0])]],
             ["tokenizer.ggml.token_type", 9, [5, map(vocab, fn(v) => v[1])]],
             ["tokenizer.ggml.bos_token_id", 4, 1], ["tokenizer.ggml.eos_token_id", 4, 2]] + get(o, "extra", [])
  var ts = [["token_embd.weight", 0, [E, V], emb.astype("float32").to_bytes()],
            ["output.weight", 0, [E, V], out.astype("float32").to_bytes()], ["output_norm.weight", 0, [E], ones(E)]]
  for name in ["attn_norm", "ffn_norm"] { ts.push(["blk.0.{name}.weight", 0, [E], ones(E)]) }
  for m in [["attn_q", E, E], ["attn_k", E, E], ["attn_v", E, E], ["attn_output", E, E], ["ffn_gate", E, 40],
            ["ffn_up", E, 40], ["ffn_down", 40, E]] {
    ts.push(["blk.0.{m[0]}.weight", 0, [m[1], m[2]], zeros(m[1] * m[2])])
  }
  ts = ts.filter(fn(t) => t[0] != get(o, "drop", "")) + get(o, "add", [])
  for c in get(o, "change", []) {
    for i, t in ts { if t[0] == c[0] { ts[i] = c } }
  }
  return gguf(kvs, ts, get(o, "version", 3), get(o, "align", 32))
}

// its vocabulary: 1 <s> -> ▁a -> <0xC3> -> <0xA9> -> b -> </s>; c <-> d go round
let CV = [["<unk>", 2], ["<s>", 3], ["</s>", 3], ["<0xC3>", 6], ["<0xA9>", 6], ["▁a", 1], ["b", 1], ["c", 1],
          ["d", 9], ["<|end|>", 3]]
let CN = [0, 5, 0, 4, 6, 3, 2, 8, 7, 0]
write_bytes("build/llm/chain.gguf", chain_model(CV, CN))

// ---------- loading, and what a model says of itself ----------
let c = llm.load("build/llm/chain.gguf")
print(c, type(c), c is llm.Model, c.architecture, c.name, c.vocab_size, c.context_length, c.context, c.layers)
print(c.embedding_length, c.heads, c.kv_heads, c.feed_forward_length, c.parameters, c.size, c.quantization, c.bos, c.eos, c.tokens)
print(len(c.tensors), c.tensors[0], c.tensors[3])
print(c.tensor("output_norm.weight").shape, c.tensor("token_embd.weight")[5, 0..8], c.tensor("output.weight")[3, 5])
write_bytes("build/llm/chain2.gguf", chain_model(CV, CN, {version: 2}))
print(llm.load("build/llm/chain2.gguf").generate([1], {temperature: 0}))
let c2 = llm.Model("build/llm/chain.gguf", {threads: 1, context: 8, mmap: false})
print(c2.context, c2.metadata["general.architecture"], len(keys(c2.metadata)), c2.metadata["tokenizer.ggml.tokens"][5])

// ---------- SentencePiece: ▁ for spaces, byte tokens, special tokens ----------
for text in ["a b", "é", "a</s>b", "", "d<0xC3>"] { print(repr(text), c.tokenize(text), c.tokenize(text, {special: true, bos: false, eos: true})) }
print(c.detokenize([5, 3, 4, 6]), repr(c.detokenize([1, 5, 2, 0, 9])), c.detokenize([1, 5, 2, 0, 9], {special: true}), c.detokenize(5), repr(c.detokenize([])))
print(c.detokenize(c.tokenize("aéb")) == " aéb".slice(1), c.tokenize("<s>d", {special: true}))

// ---------- forward: logits after the tokens before (the cache) ----------
let lg = c.forward([1])
print(lg.shape, lg.dtype, lg.argmax(), round(lg[5], 3), c.tokens, c.forward(5).argmax(), c.forward([3, 4]).argmax(), c.tokens)
c.reset()
print(c.tokens, c.forward([7, 8, 7]).argmax())

// ---------- generate ----------
var pieces = []
c.reset()
print(repr(c.generate([1], {temperature: 0, on_token: fn(p) { pieces.push(p) }})), pieces, c.tokens)
for stop in ["éb", ["x", "b"], "a", "aé", "zz"] {
  pieces = []
  print(repr(c.generate([1], {temperature: 0, stop: stop, on_token: fn(p) { pieces.push(p) }})), pieces)
}
pieces = []
print(repr(c.generate([1], {temperature: 0, on_token: fn(p) { pieces.push(p); return false }})), pieces)
print(c.generate([7], {temperature: 0, max_tokens: 5}), c.generate([7], {temperature: 0, max_tokens: 30}), len(c.tokens))
print(repr(c.generate([7], {max_tokens: 0})), c.generate([7], {temperature: 0, max_tokens: 4, repeat_penalty: 1.5}))
print(c.generate("c", {temperature: 0, max_tokens: 3}), c.tokens, c.generate("c", {temperature: 0, max_tokens: 3}), c.tokens)
for opts in [{temperature: 30, seed: 7, max_tokens: 8}, {temperature: 30, seed: 7, max_tokens: 8, top_k: 0},
             {temperature: 30, seed: 7, max_tokens: 8, top_k: 2, top_p: 0.5}, {temperature: 30, seed: 7, max_tokens: 8, top_p: 0}] {
  let first = c.generate([7], opts)
  print(c.tokens, c.generate([7], opts) == first)  // (the tokens: text from random ones may be part of a character)
}
np.seed(3)
let s1 = c.generate([7], {temperature: 30, max_tokens: 8})
np.seed(3)
print(s1 == c.generate([7], {temperature: 30, max_tokens: 8}))
tries(fn() => c.generate([1], {on_token: fn(p) { c.reset() }}))
tries(fn() => c.generate([1], {on_token: fn(p) { c.forward([1]) }}))
tries(fn() => c.generate([1], {on_token: fn(p) { c.generate([1]) }}))
tries(fn() => c.generate([1], {on_token: fn(p) => 1 / 0}))
tries(fn() => c.generate([1], {on_token: 5}))
print(c.generate([1], {temperature: 0, on_token: fn(p) => c.tokenize(p)}), c.tokens)

// ---------- the tiny models: logits and greedy tokens as the numpy reference has them ----------
// made by tests/models/make_models.py: [file, prompt, top 5 tokens, their logits, 8 greedy tokens]
let REF = [
  ["llama-mixed.gguf", [1, 30, 36, 38, 40], [10, 44, 49, 46, 3], [5.7463, 4.4889, 4.2917, 3.4809, 3.4151], [10, 32, 44, 46, 14, 14, 27, 10]],
  ["qwen2-bpe.gguf", [60, 41, 50, 42], [60, 32, 43, 26, 4], [4.6202, 3.8953, 3.689, 2.9952, 2.8676], [60, 60, 60, 60, 60, 60, 60, 60]],
  ["phi3-fused.gguf", [1, 33, 37], [15, 38, 49, 20, 35], [4.665, 4.0432, 3.4175, 2.5996, 2.5675], [15, 41, 35, 42, 0, 52, 26, 31]],
  ["kquants.gguf", [60, 41, 50, 42, 45], [40, 12, 58, 27, 9], [4.6675, 4.3127, 3.0164, 2.5912, 1.9602], [40, 40, 40, 40, 40, 40, 40, 40]],
  ["gemma.gguf", [1, 30, 36], [36, 14, 48, 54, 24], [9.1093, 5.306, 3.3704, 3.0019, 2.8863], [36, 36, 36, 36, 36, 36, 36, 36]],
  ["qwen3.gguf", [41, 50], [53, 13, 18, 21, 5], [4.4116, 3.3904, 3.227, 2.7085, 2.4801], [53, 52, 52, 52, 52, 52, 52, 52]],
  ["mistral-gpt2.gguf", [41, 50, 42], [33, 42, 31, 62, 51], [6.0074, 4.5707, 4.0681, 3.7618, 3.7183], [33, 33, 33, 62, 62, 62, 62, 62]],
]
var models = {}
for r in REF {
  let m = llm.load("tests/models/{r[0]}")
  models[r[0]] = m
  print(m, m.name, m.quantization, m.embedding_length, m.heads, m.kv_heads, m.feed_forward_length, m.parameters, m.size, m.bos, m.eos)
  let lg = m.forward(r[1])
  let top = (-lg).argsort()[0..5].to_list()
  var greedy = []
  var cur = lg
  for i in 0..8 {
    greedy.push(cur.argmax())
    cur = m.forward([greedy[-1]])
  }
  m.reset()
  var one = lg
  for t in r[1] { one = m.forward([t]) }
  m.generate(r[1], {temperature: 0, max_tokens: 8})
  // (generate stops at a token that ends the text: </s> or <|end|>, <|endoftext|> or <|im_end|>)
  var until_end = []
  for t in r[4].slice(0, 7) {
    if [2, 7, 60, 62].contains(t) and (t < 56) == (m.vocab_size == 56) { break }
    until_end.push(t)
  }
  print("  top 5", top == r[2], all(zip(top.map(fn(i) => lg[i]), r[3]), fn(p) => close(p[0], p[1])), " greedy", greedy == r[4],
        m.tokens.slice(len(r[1])) == until_end, len(until_end), " one at a time", np.array_equal(one, lg))
}

// each format's numbers, as the reference reads them
let mixed = models["llama-mixed.gguf"]
for t in [["blk.0.attn_q.weight", [0.017294, 0.195398, 0.051649, 0.085075]], ["blk.0.attn_k.weight", [0.140259, -0.006889, 0.191895, -0.092896]],
          ["blk.0.attn_v.weight", [0.037598, -0.253906, -0.022095, 0.277344]], ["blk.0.attn_output.weight", [-0.100952, -0.151428, 0.050476, 0.201904]],
          ["blk.0.ffn_gate.weight", [-0.283203, -0.144043, -0.097656, -0.144043]], ["blk.0.ffn_up.weight", [-0.212158, -0.02652, -0.159119, 0.0]],
          ["blk.0.ffn_down.weight", [0.24437, -0.050339, -0.132202, -0.033966]], ["blk.1.attn_q.weight", [-0.128462, 0.079264, 0.019133, -0.073797]]] {
  let w = mixed.tensor(t[0])
  print(t[0], w.shape, all(zip(w[0, 0..4].to_list(), t[1]), fn(p) => close(p[0], p[1], 0.000001)))
}
for t in [["blk.0.attn_q.weight", [-0.000626, -0.030968, -0.076481, -0.023382]], ["blk.0.attn_k.weight", [0.096341, 0.028902, -0.048171, 0.086707]],
          ["blk.0.attn_v.weight", [0.005657, -0.098354, 0.124527, 0.109668]]] {
  let w = models["kquants.gguf"].tensor(t[0])
  print(t[0], w.shape, all(zip(w[0, 0..4].to_list(), t[1]), fn(p) => close(p[0], p[1], 0.000001)))
}
print(mixed.tensors.map(fn(t) => t.type).filter(fn(t) => t != "F32"), models["kquants.gguf"].tensors.map(fn(t) => t.type).filter(fn(t) => t != "F32"))

// 40 tokens: two batches of the forward pass, and one at a time, the same
let long = [1] + range(10, 49).map(fn(i) => i % 56)
mixed.reset()
let all_at_once = mixed.forward(long)
mixed.reset()
var step = all_at_once
for t in long { step = mixed.forward([t]) }
print(np.array_equal(step, all_at_once), len(mixed.tokens), mixed.context)

// ---------- GPT-2's byte-level BPE: words by each model's rules (qwen2, llama 3, smollm, gpt2) ----------
let texts = ["the cat sat on the mat", "it's IT'S 12345 hello!!", " cats", "a  b\n\n c  ", "café x?", "<|im_start|>hi<|im_end|><tool>",
             "  \n", "hello.\r\n\r\nhi", "'", "1 2, 3", "a\u{a0}b\u{3000}c", Bytes([0xC3, 0x41, 0x62]).decode(), "<tool>" * 20]
for f in ["qwen2-bpe.gguf", "kquants.gguf", "qwen3.gguf", "mistral-gpt2.gguf"] {
  let m = models[f]
  print(f, m.metadata["tokenizer.ggml.pre"])
  for i, text in texts {
    let t = m.tokenize(text)
    var shown = repr(text)
    if i == 11 { shown = "(not UTF-8)" }
    print("  ", shown, t, m.tokenize(text, {special: true}), repr(m.detokenize(t)), repr(m.detokenize(m.tokenize(text, {special: true}), {special: true})))
  }
}

// ---------- SentencePiece's, with <unk> for bytes it has no token for ----------
for text in ["the cat sat on the mat", "a dog was happy\nin", "é€", "<|user|>hi</s>", "  happy  ", "hap"] {
  let t = mixed.tokenize(text)
  print(repr(text), t, mixed.tokenize(text, {special: true}), repr(mixed.detokenize(t)), repr(mixed.detokenize(t, {special: true})))
}
// (phi3's special tokens take the white space after them, but <s>'s: as Hugging Face's tokenizer has it)
let phi = models["phi3-fused.gguf"]
print(phi.tokenize("<|end|>\n hi<s> a<|user|>\t", {special: true}), mixed.tokenize("<|end|>\n hi<s> a<|user|>\t", {special: true}))

