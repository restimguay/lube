// array and cmath: dtypes, orders and options as short strs, Complex parsed from text
import array as np
np.use_blas(false)
import cmath
let a = np.zeros(2, 3, "int64")
print(a, a.dtype, type(a.dtype), a.dtype == "int64", len(a.dtype))
let b = np.array([1.5, 2.5], "float32")
print(b, b.dtype, b.astype("int32"), b.astype("bool"), np.ones(2, "uint8"))
try { print(np.zeros(2, "int8")) } catch e { print("error:", e) }
try { print(np.zeros(2, "a dtype nobody has")) } catch e { print("error:", e) }
let m = np.array([[3, 1], [1, 2]])
print(np.norm(m, "fro"), np.norm(m), np.linspace(0, 1, 5))
try { print(np.norm(m, "nuc")) } catch e { print("error:", e) }
try { print(np.norm(m, "bogus")) } catch e { print("error:", e) }
print(np.unique(np.array([3, 1, 3, 2]), {return_counts: true}))
for s in ["1+2j", "2j", "(1-2.5e3J)", "inf+nanj", "3", " 4 ", "-1-1j", "1e3+1e-3j", "x", "", "1+2j and more", "(1+2j)"] {
  try { print(repr(s), cmath.Complex(s)) } catch e { print("error:", e) }
}
let z = cmath.Complex(3, 4)
print(z, str(z), "{z}", repr(z), type(z), type(str(z)), str(z) == "(3+4j)", len(str(z)))
print(cmath.sqrt(-4), str(cmath.sqrt(-4)), cmath.abs(z))
