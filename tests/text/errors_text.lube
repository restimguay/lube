// error messages that carry text of both forms
fn t(f) {
  try { print(f()) } catch e { print("error:", e) }
}
let o = {a: 1}
t(fn() => o["zz"])
t(fn() => o["a long missing key"])
t(fn() => o.missing)
t(fn() => num("abc"))
t(fn() => num("12abc"))
t(fn() => num("a long non-number text"))
t(fn() => Number("1e"))
t(fn() => int32("99999999999"))
t(fn() => int8("300"))
t(fn() => int32("abc"))
t(fn() => uint8("-1"))
t(fn() => ord(""))
t(fn() => "abc"[5])
t(fn() => "abc"[-4])
t(fn() => "abc"[1.5])
t(fn() => "abc"["x"])
t(fn() => "abc" - 1)
t(fn() => "a" < 5)
t(fn() => "a" * -1)
t(fn() => "a" * 1.5)
t(fn() => 5 in "abc")
t(fn() => "a" in 5)
t(fn() => "x" in 5)
t(fn() => pad_left("a", 5, "ab"))
t(fn() => pad_left("a", 5, ""))
t(fn() => upper(5))
t(fn() => split("a", 5))
t(fn() => replace("a", "b", 5))
t(fn() => join([1, "a"], ","))
t(fn() => join(["a", "b"], 5))
t(fn() => m(1, "XYZ"))
t(fn() => m(1, "a currency too long"))
t(fn() => m("abc"))
t(fn() => Bytes(5).unpack("u17"))
t(fn() => Bytes(5).unpack("a very long bad format"))
t(fn() => read_file("no_such_file.txt"))
t(fn() => read_file("a/very/long/path/that/does/not/exist.txt"))
t(fn() => find_class("abc"))
t(fn() => chr(-1))
t(fn() => "abc".nosuchmethod())
t(fn() => "a long str receiver".nosuchmethod())
var x = "str"
t(fn() => x.push(1))
throw "short"
