// "...{x}..." put together from its pieces: text written out, whole numbers, other numbers, strs short and
// long, and everything else, at every length around the sizes the interpreter treats differently
import math
fn check(label, made, parts) {
  var joined = ""
  for p in parts { joined = joined + str(p) }
  if made != joined or len(made) != len(joined) or type(made) != "str" { print("DIFFERENT", label, repr(made), repr(joined)) }
  return len(made)
}

// whole numbers: every count of digits, both signs, the ends of what is exact
var total = 0
var n = 1
for d in 0..18 {
  for x in [n - 1, n, n + 1, -n, 1 - n, -n - 1] {
    total += check("whole", "{x}", [x]) + check("whole in text", "a{x}b{x}", ["a", x, "b", x])
  }
  n *= 10
}
print(total, "{0}", "{-0.0}", "{0 * -1}", "{9007199254740992}", "{9007199254740993}", "{-9007199254740992}")
print("{999999999999999}", "{9999999999999998}", "{1e15}", "{1e16}", "{-1e16}", "{1e17}", "{1e21}", "{1e22}", "{1e300}", "{123456789012345678}")
print("{0.5}", "{-0.5}", "{0.1 + 0.2}", "{1 / 3}", "{2.5e-7}", "{1e-4}", "{100.25}", "{math.nan}", "{math.inf}", "{-math.inf}", "x{1.5}y{2}z{2.25}")
print("{int8(-5)}", "{uint64("18446744073709551615")}", "{int64("-9223372036854775807")}|{uint8(7)}{3}")

// pieces of every kind, alone and after and before pieces of the quick kind
let things = [true, false, [1, "a", [2]], {k: "v", n: 1}, String("S"), 1..3, m("1.50"), Bytes("hi"), "", "s", "a str longer than ten bytes", 7, -7, 0.25, print, Map]
for t in things {
  print("{t}", "a{t}", "{t}b", "{1}{t}{2}", "long text before it {t} and after it, {3}", len("{t}{t}{t}{t}{t}{t}{t}{t}{t}{t}{t}{t}"))
  check("a thing", "{t}|{5}|{t}", [t, "|", 5, "|", t])
}

// lengths: the result as long as a short str holds, then longer; the pieces as many as fit at once, then more
for k in 0..40 {
  let s = "abcdefghijklmnopqrstuvwxyz".slice(0, k % 27)
  let made = "{s}{k}"
  let both = "{k}{s}-{s}{k}"
  check("short and long", made, [s, k])
  check("both", both, [k, s, "-", s, k])
  if k % 6 == 0 { print(k, made, len(made), both, {[made]: k}[s + str(k)], made == s + str(k), made < both) }
}
var sizes = []
for k in 0..150 {
  let s = "x" * k
  let a = check("one long piece", "{s}", [s])
  let b = check("pieces up to the room", "{s}{k}{s}", [s, k, s])
  let c = check("many pieces", "{k}:{s}:{k}:{s}:{k}:{s}:{k}", [k, ":", s, ":", k, ":", s, ":", k, ":", s, ":", k])
  let d = check("a number that is not whole, late", "{s}{k}{k + 0.5}{s}", [s, k, k + 0.5, s])
  if k % 25 == 0 or (k > 95 and k < 132 and k % 4 == 0) { sizes.push([k, a, b, c, d]) }
}
print(sizes)
var digits = ""
for i in 0..60 { digits = "{digits}{i}" }
print(digits, len(digits))
var grown = ""
for i in 0..40 { grown = "{i},{grown}{-i};" }
print(len(grown), grown.slice(0, 30), grown.slice(len(grown) - 30))

// text with a NUL in it, text of several bytes a character, text inside text
let nul = "a\x00b"
print(len("{nul}"), len("{nul}{nul}{7}"), "{nul}{1}" == nul + "1", repr("x{nul}"), "é{1}日本{22}語" == "é1日本22語", len("é{1}日本{22}語"))
print("{"{1}{"{2}{"three"}"}"}", "{{a: 1}}", "a{"b"}c{"d" + "e"}f", "{[1, "{2}"]}", "{len("{12345}")}")

// used as text is: a key, a name, compared, taken apart
var seen = {}
for i in 0..200 { seen["k{i}"] = i }
var sum = 0
for i in 0..200 { sum += seen["k{i}"] + seen["k" + str(i)] }
print(len(seen), sum, seen.k7, "k199" in seen, "k200" in seen, keys(seen)[10], type(keys(seen)[10]))
class Tag {
  var id = 0
  fn show() => "#{this.id}"
  fn wide() => "tag number {this.id} of many"
}
var tags = [Tag(), Tag()]
tags[1].id = 41
print(tags[0].show(), tags[1].show(), tags[1].wide(), "{tags[1].show()}{tags[0].show()}", upper("{tags[1].wide()}"), "{1}{2}".split(""), "v{3}" * 3)
