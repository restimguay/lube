// Bytes from and to strs; pack/unpack formats given as strs; decode results
var b = Bytes("hi")
push(&b, 33, "!?", "a long str to append", Bytes([0]))
print(b, len(b), repr(b.decode()), b.hex(), type(b.decode()), b.decode() == "hi!!?a long str to append\x00")
print(Bytes(""), Bytes("abcdefghij"), Bytes("abcdefghijk"), Bytes("é"), Bytes(String("s")))
print("!?" in b, "z" in b, "" in b, "hi" in b, "a long str" in b, "a long strx" in b)
var p = Bytes()
p.pack("u16be", 0)
p.pack("u8", 7)
p.pack("f32", 1.5)
p.pack("u16be", len(p), 0)
p.pack("i64", -5)
p.pack("f64le", 0.1)
print(p, p.unpack("u16be"), p.unpack("u8", 2), p.unpack("f32", 3), p.unpack("i64", 7), p.unpack("f64le", 15))
let fmt = "u3" + "2be"
p.pack(fmt, 258)
print(p.unpack(fmt, len(p) - 4))
print(Bytes([104, 105]).decode(), Bytes([0xe6, 0x97, 0xa5]).decode(), Bytes([0xff, 0xfe]).decode(), len(Bytes([0xff]).decode()))
let s = Bytes([97, 98, 99, 100, 101, 102, 103, 104, 105, 106, 107]).decode()
print(s, len(s), s == "abcdefghijk", s.slice(0, 10) == "abcdefghij", type(s))
print(b.slice(1, 3), b + Bytes([0]), 33 in b, b.slice(0, 2).decode() == "hi")
var bb = Bytes(3)
bb[0] = 72
print(bb, bb.hex(), Bytes([1, 2, 3]).hex() == "010203")
