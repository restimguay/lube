// a str key written out, made at run time, short and long, in objects and maps
var o = {name: "ada", age: 3, "with space": 1, ab: 2, "1abc": 3, "a-b": 4, éé: 5}
let k = "na" + "me"
print(o[k], o["name"], o.name, has(o, k), get(o, "nam" + "e", 0), o, keys(o), values(o))
for key in keys(o) { print(key, type(key), key == "name", o[key], key in o, len(key), repr(key)) }
for key, value in o { print(key, "=", value) }
var m = Map
m["abc"] = 1
m["ab" + "c"] = 2
m[slice("xxabcxx", 2, 5)] = 3
m[String("abc").value] = 4
m[upper("ABC").lower()] = 5
m[str(123)] = 6
m[123] = 7
m["123"] = 8
print(m, len(m), keys(m), m["abc"], m[slice("abcd", 0, 3)])
var long = Map
long["abcdefghijk"] = 1
long["abcdefghij" + "k"] = 2
long[slice("abcdefghijkl", 0, 11)] = 3
long["abcdefghij"] = 4
long["abcdefghi" + "j"] = 5
print(long, len(long), keys(long))
o[k] = "eve"
o["new" + "key"] = 1
o.another = 2
print(o)
print(delete(&o, "a" + "b"), delete(&o, "zz"), o, keys(o))
let typed = Map[str, Number]
var t = typed
t["x"] = 1
t["x" + "y"] = 2
t[join(["a", "b"], "")] = 3
print(t, keys(t), type(keys(t)), values(t), type(t))
try { t[5] = 1 } catch e { print("error:", e) }
try { t["q"] = "no" } catch e { print("error:", e) }
try { print(o["missing"]) } catch e { print("error:", e) }
try { print(o.missing) } catch e { print("error:", e) }
try { print(m["nope" + "x"]) } catch e { print("error:", e) }
print(get(m, "nope", "dflt"), get(o, "name"), has(m, "abc"), "abc" in m, "abd" in m)
print(items(o), Object([["a", 1], ["b" + "c", 2]]), Map([["k", 1], [["x"], 2]]))
