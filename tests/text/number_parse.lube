// Number(text): the quick path against strtod's
import math
let inputs = ["12", "-3.25", ".5", "-.5", "5.", "-5.", "1e3", "1E3", "  12", "12  ", " 12 ", "0012", "-0", "-0.0", "0", "0.0", "+5", "1_000", "0x1F", "0X1f", "1.2345678901234567", "123456789012345", "1234567890123456", "12345678901234567", "0.1", "0.3", "0.30000000000000004", "9007199254740993", "9007199254740992", "inf", "-inf", "nan", "INF", "Infinity", "-", ".", "", "1..2", "1.2.3", "٣", "1,5", "--1", "-+1", "1-", "\t3\n", "0.000000000000001", "0.0000000000000001", "999999999999999.9", "99999999999999.99", "1.00000000000000", "100000000000000.", "4.35", "0.1e1", "123.456", "-123.456", "5e-324", "1e309", "2.2250738585072014e-308", "0.123456789012345", "12345678901234.5", "1234567890.12345", "007.5", "-007.5"]
for s in inputs {
  let a = Number(s, "fallback")
  let b = num(s, "fallback")
  write(repr(s), " -> ", a, " ", b, " ")
  if a is Number and a - a == 0 { write(a == b, " ", math.copysign(1, a), " ", fixed(a, 17)) }  // (not inf, not nan)
  else if a is Number { write(a == b) }
  print()
}
for s in ["12", "-3", "0x10", "1_000", "abc", "255", "256", "-129", "18446744073709551615"] {
  try { print(s, int32(s), uint8(s)) } catch e { print("error:", e) }
  try { print(s, int64(s), uint64(s)) } catch e { print("error:", e) }
}
var total = 0
for p in split("1,2.5,-3,.25,4e1,  6", ",") { total += Number(p) }
print(total)
print(Number(String("42")), Number(String("-0.5")), m("19.99"), m("-0.01"), m("1,234.50"))
