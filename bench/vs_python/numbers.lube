// numbers.lube: the plugins math, cmath, statistics and random (numbers.py does the same with Python's modules of
// those names). The size is the number of values (a loop over them, or a list of them).
import "harness"
import math
import cmath
import statistics
import random

for n in [1000, 100000] {
  random.seed(7)
  let xs = map(list(0..n), fn(i) => random.uniform(0.1, 10))
  let ys = map(list(0..n), fn(i) => random.uniform(0.1, 10))
  let near1 = map(xs, fn(x) => 1 + (x - 5) / 1e5)
  let ints = map(list(0..n), fn(i) => random.randint(1, 1000000))

  // ---------- math: a loop calling one function, summing its results ----------
  let unary = [["sqrt", math.sqrt], ["exp", math.exp], ["log", math.log], ["log10", math.log10], ["sin", math.sin],
               ["tanh", math.tanh], ["cbrt", math.cbrt], ["lgamma", math.lgamma], ["gamma", math.gamma],
               ["erf", math.erf], ["floor", math.floor], ["degrees", math.degrees]]
  for u in unary {
    let f = u[1]
    bench("math." + u[0], n, fn() {
      var s = 0
      for x in xs { s += f(x) }
      return s
    })
  }
  bench("math.atan2", n, fn() {
    var s = 0
    for i in 0..n { s += math.atan2(xs[i], ys[i]) }
    return s
  })
  bench("math.hypot", n, fn() {
    var s = 0
    for i in 0..n { s += math.hypot(xs[i], ys[i]) }
    return s
  })
  bench("math.pow", n, fn() {
    var s = 0
    for x in xs { s += math.pow(x, 1.5) }
    return s
  })
  bench("math.fmod", n, fn() {
    var s = 0
    for x in xs { s += math.fmod(x, 3) }
    return s
  })
  bench("math.isclose", n, fn() {
    var c = 0
    for i in 0..n {
      if math.isclose(xs[i], ys[i], {rel_tol: 0.1}) { c += 1 }
    }
    return c
  })
  bench("math.gcd", n, fn() {
    var s = 0
    for i in 0..n - 1 { s += math.gcd(ints[i], ints[i + 1]) }
    return s
  })
  bench("math.isqrt", n, fn() {
    var s = 0
    for k in ints { s += math.isqrt(k) }
    return s
  })
  bench("math.fsum", n, fn() => math.fsum(xs))
  bench("math.prod", n, fn() => math.prod(near1))
  bench("math.sumprod", n, fn() => math.sumprod(xs, ys))
  bench("math.dist", n, fn() => math.dist(xs, ys))
  bench("builtin_sum", n, fn() => sum(xs))

  // ---------- cmath ----------
  let zs = map(list(0..n), fn(i) => cmath.Complex(xs[i] - 5, ys[i] - 5))
  let cunary = [["exp", fn(z) => cmath.exp(z / 5)], ["log", cmath.log], ["sqrt", cmath.sqrt], ["sin", cmath.sin],
                ["atanh", fn(z) => cmath.atanh(z / 10)]]
  for u in cunary {
    let f = u[1]
    bench("cmath." + u[0], n, fn() {
      var s = cmath.Complex(0, 0)
      for z in zs { s = s + f(z) }
      return s
    })
  }
  bench("cmath.phase", n, fn() {
    var s = 0
    for z in zs { s += cmath.phase(z) }
    return s
  })
  bench("cmath.abs", n, fn() {
    var s = 0
    for z in zs { s += cmath.abs(z) }
    return s
  })
  bench("cmath.polar", n, fn() {
    var s = 0
    for z in zs { s += cmath.polar(z)[1] }
    return s
  })
  bench("complex_arithmetic", n, fn() {
    var s = cmath.Complex(0, 0)
    for i in 0..n - 1 { s = s + zs[i] * zs[i + 1] - zs[i] / (zs[i + 1] + 20) }
    return s
  })
  bench("complex_make", n, fn() {
    var s = 0
    for i in 0..n { s += cmath.Complex(xs[i], ys[i]).imag }
    return s
  })

  // ---------- statistics ----------
  random.seed(8)
  let data = map(list(0..n), fn(i) => random.gauss(10, 3))
  let data2 = map(data, fn(x) => x * 2 + random.random())
  let small_ints = map(ints, fn(k) => k % 50)
  bench("statistics.mean", n, fn() => statistics.mean(data))
  bench("statistics.fmean", n, fn() => statistics.fmean(data))
  bench("statistics.geometric_mean", n, fn() => statistics.geometric_mean(xs))
  bench("statistics.harmonic_mean", n, fn() => statistics.harmonic_mean(xs))
  bench("statistics.median", n, fn() => statistics.median(data))
  bench("statistics.mode", n, fn() => statistics.mode(small_ints))
  bench("statistics.multimode", n, fn() => statistics.multimode(small_ints))
  bench("statistics.variance", n, fn() => statistics.variance(data))
  bench("statistics.stdev", n, fn() => statistics.stdev(data))
  bench("statistics.pstdev", n, fn() => statistics.pstdev(data))
  bench("statistics.quantiles", n, fn() => statistics.quantiles(data, {n: 10}))
  bench("statistics.covariance", n, fn() => statistics.covariance(data, data2))
  bench("statistics.correlation", n, fn() => statistics.correlation(data, data2))
  bench("statistics.correlation_ranked", n, fn() => statistics.correlation(data, data2, {method: "ranked"}))
  bench_chk("statistics.linear_regression", n, fn() => statistics.linear_regression(data, data2), fn(r) => [r.slope, r.intercept])
  bench_chk("NormalDist.from_samples", n, fn() => statistics.from_samples(data), fn(d) => [d.mean, d.stdev])
  let nd = statistics.NormalDist(10, 3)
  bench("NormalDist.cdf", n, fn() {
    var s = 0
    for x in xs { s += nd.cdf(x) }
    return s
  })
  bench("NormalDist.inv_cdf", n, fn() {
    var s = 0
    for x in xs { s += nd.inv_cdf(x / 10.5) }
    return s
  })
  let k = statistics.kde(data, 0.5)
  bench("kde.pdf_10_points", n, fn() {
    var s = 0
    for i in 0..10 { s += k.pdf(i * 2) }
    return s
  })

  // ---------- random: each case seeded first, so its draws are Python's ----------
  random.seed(9)
  bench("random.random", n, fn() {
    var s = 0
    for i in 0..n { s += random.random() }
    return s
  })
  random.seed(9)
  bench("random.uniform", n, fn() {
    var s = 0
    for i in 0..n { s += random.uniform(1, 2) }
    return s
  })
  random.seed(9)
  bench("random.randint", n, fn() {
    var s = 0
    for i in 0..n { s += random.randint(1, 100) }
    return s
  })
  random.seed(9)
  bench("random.randrange", n, fn() {
    var s = 0
    for i in 0..n { s += random.randrange(0, 1000, 7) }
    return s
  })
  random.seed(9)
  bench("random.gauss", n, fn() {
    var s = 0
    for i in 0..n { s += random.gauss(0, 1) }
    return s
  })
  random.seed(9)
  bench("random.expovariate", n, fn() {
    var s = 0
    for i in 0..n { s += random.expovariate(2) }
    return s
  })
  random.seed(9)
  bench("random.choice", n, fn() {
    var s = 0
    for i in 0..n { s += random.choice(ints) }
    return s
  })
  random.seed(9)
  bench("random.getrandbits", n, fn() {
    var s = 0
    for i in 0..n { s += random.getrandbits(32) }
    return s
  })
  random.seed(9)
  bench_chk("random.shuffle", n, fn() => random.shuffle(ints), fn(r) => r[0] + r[n - 1] * 2 + r[floor(n / 2)] * 3)
  random.seed(9)
  bench("random.sample", n, fn() => random.sample(ints, floor(n / 10)))
  random.seed(9)
  bench("random.choices", n, fn() => random.choices(ints, {k: n}))
  random.seed(9)
  bench("random.choices_weighted", n, fn() => random.choices(small_ints, {weights: xs, k: n}))
}

for k in [10, 1000] {
  bench("random.seed", k, fn() {
    for i in 0..k { random.seed(i) }
    return random.random()
  })
}

// exact integers, and the Numbers nearest them
for k in [20, 100, 170] { bench("math.factorial", k, fn() => math.factorial(k)) }
for k in [100, 1000] {
  bench("math.comb", k, fn() => math.comb(k, k / 2))
  bench("math.perm", k, fn() => math.perm(k, 20))
}
