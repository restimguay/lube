# FizzBuzz, two ways.

for n in 1..=15 {
  if n % 15 == 0 { print("FizzBuzz") }
  else if n % 3 == 0 { print("Fizz") }
  else if n % 5 == 0 { print("Buzz") }
  else { print(n) }
}

# ...and as a pipeline
fn fizz(n) {
  let word = (n % 3 == 0 and "Fizz" or "") + (n % 5 == 0 and "Buzz" or "")
  return word == "" and str(n) or word
}
print((1..=15).map(fizz).join(" "))
