# Sieve of Eratosthenes.

fn primes_up_to(limit) {
  var is_prime = [true] * (limit + 1)
  is_prime[0] = false
  is_prime[1] = false
  var p = 2
  while p * p <= limit {
    if is_prime[p] {
      for multiple in range(p * p, limit + 1, p) { is_prime[multiple] = false }
    }
    p += 1
  }
  return (0..=limit).filter(fn(n) => is_prime[n])
}

let primes = primes_up_to(100)
print("primes below 100:", primes)
print("there are", len(primes_up_to(100_000)), "primes below 100,000")

let twins = range(len(primes) - 1)
  .filter(fn(i) => primes[i + 1] - primes[i] == 2)
  .map(fn(i) => "({primes[i]}, {primes[i + 1]})")
print("twin primes:", twins.join(" "))
